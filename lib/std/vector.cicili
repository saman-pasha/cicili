
;;;; Cicili std vector
;;; contigous memory reallocation 
;;; most minimal performant indexable vector
(generic decl-vector
  (a)

  (decl-array a)
  (decl-rc (<> array a))
  
  ;; the shared buffer is an rc, and an rc IS a cell over the rc context --
  ;; (<> cell rc (<> array a) context), the very type (<> new rc) hands back
  (struct (<> vector a)
          (member (<> cell rc (<> array a) context) vec)
          (member size_t low)
          (member size_t high))

  (typedef a (<> vector a item_t))

  ;; super type declaration to use in 'type-check
  (guard __VECTOR_TYPE_H_
    (decl) (struct (<> std vector)))
  (typedef (<> std vector) (<> vector a type_t))

  (decl) (func (<> free (<> vector a)) (((<> vector a) * vector)))
  ;; rounds a length up to the next power of two, never below 16. Named per
  ;; instantiation: an ungeneric `arraySize' would be defined twice the moment
  ;; a second element type is instantiated.
  (decl) (func (<> arraySize vector a) ((size_t size)) (out size_t))
  ;; the shared buffer, or nil when the vector is empty or its rc is dead
  (decl) (func (<> buffer vector a) (((<> vector a) ref vector)) (out (<> array a) *))
  (decl) (func (<> len vector a) (((<> vector a) ref vector)) (out size_t))
  ;; bounds-checked like the array's, so it answers with a maybe -- open it
  ;; with 'match / 'matchn
  (decl) (func (<> nth vector a) ((size_t index) ((<> vector a) ref vector)) (out (<> maybe a)))
  ;; both GROW THE VECTOR IN PLACE and hand back the new length. The vector owns
  ;; exactly one rc cell before and after, so `(push^vector v 6)' is a statement
  ;; and there is nothing for the caller to re-bind or free.
  (decl) (func (<> push vector a) (((<> vector a) ref vector) (a item)) (out size_t))
  (decl) (func (<> append vector a) (((<> vector a) ref vector) (const a * items) (size_t count))
               (out size_t))

  ) ; decl-vector


(generic impl-vector
  (a)

  (impl-array a)
  (impl-rc (<> array a))

  (inline)
  (func (<> free (<> vector a)) (((<> vector a) * vector))
        (syslog! (printf "FREE VECTOR: %p\n" vector))
        ((<> free cell rc (<> array a) context) (aof (-> vector vec))))

  (func (<> arraySize vector a) ((size_t size))
        (out size_t)
        (let ((size_t two_pow . 0x10))
          (while (< two_pow size)
            (set two_pow (<< two_pow 1)))
          (return two_pow)))

  (func (<> buffer vector a) (((<> vector a) ref vector))
        (out (<> array a) *)
        (when ($ (-> vector vec) ptr)
          (return (-> ($ (-> vector vec) ptr) ptr)))
        (return nil))

  (func (<> len vector a) (((<> vector a) ref vector))
        (out size_t)
        (return (- (-> vector high) (-> vector low))))

  (func (<> nth vector a) ((size_t index) ((<> vector a) ref vector))
        (out (<> maybe a))
        (let (((<> array a) * arr . #'((<> buffer vector a) vector))
              (size_t at . #'(+ (-> vector low) index)))
          ;; the front ends read (<> maybe a) off the out type and expand to the
          ;; struct literal -- no call, the way (<> nth array a) builds its own
          (if (and arr (< at (-> vector high)) (< at (-> arr len)))
              (return (just (nth at (-> arr arr))))
            (return (nothing)))))

  (func (<> push vector a) (((<> vector a) ref vector) (a item))
        (out size_t)
        (return ((<> append vector a) vector (aof item) 1)))

  ;; The buffer is written in place only while this vector is its sole owner and
  ;; it still has room -- a shared buffer belongs to a clone or a slice as well,
  ;; and a write would be visible there. Otherwise a new buffer of
  ;; (<> arraySize vector a) cells takes over: window and new items copied in,
  ;; old rc dropped. Either way the vector owns exactly one cell on return.
  (func (<> append vector a) (((<> vector a) ref vector) (const a * items) (size_t count))
        (out size_t)
        (let ((const size_t low  . #'(-> vector low))
              (const size_t high . #'(-> vector high))
              (const size_t total . #'(+ (- (-> vector high) (-> vector low)) count))
              ((<> array a) * arr . #'((<> buffer vector a) vector)))

          (when (and arr
                     (-> ($ (-> vector vec) ptr) count)
                     (== (cof (-> ($ (-> vector vec) ptr) count)) 1)
                     (<= (+ high count) (-> arr len)))
            (syslog! (printf "APPEND VECTOR: %s %zu in place, %zu of %zu cells used\n"
                             (symbol-name (<> vector a)) count (+ high count) (-> arr len)))
            (memcpy (+ (-> arr arr) high) items (* count (sizeof a)))
            (set (-> vector high) (+ high count))
            (return total))

          (let ((const size_t cap . #'((<> arraySize vector a) total)))
            (syslog! (printf "GROW VECTOR: %s %zu to %zu cells\n"
                             (symbol-name (<> vector a)) (? arr (-> arr len) 0) cap))
            ;; `move' so the fresh cell is not destructed here: the vector takes
            ;; it over. Its buffer holds the window, the new items go after it.
            (let (((<> cell rc (<> array a) context) move fresh .
                   #'((<> new rc) array (? arr (+ (-> arr arr) low) nil)
                                        (? arr (- high low) 0) cap)))
              (memcpy (+ (-> (-> ($ fresh ptr) ptr) arr) (- high low))
                      items (* count (sizeof a)))
              ((<> free cell rc (<> array a) context) (aof (-> vector vec)))
              (set ($ (-> vector vec) ptr) ($ fresh ptr)
                   (-> vector low)  0
                   (-> vector high) total)
              (return total)))))

  ) ; impl-vector


(DEFMACRO new^vector (arr &OPTIONAL len)
  (LET* ((arr arr)
         (len (IF len len
                (LET ((value (IF (EQL (CAR arr) 'cast) (CADDR arr) NIL)))
                  (IF (AND value (LISTP value) (EQUAL (CAR value) 'QUOTE))
                      (LENGTH (CADR value))
                    (IF (STRINGP value)
                        (LENGTH value)
                      (ERROR (FORMAT NIL "new vector can't infer length ~A" arr)))))))
         (vec-len (GENSYM "tmp_len"))
         (arr-len (GENSYM "arr_len")))
    (MULTIPLE-VALUE-BIND (type full-type) (CICILI:TYPE-CHECK arr :MODIFIER '(* ** ***))
      (LET ((a (NTH 1 full-type)))
        (IF len
            `(letn ((const size_t ,vec-len . (FUNCTION ,len))
                    (const size_t ,arr-len . (FUNCTION ((<> arraySize vector ,a) ,len))))
               (syslog! (printf "NEW VECTOR: %s %zu %zu\n" (symbol-name (<> vector ,a)) ,vec-len ,arr-len))
               ;; (<> new rc) is the new^rc macro: the type being wrapped first,
               ;; then that type's constructor arguments -- the items, how many
               ;; there are, and the capacity to allocate
               (cast (<> vector ,a) '{ ((<> new rc) array ,arr ,vec-len ,arr-len) 0 ,vec-len }))
            (ERROR (FORMAT NIL "new^~A len required for dynamic vector input: ~A" `(<> vector ,a) arr)))))))


;;;; ------------------------------------------------------------------
;;;; front ends: infer which instantiation the vector belongs to and dispatch.
;;;; An owned vector is passed by address, one already held by reference as is.
;;;; ------------------------------------------------------------------

;;; the vector's type name and the form to pass for it, as one step.
;;; A vector is a plain struct, not `non-copy', so an owned one carries no
;;; modifier at all -- nil belongs in the accepted list next to move. Only a
;;; `ref' is already an address; everything else is passed by one.
(DEFUN vector-call< (vector)
  (LET ((full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK vector :TYPEOF :std^vector
                                                          :MODIFIER '(move ref nil)))))
    (VALUES (NTH 1 full-type)
            (IF (CICILI:KEY-EQ (NTH 2 full-type) 'ref) vector `(aof ,vector)))))

(DEFMACRO free^vector (vector)
  (LET ((vector vector))
    (MULTIPLE-VALUE-BIND (type-name self) (vector-call< vector)
      `((<> free ,type-name) ,self))))

(DEFMACRO len^vector (vector)
  (LET ((vector vector))
    (MULTIPLE-VALUE-BIND (type-name self) (vector-call< vector)
      `((<> len ,type-name) ,self))))

(DEFMACRO nth^vector (index vector)
  (LET ((index index) (vector vector))
    (MULTIPLE-VALUE-BIND (type-name self) (vector-call< vector)
      `((<> nth ,type-name) ,index ,self))))

(DEFMACRO push^vector (vector item)
  (LET ((vector vector) (item item))
    (MULTIPLE-VALUE-BIND (type-name self) (vector-call< vector)
      `((<> push ,type-name) ,self ,item))))

;;; (append^vector v '{ 6 7 8 })       -- a brace list, counted here
;;; (append^vector v "abc")            -- a string, counted here
;;; (append^vector v items count)      -- anything else needs its count
(DEFMACRO append^vector (vector items &OPTIONAL count)
  (LET* ((vector vector)
         (items items)
         (literal (OR (AND (LISTP items) (CICILI:KEY-EQ (CAR items) 'QUOTE)) (STRINGP items)))
         (count (IF count count
                  (IF (AND (LISTP items) (CICILI:KEY-EQ (CAR items) 'QUOTE))
                      (LENGTH (CADR items))
                    (IF (STRINGP items)
                        (LENGTH items)
                      (ERROR (FORMAT NIL "append vector can't infer how many items: ~A" items)))))))
    (MULTIPLE-VALUE-BIND (type-name self) (vector-call< vector)
      `((<> append ,type-name) ,self
        ,(IF literal `(cast (const (<> ,type-name item_t) []) ,items) items)
        ,count))))
