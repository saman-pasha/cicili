;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


;;;; Cicili std cell
(generic decl-cell
  (a)

  ;; `get' hands back a borrow of the interior, so the maybe it answers with
  ;; carries a POINTER INTO the cell rather than a copy -- see the note on the
  ;; implementation below.
  (decl-maybe ref a)

  (non-copy)
  (struct (<> cell a)
          (member a ref ptr))

  (typedef a (<> cell a interior_t))

  ;; super type declaration to use in 'type-check
  (guard __CELL_TYPE_H_
    (decl) (struct (<> std cell)))
  (typedef (<> std cell) (<> cell a type_t))

  (decl) (func (<> free cell a) (((<> cell a) * cell)))          ; needed for letin
  (decl) (func (<> free cell a pointer) (((<> cell a) ** cell))) ; needed for pass move to function

  ;; Is there anything in the cell, and if so what.
  ;;
  ;; A cell is empty or it is not, and that is a case rather than a null check --
  ;; which is the whole argument lib/std/maybe.cicili makes. The `let_cell' and
  ;; `take_cell' macros below open a cell for a BLOCK; this answers for one
  ;; expression, so a cell can be matched, bound or returned like any other
  ;; value:
  ;;
  ;;   (match ((<> get cell String) name)
  ;;     (just s  (show_string stdout (cof s)))
  ;;     (nothing (fputs "<gone>" stdout)))
  (decl) (func (<> get cell a) (((<> cell a) ref cell)) (out (<> Maybe ref a)))

  ) ; decl-cell


;;; Reach a cell's interior through let_cell / take_cell, never free it
;;; yourself. This cannot be guarded by a (DEFMACRO (<> free a)): that name IS
;;; the back-end free of the celled type, so the guard shadows the function
;;; free_cell itself has to call.

(generic impl-cell
  (a)

  (impl-maybe ref a)

  ;; The maybe is (decl-maybe ref a), so the payload is the cell's own pointer
  ;; rather than a copy of what it holds -- `match' hands out an `a ref' to
  ;; deref, and writing through it writes the cell. Exactly vector's `nth'
  ;; (lib/std/vector.cicili:152), for exactly that reason.
  ;;
  ;; `just' and `nothing' are the front ends, so this is a struct literal and no
  ;; call. The back-end constructors carry (inline), which emits
  ;; __attribute__((weak)), and a weak symbol is one the compiler may not inline.
  (func (<> get cell a) (((<> cell a) ref cell))
        (out (<> Maybe ref a))
        (if (-> cell ptr)
            (return (just (-> cell ptr)))
          (return (nothing))))

  (inline)
  (func (<> free cell a) (((<> cell a) * cell))
        (syslog! (printf "FREE CELL: %p\n" (-> cell ptr)))
        (when (-> cell ptr)
          ((<> free a) (-> cell ptr))
          (free (-> cell ptr))))

  (inline)
  (func (<> free cell a pointer) (((<> cell a) ** cell))
        ((<> free cell a) (cof cell)))

  ) ; impl-cell

(DEFMACRO free_cell (cell)
  (LET ((cell cell)
        (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK cell :TYPEOF :std_cell :MODIFIER '(move ref)))))
    (IF (CICILI:KEY-EQ (NTH 2 full-type) 'move)
        `((<> free ,(NTH 1 full-type)) (aof ,cell))
      `((<> free ,(NTH 1 full-type)) ,cell))))


(DEFMACRO new_cell (type &REST args)
  (LET* ((ctor `(<> new ,type))
         (args args)
         (a (CICILI:INFER-TYPE `(,ctor ,@args)))
         (ptr-name (GENSYM (FORMAT NIL "~A_ptr" (SYMBOL-NAME (CAR a)))))
         (obj-name (GENSYM (FORMAT NIL "~A_obj" (SYMBOL-NAME (CAR a))))))
    (WHEN (> (LENGTH a) 1) (ERROR (FORMAT NIL "new cell got invalid type ~A for ~A" a ctor)))
    `(letn ((,@a * ,ptr-name . (FUNCTION (malloc (sizeof ,@a))))
            (,@a move ,obj-name . (FUNCTION (,ctor ,@args))))
       (syslog! (printf "NEW CELL: %p\n" ,ptr-name))
       (memcpy ,ptr-name (aof ,obj-name) (sizeof ,obj-name))
       (cast (<> cell ,@a) '{ ,ptr-name }))))


(DEFMACRO let_cell ((obj cell &REST captures) &REST body)
  (LET ((obj obj)
        (cell cell))
    ;; full-type is list of inferred type details
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK cell :TYPEOF :std_cell :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> let ,type-name ,(GENSYM)) :cell (aof ,cell) ,@captures)
           (when (-> cell ptr)
             (let (((<> ,type-name interior_t) ref ,obj . (FUNCTION (-> cell ptr))))
               ,@body)))))))


(DEFMACRO letn_cell ((obj cell default &REST captures) &REST body)
  (LET ((obj obj)
        (cell cell)
        (default default))
    ;; full-type is list of inferred type details
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK cell :TYPEOF :std_cell :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> letn ,type-name ,(GENSYM)) :cell (aof ,cell) :default_value ,default ,@captures)
           (out auto)
           (return (? (-> cell ptr)
                      (letn (((<> ,type-name interior_t) ref ,obj . (FUNCTION (-> cell ptr))))
                        ,@body)
                      default_value)))))))


(DEFMACRO take_cell ((obj cell &REST captures) &REST body)
  (LET ((obj obj)
        (cell cell))
    ;; full-type is list of inferred type details
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK cell :TYPEOF :std_cell :MODIFIER :move)
      (LET* ((type-name (NTH 1 full-type)))
        `(closure ((<> take ,type-name ,(GENSYM)) :cell ,cell ,@captures)
           (when ($ cell ptr)
             (letin ((,obj (cof ($ cell ptr))))
               ,@body)))))))


(DEFMACRO taken_cell ((obj cell default &REST captures) &REST body)
  (LET ((obj obj)
        (cell cell)
        (default default))
    ;; full-type is list of inferred type details
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK cell :TYPEOF :std_cell :MODIFIER :move)
      (LET* ((type-name (NTH 1 full-type)))
        `(closure ((<> taken ,type-name ,(GENSYM)) :cell ,cell :default_value ,default ,@captures)
           (out auto)
           (return (? ($ cell ptr)
                      (letin ((,obj (cof ($ cell ptr)))) ; should zeroed ($ cell ptr)
                        ,@body)
                      default_value)))))))
