;;;; Cicili std maybe
;;; presence of a value at the return of a function
;;;
;;; The lower case `maybe' / `just' / `nothing' are the std, struct-based
;;; version. They coexist with the Haskell layer's ADT `Maybe' / `Just' /
;;; `Nothing' -- case is what tells them apart, so both can be in scope and
;;; `match' can dispatch on either.
;;;
;;; A function that may or may not have an answer returns (<> maybe a) instead
;;; of a bare `a' plus a sentinel, so "is there a value" cannot be forgotten:
;;;
;;;   (func (<> find array a) ((a needle) ((<> array a) ref array))
;;;         (out (<> maybe size_t))
;;;         (for ((size_t i . 0)) (< i (-> array len)) ((1+ i))
;;;           (when (== (nth i (-> array arr)) needle)
;;;             (return (just i))))
;;;         (return (nothing)))
;;;
;;; `just' and `nothing' are the front ends: they name no instantiation, they
;;; read it off the out type of the function they stand in. The back-end
;;; constructors are still there for the rare form that is not in a return --
;;; ((<> just maybe size_t) i) / ((<> nothing maybe size_t)).
;;;
;;; Unlike a sentinel return, `present' is independent of the payload, so zero
;;; and NULL are perfectly good values.
;;;
;;; maybe is a plain value carrier: it owns nothing and has no destructor. Keep
;;; the payload copyable -- for an owned resource carry a (<> cell T) or a
;;; pointer, not the resource itself, or the copy in `value' and the original
;;; will both be freed.
;;;
;;; The back-end constructors carry (inline), which emits __attribute__((weak))
;;; so one definition serves every translation unit -- but a weak symbol is
;;; replaceable at link time, so gcc will not inline it. That is why the front
;;; ends do not call them: they expand to the struct literal itself,
;;; (cast (<> maybe a) '{ #t v }) / '{ #f (cast a '{ 0 }) }, the way
;;; (<> nth array a) does; the member order is present then value.
;;;
;;; `present' and `value' are the representation, not the interface. Open a
;;; maybe with `match', which infers the type and expands to a bare `if':
;;;
;;;   (match ((<> find array int) 7 (aof arr))
;;;     (just    at (printf "7 is at %zu\n" at))
;;;     (nothing    (printf "not there\n")))
;;;
;;;   (printf "index: %zu\n"
;;;     (matchn ((<> find array int) 7 (aof arr))
;;;       (just    at at)
;;;       (nothing    0)))

(generic decl-maybe
  (a)

  (struct (<> maybe a)
          (member bool present)
          (member a value))

  (typedef a (<> maybe a interior_t))

  ;; super type declaration to use in 'type-check and 'match dispatch
  (guard __MAYBE_TYPE_H_
    (decl) (struct (<> std maybe)))
  (typedef (<> std maybe) (<> maybe a type_t))

  ;; teaches 'match how to take a maybe apart; keyed on the opaque super type,
  ;; so it is the same registration whatever `a' is. emits nothing.
  (def-matchable std^maybe
    (just    ($ % present)       ($ % value))
    (nothing (not ($ % present)) NIL))

  (decl) (func (<> just    maybe a) ((a value)) (out (<> maybe a)))
  (decl) (func (<> nothing maybe a) ()          (out (<> maybe a)))

  ) ; decl-maybe


(generic impl-maybe
  (a)

  ;; positional init: present first, then the payload, in struct order
  (inline)
  (func (<> just maybe a) ((a value))
        (out (<> maybe a))
        (return (cast (<> maybe a) '{ #t value })))

  ;; nothing still carries a well defined payload -- the zero of its type -- so
  ;; reading `value' without checking is wrong but never undefined
  (inline)
  (func (<> nothing maybe a) ()
        (out (<> maybe a))
        (return (cast (<> maybe a) '{ #f (cast a '{ 0 }) })))

  ) ; impl-maybe


;;;; ------------------------------------------------------------------
;;;; front ends: build a maybe without naming its instantiation.
;;;;
;;;; Both answer the same question -- which (<> maybe a) is this? -- by looking
;;;; at the out type of the function the form stands in. `nothing' has nothing
;;;; else to go on; `just' falls back to the type of its own value when the
;;;; enclosing function does not return a maybe, so it still works in a `let'.
;;;;
;;;; Neither calls the back-end constructor. Those are (inline), which is
;;;; __attribute__((weak)) and therefore never inlined -- a real call for what
;;;; is two stores. The expansion is the struct literal, so a maybe built in a
;;;; loop costs what writing the braces by hand would.
;;;; ------------------------------------------------------------------

;;; the maybe this form belongs to, as its type name, or NIL when the enclosing
;;; function does not return one
(DEFUN maybe-out< ()
  (out-typeof< 'std^maybe))

;;; (just v) -- the instantiation comes from the out type, so `(return (just i))'
;;; inside (out (<> maybe size_t)) builds a maybe_size_t whatever `i' is
;;; declared as; a literal 0 needs no cast. Outside a maybe-returning function
;;; the value decides, which is what makes
;;; (let (((<> maybe int) m . #'(just 3)))) work. Where neither is the
;;; instantiation you want, name it: ((<> just maybe long) 3).
(DEFMACRO just (value)
  (LET* ((value value)
         (type-name
             (OR (maybe-out<)
                 (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:INFER-TYPE value)
                   (DECLARE (IGNORE _))
                   (LET ((item (NTH 1 full-type)))
                     (UNLESS (SYMBOLP item)
                       (SETQ item (NTH 1 (NTH-VALUE 1 (CICILI:INFER-TYPE-SPEC "" item)))))
                     (UNLESS (SYMBOLP item)
                       (ERROR (FORMAT NIL "just: can't infer which maybe ~A belongs to~%  name it: ((<> just maybe T) ~A)"
                                      value value)))
                     `(<> maybe ,item))))))
    `(cast ,type-name '{ #t ,value })))

;;; (nothing) -- carries no value, so only the out type can say which maybe it
;;; is. In any other position name the instantiation: ((<> nothing maybe int)).
;;; The payload is the zero of the interior type, never uninitialised.
(DEFMACRO nothing ()
  (LET ((type-name (maybe-out<)))
    (UNLESS type-name
      (ERROR (FORMAT NIL "nothing: the enclosing function does not return a maybe~%  name the instantiation instead: ((<> nothing maybe T))")))
    `(cast ,type-name '{ #f (cast (<> ,type-name interior_t) '{ 0 }) })))
