;;;; Cicili declarations for <errno.h>
;;;; Import from lib/std/prelude.cicili:  (import "./c/errno.cicili")
;;;; Requires in target: (include <errno.h>)  or  (:std #t)
;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


(DEFMACRO init-macro ()
  `($$$
     ;;; ---- types ----
     (typedef int errno)

     ;;; ---- constants: C-standard ----
     (typedef int EDOM)
     (typedef int EILSEQ)
     (typedef int ERANGE)

     ;;; ---- constants: POSIX ----
     (typedef int EPERM)
     (typedef int ENOENT)
     (typedef int ESRCH)
     (typedef int EINTR)
     (typedef int EIO)
     (typedef int ENXIO)
     (typedef int E2BIG)
     (typedef int ENOEXEC)
     (typedef int EBADF)
     (typedef int ECHILD)
     (typedef int EAGAIN)
     (typedef int ENOMEM)
     (typedef int EACCES)
     (typedef int EFAULT)
     (typedef int ENOTBLK)
     (typedef int EBUSY)
     (typedef int EEXIST)
     (typedef int EXDEV)
     (typedef int ENODEV)
     (typedef int ENOTDIR)
     (typedef int EISDIR)
     (typedef int EINVAL)
     (typedef int ENFILE)
     (typedef int EMFILE)
     (typedef int ENOTTY)
     (typedef int ETXTBSY)
     (typedef int EFBIG)
     (typedef int ENOSPC)
     (typedef int ESPIPE)
     (typedef int EROFS)
     (typedef int EMLINK)
     (typedef int EPIPE)
     (typedef int EDEADLK)
     (typedef int ENAMETOOLONG)
     (typedef int ENOLCK)
     (typedef int ENOSYS)
     (typedef int ENOTEMPTY)
     (typedef int ELOOP)
     (typedef int ENOMSG)
     (typedef int EIDRM)
     (typedef int ENOSTR)
     (typedef int ENODATA)
     (typedef int ETIME)
     (typedef int ENOSR)
     (typedef int EPROTO)
     (typedef int EBADMSG)
     (typedef int EOVERFLOW)
     (typedef int ENOTSOCK)
     (typedef int EDESTADDRREQ)
     (typedef int EMSGSIZE)
     (typedef int EPROTOTYPE)
     (typedef int ENOPROTOOPT)
     (typedef int EPROTONOSUPPORT)
     (typedef int EOPNOTSUPP)
     (typedef int EAFNOSUPPORT)
     (typedef int EADDRINUSE)
     (typedef int EADDRNOTAVAIL)
     (typedef int ENETDOWN)
     (typedef int ENETUNREACH)
     (typedef int ENETRESET)
     (typedef int ECONNABORTED)
     (typedef int ECONNRESET)
     (typedef int ENOBUFS)
     (typedef int EISCONN)
     (typedef int ENOTCONN)
     (typedef int ETIMEDOUT)
     (typedef int ECONNREFUSED)
     (typedef int EHOSTUNREACH)
     (typedef int EALREADY)
     (typedef int EINPROGRESS)
     (typedef int ECANCELED)
     (typedef int EOWNERDEAD)
     (typedef int ENOTRECOVERABLE)
     ))
