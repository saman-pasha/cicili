;;;; Cicili declarations for <string.h>
;;;; Import from lib/std/prelude.cicili:  (import "./c/string.cicili")
;;;; Requires in target: (include <string.h>)  or  (:std #t)
;;;;
;;;; size_t is declared by stddef.cicili and is not repeated here.
;;;; memcpy and memset used to live in lib/std/prelude.cicili; they are
;;;; declared here now.

(DEFMACRO init-macro ()
  `($$$
     ;;; ---- copying functions ----
     (decl) (func memcpy  ((void * restrict dst) (const void * restrict src) (size_t n)) (out void *))
     (decl) (func memset  ((void * b) (int c) (size_t len)) (out void *))
     (decl) (func memmove ((void * dst) (const void * src) (size_t n)) (out void *))
     (decl) (func strcpy  ((char * restrict s1) (const char * restrict s2)) (out char *))
     (decl) (func strncpy ((char * restrict s1) (const char * restrict s2) (size_t n)) (out char *))

     ;;; ---- concatenation functions ----
     (decl) (func strcat  ((char * restrict s1) (const char * restrict s2)) (out char *))
     (decl) (func strncat ((char * restrict s1) (const char * restrict s2) (size_t n)) (out char *))

     ;;; ---- comparison functions ----
     (decl) (func memcmp  ((const void * s1) (const void * s2) (size_t n)) (out int))
     (decl) (func strcmp  ((const char * s1) (const char * s2)) (out int))
     (decl) (func strcoll ((const char * s1) (const char * s2)) (out int))
     (decl) (func strncmp ((const char * s1) (const char * s2) (size_t n)) (out int))
     (decl) (func strxfrm ((char * restrict s1) (const char * restrict s2) (size_t n)) (out size_t))

     ;;; ---- search functions ----
     (decl) (func memchr  ((const void * s) (int c) (size_t n)) (out void *))
     (decl) (func strchr  ((const char * s) (int c)) (out char *))
     (decl) (func strcspn ((const char * s1) (const char * s2)) (out size_t))
     (decl) (func strpbrk ((const char * s1) (const char * s2)) (out char *))
     (decl) (func strrchr ((const char * s) (int c)) (out char *))
     (decl) (func strspn  ((const char * s1) (const char * s2)) (out size_t))
     (decl) (func strstr  ((const char * s1) (const char * s2)) (out char *))
     (decl) (func strtok  ((char * restrict s1) (const char * restrict s2)) (out char *))

     ;;; ---- miscellaneous functions ----
     (decl) (func strerror ((int errnum)) (out char *))
     (decl) (func strlen   ((const char * s)) (out size_t))

     ;;; ---- POSIX extensions ----
     (decl) (func strdup    ((const char * s)) (out char *))                                             ; POSIX
     (decl) (func strndup   ((const char * s) (size_t n)) (out char *))                                  ; POSIX
     (decl) (func strnlen   ((const char * s) (size_t maxlen)) (out size_t))                             ; POSIX
     (decl) (func strcasecmp  ((const char * s1) (const char * s2)) (out int))                           ; POSIX
     (decl) (func strncasecmp ((const char * s1) (const char * s2) (size_t n)) (out int))                ; POSIX
     (decl) (func strsep    ((char ** restrict stringp) (const char * restrict delim)) (out char *))     ; POSIX
     (decl) (func strtok_r  ((char * restrict s) (const char * restrict sep) (char ** restrict lasts)) (out char *)) ; POSIX
     (decl) (func strerror_r ((int errnum) (char * strerrbuf) (size_t buflen)) (out int))                ; POSIX
     ))
