;;;; Cicili declarations for <locale.h>
;;;; Import from lib/std/prelude.cicili:  (import "./c/locale.cicili")
;;;; Requires in target: (include <locale.h>)  or  (:std #t)
;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


(DEFMACRO init-macro ()
  `($$$
     ;;; ---- constants ----
     (typedef int LC_ALL)
     (typedef int LC_COLLATE)
     (typedef int LC_CTYPE)
     (typedef int LC_MONETARY)
     (typedef int LC_NUMERIC)
     (typedef int LC_TIME)
     (typedef int LC_MESSAGES)  ; POSIX

     ;;; ---- structs ----
     (decl) (struct lconv
              (member char * decimal_point)
              (member char * thousands_sep)
              (member char * grouping)
              (member char * mon_decimal_point)
              (member char * mon_thousands_sep)
              (member char * mon_grouping)
              (member char * positive_sign)
              (member char * negative_sign)
              (member char * currency_symbol)
              (member char   frac_digits)
              (member char   p_cs_precedes)
              (member char   p_sep_by_space)
              (member char   n_cs_precedes)
              (member char   n_sep_by_space)
              (member char   p_sign_posn)
              (member char   n_sign_posn)
              (member char * int_curr_symbol)
              (member char   int_frac_digits)
              (member char   int_p_cs_precedes)
              (member char   int_p_sep_by_space)
              (member char   int_n_cs_precedes)
              (member char   int_n_sep_by_space)
              (member char   int_p_sign_posn)
              (member char   int_n_sign_posn))

     ;;; ---- functions ----
     (decl) (func setlocale ((int category) (const char * locale)) (out char *))
     (decl) (func localeconv () (out lconv *))
     ))
