;;;; Cicili declarations for <stdbool.h>
;;;; Import from lib/std/prelude.cicili:  (import "./c/stdbool.cicili")
;;;; Requires in target: (include <stdbool.h>)  or  (:std #t)
;;;;
;;;; `bool` is already a Cicili primitive, so this file only needs to pin
;;;; the two boolean constants. Deliberately tiny: `_Bool`, `__bool_true_false_are_defined`
;;;; and the `bool`/`true`/`false` macro-ness itself have no useful Cicili spelling
;;;; and are skipped.
;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


(DEFMACRO init-macro ()
  `($$$
     ;;; ---- constants ----
     (typedef bool true)
     (typedef bool false)
     ))
