;;;; Cicili declarations for <stdio.h>
;;;; Import from lib/std/prelude.cicili:  (import "./c/stdio.cicili")
;;;; Requires in target: (include <stdio.h>)  or  (:std #t)
;;;;
;;;; FILE, stdin, stdout, stderr, printf and fprintf used to live in
;;;; lib/std/prelude.cicili; they are declared here now.

(DEFMACRO init-macro ()
  `($$$
     ;;; ---- types ----
     (decl) (struct FILE)
     (typedef llong fpos_t)

     ;;; ---- standard streams ----
     (typedef FILE * stdin)
     (typedef FILE * stdout)
     (typedef FILE * stderr)

     ;;; ---- constants ----
     (typedef int    EOF)
     (typedef size_t BUFSIZ)
     (typedef int    FOPEN_MAX)
     (typedef int    FILENAME_MAX)
     (typedef int    TMP_MAX)
     (typedef int    L_tmpnam)
     (typedef int    SEEK_SET)
     (typedef int    SEEK_CUR)
     (typedef int    SEEK_END)
     (typedef int    _IOFBF)
     (typedef int    _IOLBF)
     (typedef int    _IONBF)

     ;;; ---- file access ----
     (decl) (func fopen    ((const char * restrict filename) (const char * restrict mode)) (out FILE *))
     (decl) (func freopen  ((const char * restrict filename) (const char * restrict mode) (FILE * restrict stream)) (out FILE *))
     (decl) (func fdopen   ((int fd) (const char * mode)) (out FILE *))               ; POSIX
     (decl) (func fmemopen ((void * buf) (size_t size) (const char * mode)) (out FILE *)) ; POSIX
     (decl) (func fclose   ((FILE * stream)) (out int))
     (decl) (func fflush   ((FILE * stream)) (out int))
     (decl) (func setbuf   ((FILE * restrict stream) (char * restrict buf)))
     (decl) (func setvbuf  ((FILE * restrict stream) (char * restrict buf) (int mode) (size_t size)) (out int))
     (decl) (func fileno   ((FILE * stream)) (out int))                               ; POSIX

     ;;; ---- formatted output ----
     (decl) (func   printf ((const char * restrict format) ($$$)) (out size_t))
     (decl) (func  fprintf ((FILE * restrict stream) (const char * restrict format) ($$$)) (out size_t))
     (decl) (func  sprintf ((char * restrict s) (const char * restrict format) ($$$)) (out int))
     (decl) (func snprintf ((char * restrict s) (size_t n) (const char * restrict format) ($$$)) (out int))
     (decl) (func  dprintf ((int fd) (const char * restrict format) ($$$)) (out int))
     (decl) (func  vprintf ((const char * restrict format) (va_list arg)) (out int))
     (decl) (func vfprintf ((FILE * restrict stream) (const char * restrict format) (va_list arg)) (out int))
     (decl) (func vsprintf ((char * restrict s) (const char * restrict format) (va_list arg)) (out int))
     (decl) (func vsnprintf ((char * restrict s) (size_t n) (const char * restrict format) (va_list arg)) (out int))

     ;;; ---- formatted input ----
     (decl) (func  scanf ((const char * restrict format) ($$$)) (out int))
     (decl) (func fscanf ((FILE * restrict stream) (const char * restrict format) ($$$)) (out int))
     (decl) (func sscanf ((const char * restrict s) (const char * restrict format) ($$$)) (out int))
     (decl) (func  vscanf ((const char * restrict format) (va_list arg)) (out int))
     (decl) (func vfscanf ((FILE * restrict stream) (const char * restrict format) (va_list arg)) (out int))
     (decl) (func vsscanf ((const char * restrict s) (const char * restrict format) (va_list arg)) (out int))

     ;;; ---- character input/output ----
     (decl) (func fgetc   ((FILE * stream)) (out int))
     (decl) (func getc    ((FILE * stream)) (out int))
     (decl) (func getchar () (out int))
     (decl) (func fgets   ((char * restrict s) (int n) (FILE * restrict stream)) (out char *))
     (decl) (func fputc   ((int c) (FILE * stream)) (out int))
     (decl) (func putc    ((int c) (FILE * stream)) (out int))
     (decl) (func putchar ((int c)) (out int))
     (decl) (func fputs   ((const char * restrict s) (FILE * restrict stream)) (out int))
     (decl) (func puts    ((const char * s)) (out int))
     (decl) (func ungetc  ((int c) (FILE * stream)) (out int))
     (decl) (func getline ((char ** restrict lineptr) (size_t * restrict n) (FILE * restrict stream)) (out ssize_t)) ; POSIX

     ;;; ---- direct input/output ----
     (decl) (func fread  ((void * restrict ptr) (size_t size) (size_t nmemb) (FILE * restrict stream)) (out size_t))
     (decl) (func fwrite ((const void * restrict ptr) (size_t size) (size_t nmemb) (FILE * restrict stream)) (out size_t))

     ;;; ---- file positioning ----
     (decl) (func fgetpos ((FILE * restrict stream) (fpos_t * restrict pos)) (out int))
     (decl) (func fsetpos ((FILE * stream) (const fpos_t * pos)) (out int))
     (decl) (func fseek   ((FILE * stream) (long offset) (int whence)) (out int))
     (decl) (func ftell   ((FILE * stream)) (out long))
     (decl) (func rewind  ((FILE * stream)))

     ;;; ---- error handling ----
     (decl) (func clearerr ((FILE * stream)))
     (decl) (func feof     ((FILE * stream)) (out int))
     (decl) (func ferror   ((FILE * stream)) (out int))
     (decl) (func perror   ((const char * s)))

     ;;; ---- file operations ----
     (decl) (func remove  ((const char * filename)) (out int))
     (decl) (func rename  ((const char * oldname) (const char * newname)) (out int))
     (decl) (func tmpfile () (out FILE *))
     (decl) (func tmpnam  ((char * s)) (out char *))
     ))
