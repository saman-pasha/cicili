;;;; Cicili declarations for <math.h>
;;;; Import from lib/std/prelude.cicili:  (import "./c/math.cicili")
;;;; Requires in target: (include <math.h>)  or  (:std #t)
;;;;
;;;; The type-generic classification/comparison macros (fpclassify, isfinite,
;;;; isinf, isnan, isnormal, signbit, isgreater, isgreaterequal, isless,
;;;; islessequal, islessgreater, isunordered) are C macros with no fixed
;;;; parameter/return type, so they are deliberately NOT declared here; use
;;;; them verbatim in target code.

(DEFMACRO init-macro ()
  `($$$
     ;;; ---- types ----
     (typedef float  float_t)   ; assumes FLT_EVAL_METHOD 0/1, the common case
     (typedef double double_t)  ; assumes FLT_EVAL_METHOD 0/1, the common case

     ;;; ---- constants: error/domain handling ----
     (typedef double HUGE_VAL)
     (typedef float  HUGE_VALF)
     (typedef real   HUGE_VALL)
     (typedef float  INFINITY)
     (typedef float  NAN)
     (typedef int    MATH_ERRNO)
     (typedef int    MATH_ERREXCEPT)
     (typedef int    math_errhandling)

     ;;; ---- constants: classification ----
     (typedef int FP_INFINITE)
     (typedef int FP_NAN)
     (typedef int FP_NORMAL)
     (typedef int FP_SUBNORMAL)
     (typedef int FP_ZERO)
     (typedef int FP_ILOGB0)
     (typedef int FP_ILOGBNAN)

     ;;; ---- constants: common BSD constants ----
     (typedef double M_PI)       ; non-standard, widely available
     (typedef double M_PI_2)     ; non-standard, widely available
     (typedef double M_PI_4)     ; non-standard, widely available
     (typedef double M_E)        ; non-standard, widely available
     (typedef double M_LOG2E)    ; non-standard, widely available
     (typedef double M_LOG10E)   ; non-standard, widely available
     (typedef double M_LN2)      ; non-standard, widely available
     (typedef double M_LN10)     ; non-standard, widely available
     (typedef double M_1_PI)     ; non-standard, widely available
     (typedef double M_2_PI)     ; non-standard, widely available
     (typedef double M_2_SQRTPI) ; non-standard, widely available
     (typedef double M_SQRT2)    ; non-standard, widely available
     (typedef double M_SQRT1_2)  ; non-standard, widely available

     ;;; ---- trigonometric ----
     (decl) (func acos  ((double x)) (out double))
     (decl) (func acosf ((float x))  (out float))
     (decl) (func acosl ((real x))   (out real))

     (decl) (func asin  ((double x)) (out double))
     (decl) (func asinf ((float x))  (out float))
     (decl) (func asinl ((real x))   (out real))

     (decl) (func atan  ((double x)) (out double))
     (decl) (func atanf ((float x))  (out float))
     (decl) (func atanl ((real x))   (out real))

     (decl) (func atan2  ((double y) (double x)) (out double))
     (decl) (func atan2f ((float y)  (float x))  (out float))
     (decl) (func atan2l ((real y)   (real x))   (out real))

     (decl) (func cos  ((double x)) (out double))
     (decl) (func cosf ((float x))  (out float))
     (decl) (func cosl ((real x))   (out real))

     (decl) (func sin  ((double x)) (out double))
     (decl) (func sinf ((float x))  (out float))
     (decl) (func sinl ((real x))   (out real))

     (decl) (func tan  ((double x)) (out double))
     (decl) (func tanf ((float x))  (out float))
     (decl) (func tanl ((real x))   (out real))

     ;;; ---- hyperbolic ----
     (decl) (func acosh  ((double x)) (out double))
     (decl) (func acoshf ((float x))  (out float))
     (decl) (func acoshl ((real x))   (out real))

     (decl) (func asinh  ((double x)) (out double))
     (decl) (func asinhf ((float x))  (out float))
     (decl) (func asinhl ((real x))   (out real))

     (decl) (func atanh  ((double x)) (out double))
     (decl) (func atanhf ((float x))  (out float))
     (decl) (func atanhl ((real x))   (out real))

     (decl) (func cosh  ((double x)) (out double))
     (decl) (func coshf ((float x))  (out float))
     (decl) (func coshl ((real x))   (out real))

     (decl) (func sinh  ((double x)) (out double))
     (decl) (func sinhf ((float x))  (out float))
     (decl) (func sinhl ((real x))   (out real))

     (decl) (func tanh  ((double x)) (out double))
     (decl) (func tanhf ((float x))  (out float))
     (decl) (func tanhl ((real x))   (out real))

     ;;; ---- exponential/logarithmic ----
     (decl) (func exp  ((double x)) (out double))
     (decl) (func expf ((float x))  (out float))
     (decl) (func expl ((real x))   (out real))

     (decl) (func exp2  ((double x)) (out double))
     (decl) (func exp2f ((float x))  (out float))
     (decl) (func exp2l ((real x))   (out real))

     (decl) (func expm1  ((double x)) (out double))
     (decl) (func expm1f ((float x))  (out float))
     (decl) (func expm1l ((real x))   (out real))

     (decl) (func frexp  ((double value) (int * exp)) (out double))
     (decl) (func frexpf ((float value)  (int * exp)) (out float))
     (decl) (func frexpl ((real value)   (int * exp)) (out real))

     (decl) (func ilogb  ((double x)) (out int))
     (decl) (func ilogbf ((float x))  (out int))
     (decl) (func ilogbl ((real x))   (out int))

     (decl) (func ldexp  ((double x) (int exp)) (out double))
     (decl) (func ldexpf ((float x)  (int exp)) (out float))
     (decl) (func ldexpl ((real x)   (int exp)) (out real))

     (decl) (func log  ((double x)) (out double))
     (decl) (func logf ((float x))  (out float))
     (decl) (func logl ((real x))   (out real))

     (decl) (func log10  ((double x)) (out double))
     (decl) (func log10f ((float x))  (out float))
     (decl) (func log10l ((real x))   (out real))

     (decl) (func log1p  ((double x)) (out double))
     (decl) (func log1pf ((float x))  (out float))
     (decl) (func log1pl ((real x))   (out real))

     (decl) (func log2  ((double x)) (out double))
     (decl) (func log2f ((float x))  (out float))
     (decl) (func log2l ((real x))   (out real))

     (decl) (func logb  ((double x)) (out double))
     (decl) (func logbf ((float x))  (out float))
     (decl) (func logbl ((real x))   (out real))

     (decl) (func modf  ((double value) (double * iptr)) (out double))
     (decl) (func modff ((float value)  (float * iptr))  (out float))
     (decl) (func modfl ((real value)   (real * iptr))   (out real))

     (decl) (func scalbn  ((double x) (int n)) (out double))
     (decl) (func scalbnf ((float x)  (int n)) (out float))
     (decl) (func scalbnl ((real x)   (int n)) (out real))

     (decl) (func scalbln  ((double x) (long n)) (out double))
     (decl) (func scalblnf ((float x)  (long n)) (out float))
     (decl) (func scalblnl ((real x)   (long n)) (out real))

     ;;; ---- power ----
     (decl) (func cbrt  ((double x)) (out double))
     (decl) (func cbrtf ((float x))  (out float))
     (decl) (func cbrtl ((real x))   (out real))

     (decl) (func fabs  ((double x)) (out double))
     (decl) (func fabsf ((float x))  (out float))
     (decl) (func fabsl ((real x))   (out real))

     (decl) (func hypot  ((double x) (double y)) (out double))
     (decl) (func hypotf ((float x)  (float y))  (out float))
     (decl) (func hypotl ((real x)   (real y))   (out real))

     (decl) (func pow  ((double x) (double y)) (out double))
     (decl) (func powf ((float x)  (float y))  (out float))
     (decl) (func powl ((real x)   (real y))   (out real))

     (decl) (func sqrt  ((double x)) (out double))
     (decl) (func sqrtf ((float x))  (out float))
     (decl) (func sqrtl ((real x))   (out real))

     ;;; ---- error/gamma ----
     (decl) (func erf  ((double x)) (out double))
     (decl) (func erff ((float x))  (out float))
     (decl) (func erfl ((real x))   (out real))

     (decl) (func erfc  ((double x)) (out double))
     (decl) (func erfcf ((float x))  (out float))
     (decl) (func erfcl ((real x))   (out real))

     (decl) (func lgamma  ((double x)) (out double))
     (decl) (func lgammaf ((float x))  (out float))
     (decl) (func lgammal ((real x))   (out real))

     (decl) (func tgamma  ((double x)) (out double))
     (decl) (func tgammaf ((float x))  (out float))
     (decl) (func tgammal ((real x))   (out real))

     ;;; ---- nearest-integer ----
     (decl) (func ceil  ((double x)) (out double))
     (decl) (func ceilf ((float x))  (out float))
     (decl) (func ceill ((real x))   (out real))

     (decl) (func floor  ((double x)) (out double))
     (decl) (func floorf ((float x))  (out float))
     (decl) (func floorl ((real x))   (out real))

     (decl) (func nearbyint  ((double x)) (out double))
     (decl) (func nearbyintf ((float x))  (out float))
     (decl) (func nearbyintl ((real x))   (out real))

     (decl) (func rint  ((double x)) (out double))
     (decl) (func rintf ((float x))  (out float))
     (decl) (func rintl ((real x))   (out real))

     (decl) (func lrint  ((double x)) (out long))
     (decl) (func lrintf ((float x))  (out long))
     (decl) (func lrintl ((real x))   (out long))

     (decl) (func llrint  ((double x)) (out llong))
     (decl) (func llrintf ((float x))  (out llong))
     (decl) (func llrintl ((real x))   (out llong))

     (decl) (func round  ((double x)) (out double))
     (decl) (func roundf ((float x))  (out float))
     (decl) (func roundl ((real x))   (out real))

     (decl) (func lround  ((double x)) (out long))
     (decl) (func lroundf ((float x))  (out long))
     (decl) (func lroundl ((real x))   (out long))

     (decl) (func llround  ((double x)) (out llong))
     (decl) (func llroundf ((float x))  (out llong))
     (decl) (func llroundl ((real x))   (out llong))

     (decl) (func trunc  ((double x)) (out double))
     (decl) (func truncf ((float x))  (out float))
     (decl) (func truncl ((real x))   (out real))

     ;;; ---- remainder ----
     (decl) (func fmod  ((double x) (double y)) (out double))
     (decl) (func fmodf ((float x)  (float y))  (out float))
     (decl) (func fmodl ((real x)   (real y))   (out real))

     (decl) (func remainder  ((double x) (double y)) (out double))
     (decl) (func remainderf ((float x)  (float y))  (out float))
     (decl) (func remainderl ((real x)   (real y))   (out real))

     (decl) (func remquo  ((double x) (double y) (int * quo)) (out double))
     (decl) (func remquof ((float x)  (float y)  (int * quo)) (out float))
     (decl) (func remquol ((real x)   (real y)   (int * quo)) (out real))

     ;;; ---- manipulation ----
     (decl) (func copysign  ((double x) (double y)) (out double))
     (decl) (func copysignf ((float x)  (float y))  (out float))
     (decl) (func copysignl ((real x)   (real y))   (out real))

     (decl) (func nan  ((const char * tagp)) (out double))
     (decl) (func nanf ((const char * tagp)) (out float))
     (decl) (func nanl ((const char * tagp)) (out real))

     (decl) (func nextafter  ((double x) (double y)) (out double))
     (decl) (func nextafterf ((float x)  (float y))  (out float))
     (decl) (func nextafterl ((real x)   (real y))   (out real))

     (decl) (func nexttoward  ((double x) (real y)) (out double))
     (decl) (func nexttowardf ((float x)  (real y)) (out float))
     (decl) (func nexttowardl ((real x)   (real y)) (out real))

     ;;; ---- min/max/difference ----
     (decl) (func fdim  ((double x) (double y)) (out double))
     (decl) (func fdimf ((float x)  (float y))  (out float))
     (decl) (func fdiml ((real x)   (real y))   (out real))

     (decl) (func fmax  ((double x) (double y)) (out double))
     (decl) (func fmaxf ((float x)  (float y))  (out float))
     (decl) (func fmaxl ((real x)   (real y))   (out real))

     (decl) (func fmin  ((double x) (double y)) (out double))
     (decl) (func fminf ((float x)  (float y))  (out float))
     (decl) (func fminl ((real x)   (real y))   (out real))

     (decl) (func fma  ((double x) (double y) (double z)) (out double))
     (decl) (func fmaf ((float x)  (float y)  (float z))  (out float))
     (decl) (func fmal ((real x)   (real y)   (real z))   (out real))
     ))
