;;;; Cicili std rc
;;; a heap value with shared ownership -- a cell that counts its owners
;;;
;;; An rc is a cell with one member added, and that is the whole difference:
;;;
;;;   struct cell_array_int { array_int *ptr; };
;;;   struct rc_array_int   { array_int *ptr; size_t *count; };
;;;
;;; It is NOT a cell over a context struct any more. It used to be
;;; (<> cell rc a context) -- a cell holding a pointer to a context holding a
;;; pointer to the payload -- so reaching the payload was three loads and every
;;; front end was one of cell's front ends with another layer wrapped round it:
;;; let_rc expanded to let_cell expanded to a closure. The macros below are
;;; cell's macros with the count folded in, expanding once.
;;;
;;; `count' is shared between the copies; `ptr' is shared too. Freeing an rc
;;; drops the count, and the last one out frees the payload, the count and the
;;; box. A clone is a new rc sharing both pointers with the count bumped -- not
;;; a copy of the payload.
;;;
;;;   (letin ((r (new rc array (cast (const int []) '{ 1 2 3 }))))
;;;     (let_rc (arr r) (printf "%zu\n" (len_array (cof arr))))   ; borrow
;;;     (letin ((c (clone_rc r)))                                 ; share, count 2
;;;       (take_rc (arr c) …)))                                   ; no-op, not sole
;;;
;;; Reach the payload through let_rc / letn_rc (borrow) or take_rc / taken_rc
;;; (consume, and only when this rc is the last owner). Never free it yourself.

(generic decl-rc
  (a)

  (non-copy)
  (struct (<> rc a)
          (member a ref ptr)
          (member size_t * count))

  (typedef a (<> rc a interior_t))

  ;; super type declaration to use in 'type-check
  (guard __RC_TYPE_H_
    (decl) (struct (<> std rc)))
  (typedef (<> std rc) (<> rc a type_t))

  (decl) (func (<> free rc a) (((<> rc a) * rc)))          ; needed for letin
  (decl) (func (<> free rc a pointer) (((<> rc a) ** rc))) ; needed to pass move to a function

  ;; takes a reference to an rc, hands back a new one sharing the payload
  (decl) (func (<> clone rc a) (((<> rc a) ref rc)) (out (<> rc a)))

  ) ; decl-rc


(generic impl-rc
  (a)

  ;; the last owner frees the payload, the count and the box; everyone else
  ;; just drops the count. A dead or empty rc is a no-op, so double freeing is
  ;; not a special case anyone has to think about.
  (inline)
  (func (<> free rc a) (((<> rc a) * rc))
        (syslog! (printf "FREE RC: %p\n" (-> rc ptr)))
        (when (and (-> rc ptr) (-> rc count))
          (syslog! (printf "FREE RC COUNT: %zu\n" (cof (-> rc count))))
          (if (== (cof (-> rc count)) 1)
              (block
                ((<> free a) (-> rc ptr))
                (free (-> rc count))
                (free (-> rc ptr)))
              (-- (cof (-> rc count))))))

  (inline)
  (func (<> free rc a pointer) (((<> rc a) ** rc))
        ((<> free rc a) (cof rc)))

  ;; Both pointers are shared, so the payload is freed once, when the last owner
  ;; goes. Nothing is copied -- the old rc had to memcpy a context struct
  ;; because two cells on one context would have double freed it; there is no
  ;; context now, so there is nothing to duplicate.
  ;; A dead or empty rc clones to an empty rc rather than resurrecting itself.
  (func (<> clone rc a) (((<> rc a) ref rc))
        (out (<> rc a))
        (when (and (-> rc ptr) (-> rc count) (>= (cof (-> rc count)) 1))
          (++ (cof (-> rc count)))
          (syslog! (printf "CLONE RC: %p, count %zu\n" (-> rc ptr) (cof (-> rc count))))
          (return (cast (<> rc a) '{ (-> rc ptr) (-> rc count) })))
        (return (cast (<> rc a) '{ nil nil })))

  ) ; impl-rc


;;;; ------------------------------------------------------------------
;;;; front ends. These are cell's, with the count folded in -- not wrappers
;;;; round cell's, which is what made every rc borrow expand to two closures.
;;;; ------------------------------------------------------------------

(DEFMACRO free_rc (rc)
  (LET ((rc rc)
        (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER '(move ref)))))
    (IF (CICILI:KEY-EQ (NTH 2 full-type) 'move)
        `((<> free ,(NTH 1 full-type)) (aof ,rc))
      `((<> free ,(NTH 1 full-type)) ,rc))))


;;; (new rc TYPE ARGS…) -- new_cell's body with a count alongside the box
(DEFMACRO new_rc (type &REST args)
  (LET* ((ctor `(<> new ,type))
         (args args)
         (a (CICILI:INFER-TYPE `(,ctor ,@args)))
         (ptr-name   (GENSYM (FORMAT NIL "~A_ptr"   (SYMBOL-NAME (CAR a)))))
         (obj-name   (GENSYM (FORMAT NIL "~A_obj"   (SYMBOL-NAME (CAR a)))))
         (count-name (GENSYM (FORMAT NIL "~A_count" (SYMBOL-NAME (CAR a))))))
    (WHEN (> (LENGTH a) 1) (ERROR (FORMAT NIL "new rc got invalid type ~A for ~A" a ctor)))
    `(letn ((,@a ref ,ptr-name . (FUNCTION (malloc (sizeof ,@a))))
            (,@a move ,obj-name . (FUNCTION (,ctor ,@args)))
            (size_t * ,count-name . (FUNCTION (malloc (sizeof size_t)))))
       (syslog! (printf "NEW RC: %p\n" ,ptr-name))
       (memcpy ,ptr-name (aof ,obj-name) (sizeof ,obj-name))
       (set (cof ,count-name) 1)
       (cast (<> rc ,@a) '{ ,ptr-name ,count-name }))))


;;; Nothing but a type inferrer: works out which instantiation of
;;; (<> clone rc a) the given rc belongs to and calls it.
(DEFMACRO clone_rc (rc)
  (LET ((rc rc)
        (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER '(move ref)))))
    (IF (CICILI:KEY-EQ (NTH 2 full-type) 'move)
        `((<> clone ,(NTH 1 full-type)) (aof ,rc))
      `((<> clone ,(NTH 1 full-type)) ,rc))))


;;; (sole_rc rc) -- is this rc the only owner of its payload?
;;;
;;; The test take_rc makes before it hands the payload over, on its own, because
;;; the two answers are wanted in different places. take_rc CONSUMES. A caller
;;; that wants to WRITE through a payload it still owns needs the question
;;; answered without the consuming -- pair it with let_rc, and together they are
;;; Rust's Rc::get_mut: mutate only while nobody else can see it.
;;;
;;; A dead or empty rc answers false, so this means "mine alone to write", not
;;; merely "count is one".
(DEFMACRO sole_rc (rc)
  (LET* ((rc rc)
         (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER '(move ref))))
         (self (IF (CICILI:KEY-EQ (NTH 2 full-type) 'ref) `(-> ,rc) `($ ,rc))))
    `(and (,@self ptr) (,@self count) (== (cof (,@self count)) 1))))


;;; borrow: the rc keeps owning the payload, the body sees it by reference
(DEFMACRO let_rc ((obj rc &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> let ,type-name ,(GENSYM)) :rc (aof ,rc) ,@captures)
           (when (-> rc ptr)
             (let (((<> ,type-name interior_t) ref ,obj . (FUNCTION (-> rc ptr))))
               ,@body)))))))


;;; borrow, as an expression: `default' is what a dead or empty rc answers, so
;;; it has to have the same type as the body
(DEFMACRO letn_rc ((obj rc default &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc)
        (default default))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> letn ,type-name ,(GENSYM)) :rc (aof ,rc) :default_value ,default ,@captures)
           (out auto)
           (return (? (-> rc ptr)
                      (letn (((<> ,type-name interior_t) ref ,obj . (FUNCTION (-> rc ptr))))
                        ,@body)
                      default_value)))))))


;;; consume, and only when this rc is the last owner -- a shared payload belongs
;;; to the other owners too. The count is what take_cell has no reason to check
;;; and the only thing these add to it.
;;;
;;; `obj' is bound with `letin', so the payload's own destructor runs at the end
;;; of the body. The box and the count are freed here and both members zeroed,
;;; so the rc's own cleanup -- it arrived by `move' -- finds nothing left to do
;;; rather than freeing the payload a second time.
(DEFMACRO take_rc ((obj rc &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> take ,type-name ,(GENSYM)) :rc ,rc ,@captures)
           (when (and ($ rc ptr) ($ rc count) (== (cof ($ rc count)) 1))
             (letin ((,obj (cof ($ rc ptr))))
               (free ($ rc count))
               (free ($ rc ptr))
               (set ($ rc ptr) nil
                    ($ rc count) nil)
               ,@body)))))))


;;; consume, as an expression: `default' answers a shared, dead or empty rc
(DEFMACRO taken_rc ((obj rc default &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc)
        (default default))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> taken ,type-name ,(GENSYM)) :rc ,rc :default_value ,default ,@captures)
           (out auto)
           ;; letin, not letn: the payload is taken by value and its own
           ;; destructor has to run at the end of the body. `letn' with `auto'
           ;; binds it without one, which leaks the payload silently -- the
           ;; trace simply has no FREE line in it.
           (return (? (and ($ rc ptr) ($ rc count) (== (cof ($ rc count)) 1))
                      (letin ((,obj (cof ($ rc ptr))))
                        (free ($ rc count))
                        (free ($ rc ptr))
                        (set ($ rc ptr) nil
                             ($ rc count) nil)
                        ,@body)
                      default_value)))))))
