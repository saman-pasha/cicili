;;;; Cicili std rc
;;; a heap value with shared ownership -- a cell that counts its owners
;;;
;;; An rc is a cell with one member added, and that is the whole difference:
;;;
;;;   struct cell_array_int { array_int *ptr; };
;;;   struct rc_array_int   { array_int *ptr; size_t *count; };
;;;
;;; It is NOT a cell over a context struct any more. It used to be
;;; (<> cell rc a context) -- a cell holding a pointer to a context holding a
;;; pointer to the payload -- so reaching the payload was three loads and every
;;; front end was one of cell's front ends with another layer wrapped round it:
;;; let_rc expanded to let_cell expanded to a closure. The macros below are
;;; cell's macros with the count folded in, expanding once.
;;;
;;; `count' is shared between the copies; `ptr' is shared too. Freeing an rc
;;; drops the count, and the last one out frees the payload, the count and the
;;; box. A clone is a new rc sharing both pointers with the count bumped -- not
;;; a copy of the payload.
;;;
;;;   (letin ((r (new rc array (cast (const int []) '{ 1 2 3 }))))
;;;     (let_rc (arr r) (printf "%zu\n" (len_array (cof arr))))   ; borrow
;;;     (letin ((c (clone_rc r)))                                 ; share, count 2
;;;       (take_rc (arr c) …)))                                   ; no-op, not sole
;;;
;;; Reach the payload through let_rc / letn_rc (borrow) or take_rc / taken_rc
;;; (consume, and only when this rc is the last owner). Never free it yourself.
;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


(generic decl-rc
  (a)

  ;; `get' hands back a borrow of the payload, so the maybe it answers with
  ;; carries the rc's own pointer rather than a copy -- see the note on the
  ;; implementation below.
  (decl-maybe ref a)

  (non-copy)
  (struct (<> rc a)
          (member a ref ptr)
          (member size_t * count))

  (typedef a (<> rc a interior_t))

  ;; super type declaration to use in 'type-check
  (guard __RC_TYPE_H_
    (decl) (struct (<> std rc)))
  (typedef (<> std rc) (<> rc a type_t))

  (decl) (func (<> free rc a) (((<> rc a) * rc)))          ; needed for letin
  (decl) (func (<> free rc a pointer) (((<> rc a) ** rc))) ; needed to pass move to a function

  ;; takes a reference to an rc, hands back a new one sharing the payload
  (decl) (func (<> clone rc a) (((<> rc a) ref rc)) (out (<> rc a)))

  ;; Is the payload still there, and if so what.
  ;;
  ;; An rc that has been moved out of, or was never filled, is empty -- and that
  ;; is a case rather than a null check, which is the argument
  ;; lib/std/maybe.cicili makes. `let_rc' and `take_rc' below open an rc for a
  ;; BLOCK; this answers for one expression, so an rc can be matched, bound or
  ;; returned like any other value.
  (decl) (func (<> get rc a) (((<> rc a) ref rc)) (out (<> Maybe ref a)))

  ) ; decl-rc


(generic impl-rc
  (a)

  (impl-maybe ref a)

  ;; The maybe is (decl-maybe ref a), so the payload is the rc's own pointer
  ;; rather than a copy of what it holds -- `match' hands out an `a ref' to
  ;; deref, and it is the SHARED payload, which is the point of an rc. Exactly
  ;; vector's `nth' (lib/std/vector.cicili:152), for exactly that reason.
  ;;
  ;; The count is checked as well as the pointer: an rc whose count has run out
  ;; is dead, and `clone' already refuses to resurrect one. Reading through a
  ;; dead rc would be a use-after-free, so it answers `nothing'.
  (func (<> get rc a) (((<> rc a) ref rc))
        (out (<> Maybe ref a))
        (if (and (-> rc ptr) (-> rc count) (>= (cof (-> rc count)) 1))
            (return (just (-> rc ptr)))
          (return (nothing))))

  ;; the last owner frees the payload, the count and the box; everyone else
  ;; just drops the count. A dead or empty rc is a no-op, so double freeing is
  ;; not a special case anyone has to think about.
  (inline)
  (func (<> free rc a) (((<> rc a) * rc))
        (syslog! (printf "FREE RC: %p\n" (-> rc ptr)))
        (when (and (-> rc ptr) (-> rc count))
          (syslog! (printf "FREE RC COUNT: %zu\n" (cof (-> rc count))))
          (if (== (cof (-> rc count)) 1)
              (block
                ((<> free a) (-> rc ptr))
                (free (-> rc count))
                (free (-> rc ptr)))
              (-- (cof (-> rc count))))))

  (inline)
  (func (<> free rc a pointer) (((<> rc a) ** rc))
        ((<> free rc a) (cof rc)))

  ;; Both pointers are shared, so the payload is freed once, when the last owner
  ;; goes. Nothing is copied -- the old rc had to memcpy a context struct
  ;; because two cells on one context would have double freed it; there is no
  ;; context now, so there is nothing to duplicate.
  ;; A dead or empty rc clones to an empty rc rather than resurrecting itself.
  (func (<> clone rc a) (((<> rc a) ref rc))
        (out (<> rc a))
        (when (and (-> rc ptr) (-> rc count) (>= (cof (-> rc count)) 1))
          (++ (cof (-> rc count)))
          (syslog! (printf "CLONE RC: %p, count %zu\n" (-> rc ptr) (cof (-> rc count))))
          (return (cast (<> rc a) '{ (-> rc ptr) (-> rc count) })))
        (return (cast (<> rc a) '{ nil nil })))

  ) ; impl-rc


;;;; ------------------------------------------------------------------
;;;; arc -- an rc whose count is moved atomically
;;;;
;;;; Same struct, same five functions, one difference: the count is incremented
;;;; and decremented with the compiler's atomic builtins, so two threads may
;;;; hold clones of the same arc and drop them in any order without racing on
;;;; the count. Nothing else about it is thread safe. The PAYLOAD is shared and
;;;; unguarded, exactly as an rc's is -- an arc says "this refcount is safe to
;;;; share", not "this value is".
;;;;
;;;; THE BUILTINS ARE THE __sync_ ONES, which are full barriers. __atomic_ with
;;;; RELAXED on the clone and ACQ_REL on the release is the tighter pairing and
;;;; would be the one to reach for if a refcount ever showed up in a profile --
;;;; but those take a memory-order argument, and the __ATOMIC_* orders are
;;;; preprocessor macros rather than symbols Cicili can be told about. A full
;;;; barrier on a refcount is a real cost and an invisible one; correctness
;;;; first, and the note is here for whoever measures.
;;;;
;;;; For a shared value that also needs its CONTENTS guarded, use a mutex
;;;; alongside -- lib/std/pthread/pthread.cicili's `lock', or the haskell layer's
;;;; Arc, which carries the mutex in the box and takes a callback per case.
;;;; ------------------------------------------------------------------

(generic decl-arc
  (a)

  (decl-maybe ref a)

  (non-copy)
  (struct (<> arc a)
          (member a ref ptr)
          (member size_t * count))

  (typedef a (<> arc a interior_t))

  ;; The same super type rc declares, and the same guard, so whichever of the
  ;; two is instantiated first emits it and the second does not repeat it. An
  ;; arc used without any rc in the program still needs it: the typedef below
  ;; names it -- so it is declared HERE, above the typedef, not after it.
  (guard __RC_TYPE_H_
    (decl) (struct (<> std rc)))

  ;; THE SUPER TYPE IS `std rc' AND NOT ONE OF ITS OWN, deliberately. An arc IS
  ;; an rc -- same members, same ownership rule, a different instruction for
  ;; moving the count -- so it answers to rc's origin, and every front end below
  ;; (free_rc, clone_rc, let_rc, take_rc …) works on an arc unchanged. They
  ;; dispatch on the origin to find the instantiation and then name the concrete
  ;; type, so (free_rc a) on an arc_int resolves free_arc_int. Giving arc an
  ;; origin of its own would have meant a second copy of all eight of them.
  (typedef (<> std rc) (<> arc a type_t))

  ;; THE COUNT MOVES THROUGH THESE TWO AND NOWHERE ELSE.
  ;;
  ;; They wrap __sync_add_and_fetch and __sync_sub_and_fetch, which are compiler
  ;; builtins rather than functions. Declaring a builtin is not an option --
  ;; they are type-generic, and a concrete prototype earns "conflicting types
  ;; for built-in function ... expected 'void()'" -- so the call goes through a
  ;; `code' escape and what Cicili sees is an ordinary function with a type.
  ;;
  ;; Guarded, so one definition serves every instantiation.
  (guard __ARC_ATOMIC_H_
    (decl) (func __cicili_arc_incr ((size_t * p)) (out size_t))
    (decl) (func __cicili_arc_decr ((size_t * p)) (out size_t)))

  (decl) (func (<> free arc a) (((<> arc a) * arc)))
  (decl) (func (<> free arc a pointer) (((<> arc a) ** arc)))
  (decl) (func (<> clone arc a) (((<> arc a) ref arc)) (out (<> arc a)))
  (decl) (func (<> get arc a) (((<> arc a) ref arc)) (out (<> Maybe ref a)))

  ) ; decl-arc


(generic impl-arc
  (a)

  (impl-maybe ref a)

  (guard __ARC_ATOMIC_IMPL_H_
    (inline)
    (func __cicili_arc_incr ((size_t * p)) (out size_t)
          (code "return __sync_add_and_fetch(p, 1);"))
    (inline)
    (func __cicili_arc_decr ((size_t * p)) (out size_t)
          (code "return __sync_sub_and_fetch(p, 1);")))

  ;; __sync_sub_and_fetch answers with the count AFTER the decrement, so the
  ;; thread that sees zero is the one that took it there -- exactly one thread,
  ;; whatever the interleaving. rc reads the count and then decrements, which is
  ;; two steps and a race between them; that gap is the whole reason arc exists.
  (inline)
  (func (<> free arc a) (((<> arc a) * arc))
        (syslog! (printf "FREE ARC: %p\n" (-> arc ptr)))
        (when (and (-> arc ptr) (-> arc count))
          (if (== (__cicili_arc_decr (-> arc count)) 0)
              (block
                ((<> free a) (-> arc ptr))
                (free (-> arc count))
                (free (-> arc ptr))))))

  (inline)
  (func (<> free arc a pointer) (((<> arc a) ** arc))
        ((<> free arc a) (cof arc)))

  ;; A dead or empty arc clones to an empty one rather than resurrecting itself,
  ;; as rc's does. The test is on the value the increment RETURNED and not on a
  ;; separate read: two threads cloning a dying arc could otherwise both read a
  ;; live count, and both decide they were the survivor.
  (func (<> clone arc a) (((<> arc a) ref arc))
        (out (<> arc a))
        (when (and (-> arc ptr) (-> arc count))
          (when (> (__cicili_arc_incr (-> arc count)) 1)
            (syslog! (printf "CLONE ARC: %p\n" (-> arc ptr)))
            (return (cast (<> arc a) '{ (-> arc ptr) (-> arc count) })))
          ;; it was zero before the increment: already dead, put it back
          (__cicili_arc_decr (-> arc count)))
        (return (cast (<> arc a) '{ nil nil })))

  ;; A plain read is enough to answer "is anyone still holding this". The caller
  ;; holds a reference itself, so the answer cannot turn to no while it looks --
  ;; and if it holds none, no atomic would have saved it.
  (func (<> get arc a) (((<> arc a) ref arc))
        (out (<> Maybe ref a))
        (if (and (-> arc ptr) (-> arc count) (>= (cof (-> arc count)) 1))
            (return (just (-> arc ptr)))
          (return (nothing))))

  ) ; impl-arc



;;;; ------------------------------------------------------------------
;;;; rcbox -- an rc a container can hold
;;;;
;;;; An rc is (non-copy), and that is the point: copying one without bumping the
;;;; count is the double free the type exists to prevent. It also means a
;;;; container that stores its payload BY VALUE cannot hold one -- a haskell
;;;; List's (<> Cons a) takes an `a', and the specifier refuses a non-copy
;;;; there. That refusal is correct and there is no arguing with it.
;;;;
;;;; So the container holds a POINTER to an rc. A pointer is copyable, the rc
;;;; behind it is not, and the ownership rule is unchanged: whoever holds the
;;;; pointer holds one reference, `clone' hands back a new pointer with the
;;;; count bumped, and `free' drops one reference and the box with it.
;;;;
;;;; draft/collection/persistent-btree.cicili is what this is for -- its
;;;; children are shared subtrees, which is what makes the tree persistent, and
;;;; they live in a List.
;;;;
;;;; ONE ALLOCATION MORE THAN AN rc, which is the price of the indirection: the
;;;; payload box, the count, and now the rc itself. A container of rcs is the
;;;; case that needs it; anything holding an rc in a variable should use `rc'
;;;; directly and pay for neither.
;;;; ------------------------------------------------------------------

(generic decl-rcbox
  ;; NAME is the pointer type the container stores; A is the payload
  (name a)

  (decl-rc a)

  (typedef (<> rc a) * name)

  (decl) (func (<> new name)   ((a obj))   (out name))
  (decl) (func (<> clone name) ((name box)) (out name))
  (decl) (func (<> get name)   ((name box)) (out (<> Maybe ref a)))
  (decl) (func (<> free name)  ((name box)))
  (decl) (func (<> free name pointer) ((name * box)))

  ) ; decl-rcbox


(generic impl-rcbox
  (name a)

  (impl-rc a)

  ;; The payload is copied into the rc's own box, so the caller's copy is spent
  ;; -- for a class payload, which is a pointer, that copy is the pointer and
  ;; there is nothing to double free. A non-copy payload wants `rc' directly.
  (func (<> new name) ((a obj))
        (out name)
        (return (letn ((a ref ptr . #'(malloc (sizeof a)))
                       (size_t * count . #'(malloc (sizeof size_t)))
                       (name box . #'(malloc (sizeof (<> rc a)))))
                  (memcpy ptr (aof obj) (sizeof a))
                  (set (cof count) 1)
                  (set (-> box ptr) ptr (-> box count) count)
                  box)))

  ;; a second pointer to the SAME rc would share the box, and freeing either
  ;; would free it under the other -- so a clone is its own box over the same
  ;; payload, with the count bumped once for it
  (func (<> clone name) ((name box))
        (out name)
        (when (or (== box nil) (== (-> box ptr) nil) (== (-> box count) nil))
          (return nil))
        (++ (cof (-> box count)))
        (return (letn ((name fresh . #'(malloc (sizeof (<> rc a)))))
                  (set (-> fresh ptr) (-> box ptr) (-> fresh count) (-> box count))
                  fresh)))

  (inline)
  (func (<> get name) ((name box))
        (out (<> Maybe ref a))
        (when (== box nil) (return (nothing)))
        (return ((<> get rc a) box)))

  (func (<> free name) ((name box))
        (when box
          ((<> free rc a) box)
          (free box)))

  (inline)
  (func (<> free name pointer) ((name * box))
        ((<> free name) (cof box)))

  ) ; impl-rcbox


;;;; ------------------------------------------------------------------
;;;; front ends. These are cell's, with the count folded in -- not wrappers
;;;; round cell's, which is what made every rc borrow expand to two closures.
;;;; ------------------------------------------------------------------

(DEFMACRO free_rc (rc)
  (LET ((rc rc)
        (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER '(move ref)))))
    (IF (CICILI:KEY-EQ (NTH 2 full-type) 'move)
        `((<> free ,(NTH 1 full-type)) (aof ,rc))
      `((<> free ,(NTH 1 full-type)) ,rc))))


;;; (new rc TYPE ARGS…) -- new_cell's body with a count alongside the box
(DEFMACRO new_rc (type &REST args)
  (LET* ((ctor `(<> new ,type))
         (args args)
         (a (CICILI:INFER-TYPE `(,ctor ,@args)))
         (ptr-name   (GENSYM (FORMAT NIL "~A_ptr"   (SYMBOL-NAME (CAR a)))))
         (obj-name   (GENSYM (FORMAT NIL "~A_obj"   (SYMBOL-NAME (CAR a)))))
         (count-name (GENSYM (FORMAT NIL "~A_count" (SYMBOL-NAME (CAR a))))))
    (WHEN (> (LENGTH a) 1) (ERROR (FORMAT NIL "new rc got invalid type ~A for ~A" a ctor)))
    `(letn ((,@a ref ,ptr-name . (FUNCTION (malloc (sizeof ,@a))))
            (,@a move ,obj-name . (FUNCTION (,ctor ,@args)))
            (size_t * ,count-name . (FUNCTION (malloc (sizeof size_t)))))
       (syslog! (printf "NEW RC: %p\n" ,ptr-name))
       (memcpy ,ptr-name (aof ,obj-name) (sizeof ,obj-name))
       (set (cof ,count-name) 1)
       (cast (<> rc ,@a) '{ ,ptr-name ,count-name }))))


;;; (new arc TYPE ARGS…) -- new_rc's body, boxing the payload with a count of
;;; one. Separate from new_rc because the two name different structs; everything
;;; AFTER construction is shared, since an arc answers to rc's origin.
;;;
;;; It is a macro and not a function for the reason new_rc is: the payload is
;;; constructed here and moved into the box in one form. As a function taking
;;; (a move obj) the parameter carries a __cleanup__, so the payload would be
;;; freed on return while the box still pointed at it.
(DEFMACRO new_arc (type &REST args)
  (LET* ((ctor `(<> new ,type))
         (args args)
         (a (CICILI:INFER-TYPE `(,ctor ,@args)))
         (ptr-name   (GENSYM (FORMAT NIL "~A_ptr"   (SYMBOL-NAME (CAR a)))))
         (obj-name   (GENSYM (FORMAT NIL "~A_obj"   (SYMBOL-NAME (CAR a)))))
         (count-name (GENSYM (FORMAT NIL "~A_count" (SYMBOL-NAME (CAR a))))))
    (WHEN (> (LENGTH a) 1) (ERROR (FORMAT NIL "new arc got invalid type ~A for ~A" a ctor)))
    `(letn ((,@a ref ,ptr-name . (FUNCTION (malloc (sizeof ,@a))))
            (,@a move ,obj-name . (FUNCTION (,ctor ,@args)))
            (size_t * ,count-name . (FUNCTION (malloc (sizeof size_t)))))
       (syslog! (printf "NEW ARC: %p\n" ,ptr-name))
       (memcpy ,ptr-name (aof ,obj-name) (sizeof ,obj-name))
       (set (cof ,count-name) 1)
       (cast (<> arc ,@a) '{ ,ptr-name ,count-name }))))


;;; Nothing but a type inferrer: works out which instantiation of
;;; (<> clone rc a) the given rc belongs to and calls it.
(DEFMACRO clone_rc (rc)
  (LET ((rc rc)
        (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER '(move ref)))))
    (IF (CICILI:KEY-EQ (NTH 2 full-type) 'move)
        `((<> clone ,(NTH 1 full-type)) (aof ,rc))
      `((<> clone ,(NTH 1 full-type)) ,rc))))


;;; (sole_rc rc) -- is this rc the only owner of its payload?
;;;
;;; The test take_rc makes before it hands the payload over, on its own, because
;;; the two answers are wanted in different places. take_rc CONSUMES. A caller
;;; that wants to WRITE through a payload it still owns needs the question
;;; answered without the consuming -- pair it with let_rc, and together they are
;;; Rust's Rc::get_mut: mutate only while nobody else can see it.
;;;
;;; A dead or empty rc answers false, so this means "mine alone to write", not
;;; merely "count is one".
(DEFMACRO sole_rc (rc)
  (LET* ((rc rc)
         (full-type (NTH-VALUE 1 (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER '(move ref))))
         (self (IF (CICILI:KEY-EQ (NTH 2 full-type) 'ref) `(-> ,rc) `($ ,rc))))
    `(and (,@self ptr) (,@self count) (== (cof (,@self count)) 1))))


;;; borrow: the rc keeps owning the payload, the body sees it by reference
(DEFMACRO let_rc ((obj rc &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> let ,type-name ,(GENSYM)) :rc (aof ,rc) ,@captures)
           (when (-> rc ptr)
             (let (((<> ,type-name interior_t) ref ,obj . (FUNCTION (-> rc ptr))))
               ,@body)))))))


;;; borrow, as an expression: `default' is what a dead or empty rc answers, so
;;; it has to have the same type as the body
(DEFMACRO letn_rc ((obj rc default &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc)
        (default default))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> letn ,type-name ,(GENSYM)) :rc (aof ,rc) :default_value ,default ,@captures)
           (out auto)
           (return (? (-> rc ptr)
                      (letn (((<> ,type-name interior_t) ref ,obj . (FUNCTION (-> rc ptr))))
                        ,@body)
                      default_value)))))))


;;; consume, and only when this rc is the last owner -- a shared payload belongs
;;; to the other owners too. The count is what take_cell has no reason to check
;;; and the only thing these add to it.
;;;
;;; `obj' is bound with `letin', so the payload's own destructor runs at the end
;;; of the body. The box and the count are freed here and both members zeroed,
;;; so the rc's own cleanup -- it arrived by `move' -- finds nothing left to do
;;; rather than freeing the payload a second time.
(DEFMACRO take_rc ((obj rc &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> take ,type-name ,(GENSYM)) :rc ,rc ,@captures)
           (when (and ($ rc ptr) ($ rc count) (== (cof ($ rc count)) 1))
             (letin ((,obj (cof ($ rc ptr))))
               (free ($ rc count))
               (free ($ rc ptr))
               (set ($ rc ptr) nil
                    ($ rc count) nil)
               ,@body)))))))


;;; consume, as an expression: `default' answers a shared, dead or empty rc
(DEFMACRO taken_rc ((obj rc default &REST captures) &REST body)
  (LET ((obj obj)
        (rc rc)
        (default default))
    (MULTIPLE-VALUE-BIND (_ full-type) (CICILI:TYPE-CHECK rc :TYPEOF :std_rc :MODIFIER :move)
      (LET ((type-name (NTH 1 full-type)))
        `(closure ((<> taken ,type-name ,(GENSYM)) :rc ,rc :default_value ,default ,@captures)
           (out auto)
           ;; letin, not letn: the payload is taken by value and its own
           ;; destructor has to run at the end of the body. `letn' with `auto'
           ;; binds it without one, which leaks the payload silently -- the
           ;; trace simply has no FREE line in it.
           (return (? (and ($ rc ptr) ($ rc count) (== (cof ($ rc count)) 1))
                      (letin ((,obj (cof ($ rc ptr))))
                        (free ($ rc count))
                        (free ($ rc ptr))
                        (set ($ rc ptr) nil
                             ($ rc count) nil)
                        ,@body)
                      default_value)))))))
