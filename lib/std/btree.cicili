;;;; Cicili std btree
;;; an ordered map -- keys sorted, every operation logarithmic
;;;
;;; The API is draft/collection/persistent-btree.cicili's, brought over to the
;;; std idiom. Two things changed on the way:
;;;
;;;   * that one is PERSISTENT -- insert returns a new tree sharing structure
;;;     with the old, so every node is an Rc and every write allocates. This one
;;;     is mutable and owns its nodes outright, the same decision `vector' made
;;;     when it stopped being a window over an rc'd array. Wrap it in an `rc' if
;;;     you want sharing, and pay for it then.
;;;   * it is built on the Haskell layer (decl-data, decl-class, List, Functor).
;;;     This one is plain std: `either' for what can fail, `maybe' for what may
;;;     not be there.
;;;
;;; WHICH ANSWER COMES BACK IN WHICH CARRIER is the whole point of the split:
;;;
;;;   insert / delete   (<> Either BTREE_ERR size_t)   can FAIL -- a duplicate
;;;                     key, a key that is not there -- and the answer when it
;;;                     does not is the new length
;;;   search/min/max    (<> Maybe ref (<> pair k v))   cannot fail, may simply
;;;                     have no answer, and the answer is a POINTER INTO the
;;;                     node so the caller can read the key and write the value
;;;
;;; A missing key is not an error for `search' and is one for `delete', and the
;;; two carriers say so without a comment.
;;;
;;;   (letin ((t (new btree)))
;;;     (match ((<> insert btree int int) (aof t) 42 7)
;;;       (right n   (printf "%zu keys\n" n))
;;;       (left  err (printf "insert failed: %d\n" err)))
;;;     (match ((<> search btree int int) (aof t) 42)
;;;       (just p  (printf "42 -> %d\n" ($ (cof p) val)))
;;;       (nothing (printf "not there\n"))))
;;;
;;; ORDER. `t' is the minimum degree, Cormen's: a node holds at most 2t-1 pairs
;;; and 2t children, and at least t-1 pairs unless it is the root. It is a
;;; generic parameter and part of every name, so two trees of different degree
;;; over the same key and value types are two types and cannot be confused.
;;;
;;; KEYS ARE COMPARED WITH < AND ==, so the key type has to be one those mean
;;; something for -- a scalar, or a typedef to one. A string key needs a wrapper
;;; type with those operators, which C does not have; that is a real limit and
;;; not an oversight.
;;;
;;; ------------------------------------------------------------------
;;; A LEAF IS A DIFFERENT TYPE FROM AN INTERNAL NODE, and that is the one
;;; structural decision worth knowing about.
;;;
;;; The obvious layout gives every node a kids[2t] array inline. But in a
;;; B-tree of degree t almost every node is a leaf -- one internal node per
;;; 2t-ish leaves -- and a leaf never reads a child, so that layout spends 2t
;;; pointers on the majority of nodes to hold nothing. At t=6 it is 96 bytes of
;;; a 200-byte node.
;;;
;;; Moving ALL the child pointers out into one pool shared by the tree was
;;; tried and is worse: it saves the same memory but puts an extra indirection
;;; on every descent, and measured 10 to 20% slower on insert and search at
;;; every size, cache resident or not. The dead weight was on the leaves; the
;;; cost landed on the internal nodes.
;;;
;;; So take the pointers off the leaves and leave them exactly where they were
;;; on the internal nodes:
;;;
;;;   struct bthead { size_t n; pair items[2t-1]; };            <- IS a leaf, 96
;;;   struct btnode { struct bthead head; bthead *kids[2t]; };  <- internal, 192
;;;
;;; NO TAG, NO BRANCH, NO CAST ON THE HOT PATH. A B-tree is perfectly balanced,
;;; so every node at the bottom is a leaf and every node above it is not: the
;;; tree's own HEIGHT says which kind a pointer refers to, and no node carries
;;; a flag saying so. A `leaf' field and a test on it per level would be the
;;; alternative; a counter in a register is not.
;;;
;;; `kids' holds `bthead *'. For a leaf child that is the whole object; for an
;;; internal child it points at its first member, which C says is the same
;;; address as the node itself, so casting back is defined and not a
;;; reinterpretation. Every descent reads `n' and `items' straight through that
;;; pointer whatever kind of node it found, and the cast to `btnode *' happens
;;; only where the child's OWN children are wanted -- which is only above the
;;; bottom level, and only in insert and delete.
;;;
;;; What it costs is two structs instead of one and a `level' threaded through
;;; every recursion: `split', `merge' and both `borrow's take the child's level
;;; and skip the kids half of their work when it is zero, one predictable
;;; branch in a function that already does a memmove.
;;;
;;; What it buys, against the same tree with kids[2t] inline on every node, at
;;; t=6, negative being faster:
;;;
;;;      keys     insert    search   traverse    delete
;;;    20 000    -13.0%     +2.5%     -9.5%      +0.1%
;;;   100 000     -9.4%     +3.3%     -1.9%      -8.9%
;;;   400 000    -17.5%    -12.2%    -25.5%     -17.1%
;;; 1 000 000    -19.7%    -14.2%    -31.4%     -16.9%
;;;
;;; The win grows with the tree, which is what a footprint win looks like: at
;;; twenty thousand keys everything is in cache and there is nothing to save,
;;; and search is a hair slower there for the level counter.
;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


(generic decl-btree
  (k v t)

  ;; ---- shared by every instantiation, emitted once -------------------
  (guard __BTREE_H_
    (enum BTREE_ERR
      (BT_OK . 0)
      (BT_DUPLICATE_KEY)
      (BT_NOT_FOUND))

    ;; super type declaration to use in 'type-check
    (decl) (struct (<> std btree)))

  ;; ---- per key/value pair --------------------------------------------
  (guard (<> __BTREE_PAIR_ k v _H_)
    (struct (<> pair k v)
            (member k key)
            (member v val)))

  ;; ---- per instantiation ---------------------------------------------
  (guard (<> __BTREE_ k v t _H_)

    (decl-maybe ref (<> pair k v))
    (decl-either BTREE_ERR size_t)

    ;; A LEAF IS AN bthead AND NOTHING ELSE. It is also the first member of
    ;; every internal node, which is what lets one pointer type name both:
    ;; a pointer to a struct and a pointer to its first member are the same
    ;; address, so `(cast (btnode *) h)' recovers the node a head belongs to
    ;; whenever the level says there is one.
    (struct (<> bthead k v t)
            (member size_t n)                                ; pairs in use
            (member (<> pair k v) items [ (- (* 2 t) 1) ]))

    (struct (<> btnode k v t)
            (member (<> bthead k v t) head)
            (member (<> bthead k v t) * kids [ (* 2 t) ]))

    (non-copy)
    (struct (<> btree k v t)
            ;; whatever the root is, it is reachable as a head
            (member (<> bthead k v t) ref root)
            ;; 0 means the root is a leaf. This is the tag, once, for the whole
            ;; tree -- no node carries one.
            (member size_t height)
            (member size_t len))

    (typedef k (<> btree k v t key_t))
    (typedef v (<> btree k v t val_t))
    (typedef (<> pair k v) (<> btree k v t pair_t))
    (typedef (<> std btree) (<> btree k v t type_t))

    (decl) (func (<> free btree k v t) (((<> btree k v t) ref tree)))
    (decl) (func (<> free btree k v t pointer) (((<> btree k v t) ** tree)))
    (decl) (func (<> new btree k v t) () (out (<> btree k v t)))
    (decl) (func (<> order btree k v t) () (out size_t))
    (decl) (func (<> len btree k v t) (((<> btree k v t) ref tree)) (out size_t))
    ;; levels below the root -- 0 for an empty tree and for one that is a
    ;; single leaf. The descent reads it instead of reading a flag per node.
    (decl) (func (<> height btree k v t) (((<> btree k v t) ref tree)) (out size_t))
    ;; `height' is the only thing that says which kind a pointer refers to, so
    ;; it had better be right: this walks every internal level and answers
    ;; whether all n+1 children are there the whole way down to 0. A height
    ;; that has drifted above the real depth stops finding children (a fresh
    ;; node's kids are nil), and one that has drifted below shows up as keys
    ;; the traverse never reaches.
    (decl) (func (<> balanced btree k v t) (((<> btree k v t) ref tree)) (out bool))
    (decl) (func (<> search btree k v t) (((<> btree k v t) ref tree) (k key))
                 (out (<> Maybe ref (<> pair k v))))
    (decl) (func (<> min btree k v t) (((<> btree k v t) ref tree))
                 (out (<> Maybe ref (<> pair k v))))
    (decl) (func (<> max btree k v t) (((<> btree k v t) ref tree))
                 (out (<> Maybe ref (<> pair k v))))
    (decl) (func (<> insert btree k v t) (((<> btree k v t) ref tree) (k key) (v val))
                 (out (<> Either BTREE_ERR size_t)))
    (decl) (func (<> delete btree k v t) (((<> btree k v t) ref tree) (k key))
                 (out (<> Either BTREE_ERR size_t)))
    (decl) (func (<> traverse btree k v t) (((<> btree k v t) ref tree)
                                             (func callback (((<> pair k v) ref item))))))

  ) ; decl-btree


(generic impl-btree
  (k v t)

  (guard (<> __BTREE_IMPL_ k v t _H_)

    (impl-maybe ref (<> pair k v))
    (impl-either BTREE_ERR size_t)

    ;; ---- nodes ------------------------------------------------------
    ;; two constructors, because there are two sizes. A leaf allocates
    ;; sizeof(bthead) and not one byte more, which is the whole point.

    (func (<> newleaf btree k v t) ()
          (out (<> bthead k v t) ref)
          (let (((<> bthead k v t) ref leaf . #'(malloc (sizeof (<> bthead k v t)))))
            (syslog! (printf "NEW BTLEAF: %s %p\n" (symbol-name (<> btree k v t)) leaf))
            (set (-> leaf n) 0)
            (return leaf)))

    ;; answers a HEAD, like `newleaf' does, so a caller that does not care which
    ;; kind it asked for does not have to. The node is recovered with a cast
    ;; wherever the children are wanted.
    (func (<> newnode btree k v t) ()
          (out (<> bthead k v t) ref)
          (let (((<> btnode k v t) ref node . #'(malloc (sizeof (<> btnode k v t)))))
            (syslog! (printf "NEW BTNODE: %s %p\n" (symbol-name (<> btree k v t)) node))
            (set ($ (-> node head) n) 0)
            (memset (-> node kids) 0 (* (* 2 t) (sizeof ((<> bthead k v t) *))))
            (return (aof (-> node head)))))

    ;; `level' is the level of `h' itself, so the recursion counts down to the
    ;; leaves and stops there without asking any node what it is
    (func (<> freeall btree k v t) (((<> bthead k v t) ref h) (size_t level))
          (when h
            (when (> level 0)
              (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
                (for ((size_t i . 0)) (<= i (-> h n)) ((++ i))
                     (let (((<> bthead k v t) ref kid . #'(nth i (-> in kids))))
                       (when kid ((<> freeall btree k v t) kid (- level 1)))))))
            (syslog! (printf "FREE BTNODE: %p\n" h))
            (free h)))

    ;; ---- the tree ---------------------------------------------------

    (func (<> free btree k v t) (((<> btree k v t) ref tree))
          (syslog! (printf "FREE BTREE: %p\n" tree))
          (when (-> tree root)
            ((<> freeall btree k v t) (-> tree root) (-> tree height)))
          (set (-> tree root) nil
               (-> tree height) 0
               (-> tree len) 0))

    (func (<> free btree k v t pointer) (((<> btree k v t) ** tree))
          ((<> free btree k v t) (cof tree)))

    (func (<> new btree k v t) ()
          (out (<> btree k v t))
          (return (cast (<> btree k v t) '{ nil 0 0 })))

    (func (<> order btree k v t) ()
          (out size_t)
          (return (* 2 t)))

    (func (<> len btree k v t) (((<> btree k v t) ref tree))
          (out size_t)
          (return (-> tree len)))

    (func (<> height btree k v t) (((<> btree k v t) ref tree))
          (out size_t)
          (return (-> tree height)))

    (func (<> proof btree k v t) (((<> bthead k v t) ref h) (size_t level))
          (out bool)
          (when (== level 0) (return #t))
          (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
            (for ((size_t i . 0)) (<= i (-> h n)) ((++ i))
                 (let (((<> bthead k v t) ref kid . #'(nth i (-> in kids))))
                   (when (not kid) (return #f))
                   (when (not ((<> proof btree k v t) kid (- level 1))) (return #f)))))
          (return #t))

    (func (<> balanced btree k v t) (((<> btree k v t) ref tree))
          (out bool)
          (when (not (-> tree root))
            (return (== (-> tree height) 0)))
          (return ((<> proof btree k v t) (-> tree root) (-> tree height))))

    ;; ---- search -----------------------------------------------------
    ;; one loop for every level, leaf or not: `n' and `items' are read through
    ;; the head pointer either way, and `level' says whether there is a child
    ;; to take. No node is asked what kind it is.
    (func (<> search btree k v t) (((<> btree k v t) ref tree) (k key))
          (out (<> Maybe ref (<> pair k v)))
          (let (((<> bthead k v t) ref h . #'(-> tree root))
                (size_t level . #'(-> tree height)))
            (while h
              (let ((size_t i . 0))
                (while (and (< i (-> h n)) (< ($ (nth i (-> h items)) key) key))
                  (++ i))
                (when (and (< i (-> h n)) (== ($ (nth i (-> h items)) key) key))
                  (return (just (+ (-> h items) i))))
                (when (== level 0)
                  (return (nothing)))
                (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
                  (set h (nth i (-> in kids))))
                (set level (- level 1))))
            (return (nothing))))

    (func (<> min btree k v t) (((<> btree k v t) ref tree))
          (out (<> Maybe ref (<> pair k v)))
          (let (((<> bthead k v t) ref h . #'(-> tree root))
                (size_t level . #'(-> tree height)))
            (when (not h) (return (nothing)))
            (while (> level 0)
              (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
                (set h (nth 0 (-> in kids))
                     level (- level 1))))
            (when (== (-> h n) 0) (return (nothing)))
            (return (just (+ (-> h items) 0)))))

    (func (<> max btree k v t) (((<> btree k v t) ref tree))
          (out (<> Maybe ref (<> pair k v)))
          (let (((<> bthead k v t) ref h . #'(-> tree root))
                (size_t level . #'(-> tree height)))
            (when (not h) (return (nothing)))
            (while (> level 0)
              (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
                (set h (nth (-> h n) (-> in kids))
                     level (- level 1))))
            (when (== (-> h n) 0) (return (nothing)))
            (return (just (+ (-> h items) (- (-> h n) 1))))))

    ;; ---- traverse ---------------------------------------------------
    (func (<> walk btree k v t) (((<> bthead k v t) ref h) (size_t level)
                                  (func callback (((<> pair k v) ref item))))
          (when h
            (if (== level 0)
                (for ((size_t i . 0)) (< i (-> h n)) ((++ i))
                     (callback (+ (-> h items) i)))
              (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
                (for ((size_t i . 0)) (< i (-> h n)) ((++ i))
                     (block
                       ((<> walk btree k v t) (nth i (-> in kids)) (- level 1) callback)
                       (callback (+ (-> h items) i))))
                ((<> walk btree k v t) (nth (-> h n) (-> in kids)) (- level 1) callback)))))

    (func (<> traverse btree k v t) (((<> btree k v t) ref tree)
                                      (func callback (((<> pair k v) ref item))))
          ((<> walk btree k v t) (-> tree root) (-> tree height) callback))

    ;; ---- insert -----------------------------------------------------
    ;; Cormen, as in btree.cicili: split a full child BEFORE descending.
    ;;
    ;; `at' names a child of `parent', and `klevel' is THAT CHILD's level --
    ;; the parent is internal by construction, so it is never 0 for the parent.
    ;; When klevel is 0 the child being split is a leaf: it allocates a leaf
    ;; for its other half and has no children to hand over.
    (func (<> split btree k v t) (((<> btnode k v t) ref parent) (size_t at) (size_t klevel))
          (let (((<> bthead k v t) ref full . #'(nth at (-> parent kids)))
                ((<> bthead k v t) ref ph   . #'(aof (-> parent head))))
            ;; the half is the same kind as the node being split, and both
            ;; constructors answer a head, so this is one expression
            (let (((<> bthead k v t) ref half . #'(? (== klevel 0)
                                                    ((<> newleaf btree k v t))
                                                    ((<> newnode btree k v t)))))
              (set (-> half n) (- t 1))
              (memcpy (-> half items) (+ (-> full items) t)
                      (* (- t 1) (sizeof (<> pair k v))))
              ;; the upper t children go across only if the child HAS children
              (when (> klevel 0)
                (let (((<> btnode k v t) ref fin . #'(cast ((<> btnode k v t) *) full))
                      ((<> btnode k v t) ref hin . #'(cast ((<> btnode k v t) *) half)))
                  (memcpy (-> hin kids) (+ (-> fin kids) t)
                          (* t (sizeof ((<> bthead k v t) *))))))
              (set (-> full n) (- t 1))
              ;; open a slot in the parent for the promoted pair and its new child
              (memmove (+ (-> parent kids) (+ at 2)) (+ (-> parent kids) (+ at 1))
                       (* (- (-> ph n) at) (sizeof ((<> bthead k v t) *))))
              (let (((<> bthead k v t) ** kslot . #'(+ (-> parent kids) (+ at 1))))
                (set (cof kslot) half))
              (memmove (+ (-> ph items) (+ at 1)) (+ (-> ph items) at)
                       (* (- (-> ph n) at) (sizeof (<> pair k v))))
              (let (((<> pair k v) ref up  . #'(+ (-> ph items) at))
                    ((<> pair k v) ref mid . #'(+ (-> full items) (- t 1))))
                (set (cof up) (cof mid)))
              (set (-> ph n) (+ (-> ph n) 1)))))

    (func (<> insertNonfull btree k v t) (((<> bthead k v t) ref h) (size_t level)
                                           (k key) (v val))
          (out bool)                          ; false when the key is already there
          (let ((size_t i . 0))
            (while (and (< i (-> h n)) (< ($ (nth i (-> h items)) key) key))
              (++ i))
            (when (and (< i (-> h n)) (== ($ (nth i (-> h items)) key) key))
              (return #f))
            (when (== level 0)
              (block
                (when (< i (-> h n))
                  (memmove (+ (-> h items) (+ i 1)) (+ (-> h items) i)
                           (* (- (-> h n) i) (sizeof (<> pair k v)))))
                (let (((<> pair k v) ref slot . #'(+ (-> h items) i)))
                  (set (-> slot key) key
                       (-> slot val) val))
                (set (-> h n) (+ (-> h n) 1))
                (return #t)))
            (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
              (let (((<> bthead k v t) ref child . #'(nth i (-> in kids))))
                (when (== (-> child n) (- (* 2 t) 1))
                  (block
                    ((<> split btree k v t) in i (- level 1))
                    ;; the promoted pair now sits at i -- it may BE the key
                    (when (== ($ (nth i (-> h items)) key) key)
                      (return #f))
                    (when (< ($ (nth i (-> h items)) key) key)
                      (++ i)))))
              (return ((<> insertNonfull btree k v t) (nth i (-> in kids)) (- level 1)
                       key val)))
            (return #f)))

    (func (<> insert btree k v t) (((<> btree k v t) ref tree) (k key) (v val))
          (out (<> Either BTREE_ERR size_t))
          (when (not (-> tree root))
            (set (-> tree root) ((<> newleaf btree k v t))
                 (-> tree height) 0))
          ;; a full root is split first, and that is the ONLY way the tree gets
          ;; taller -- and the only place `height' ever goes up
          (when (== (-> (-> tree root) n) (- (* 2 t) 1))
            (let (((<> bthead k v t) ref fh . #'((<> newnode btree k v t))))
              (let (((<> btnode k v t) ref fresh . #'(cast ((<> btnode k v t) *) fh)))
                (let (((<> bthead k v t) ** kslot . #'(+ (-> fresh kids) 0)))
                  (set (cof kslot) (-> tree root)))
                ((<> split btree k v t) fresh 0 (-> tree height)))
              (set (-> tree root) fh
                   (-> tree height) (+ (-> tree height) 1))))
          (when (not ((<> insertNonfull btree k v t) (-> tree root) (-> tree height) key val))
            (return (left BT_DUPLICATE_KEY)))
          (set (-> tree len) (+ (-> tree len) 1))
          (return (right (-> tree len))))

    ;; ---- delete -----------------------------------------------------
    ;; `klevel' is again the level of the CHILDREN being worked on, and the
    ;; kids half of each move is skipped when it is 0.

    ;; kids[at] swallows items[at] and all of kids[at+1]
    (func (<> merge btree k v t) (((<> btnode k v t) ref parent) (size_t at) (size_t klevel))
          (let (((<> bthead k v t) ref ph    . #'(aof (-> parent head)))
                ((<> bthead k v t) ref left  . #'(nth at (-> parent kids)))
                ((<> bthead k v t) ref right . #'(nth (+ at 1) (-> parent kids))))
            (let (((<> pair k v) ref down . #'(+ (-> left items) (- t 1)))
                  ((<> pair k v) ref sep  . #'(+ (-> ph items) at)))
              (set (cof down) (cof sep)))
            (memcpy (+ (-> left items) t) (-> right items)
                    (* (-> right n) (sizeof (<> pair k v))))
            (when (> klevel 0)
              (let (((<> btnode k v t) ref lin . #'(cast ((<> btnode k v t) *) left))
                    ((<> btnode k v t) ref rin . #'(cast ((<> btnode k v t) *) right)))
                (memcpy (+ (-> lin kids) t) (-> rin kids)
                        (* (+ (-> right n) 1) (sizeof ((<> bthead k v t) *))))))
            (set (-> left n) (+ t (-> right n)))
            ;; close the gap the separator and the right child left behind
            (memmove (+ (-> ph items) at) (+ (-> ph items) (+ at 1))
                     (* (- (- (-> ph n) at) 1) (sizeof (<> pair k v))))
            (memmove (+ (-> parent kids) (+ at 1)) (+ (-> parent kids) (+ at 2))
                     (* (- (- (-> ph n) at) 1) (sizeof ((<> bthead k v t) *))))
            (set (-> ph n) (- (-> ph n) 1))
            (syslog! (printf "FREE BTNODE: %p\n" right))
            (free right)))

    (func (<> borrowLeft btree k v t) (((<> btnode k v t) ref parent) (size_t at) (size_t klevel))
          (let (((<> bthead k v t) ref ph    . #'(aof (-> parent head)))
                ((<> bthead k v t) ref child . #'(nth at (-> parent kids)))
                ((<> bthead k v t) ref sib   . #'(nth (- at 1) (-> parent kids))))
            (memmove (+ (-> child items) 1) (-> child items)
                     (* (-> child n) (sizeof (<> pair k v))))
            (when (> klevel 0)
              (let (((<> btnode k v t) ref cin . #'(cast ((<> btnode k v t) *) child)))
                (memmove (+ (-> cin kids) 1) (-> cin kids)
                         (* (+ (-> child n) 1) (sizeof ((<> bthead k v t) *))))))
            ;; the separator comes down into the child, the sibling's last pair
            ;; goes up to replace it
            (let (((<> pair k v) ref head . #'(+ (-> child items) 0))
                  ((<> pair k v) ref sep  . #'(+ (-> ph items) (- at 1))))
              (set (cof head) (cof sep)))
            (when (> klevel 0)
              (let (((<> btnode k v t) ref cin . #'(cast ((<> btnode k v t) *) child))
                    ((<> btnode k v t) ref sin . #'(cast ((<> btnode k v t) *) sib)))
                (let (((<> bthead k v t) ** kslot . #'(+ (-> cin kids) 0)))
                  (set (cof kslot) (nth (-> sib n) (-> sin kids))))))
            (let (((<> pair k v) ref sep  . #'(+ (-> ph items) (- at 1)))
                  ((<> pair k v) ref tail . #'(+ (-> sib items) (- (-> sib n) 1))))
              (set (cof sep) (cof tail)))
            (set (-> child n) (+ (-> child n) 1)
                 (-> sib n)   (- (-> sib n) 1))))

    (func (<> borrowRight btree k v t) (((<> btnode k v t) ref parent) (size_t at) (size_t klevel))
          (let (((<> bthead k v t) ref ph    . #'(aof (-> parent head)))
                ((<> bthead k v t) ref child . #'(nth at (-> parent kids)))
                ((<> bthead k v t) ref sib   . #'(nth (+ at 1) (-> parent kids))))
            (let (((<> pair k v) ref tail . #'(+ (-> child items) (-> child n)))
                  ((<> pair k v) ref sep  . #'(+ (-> ph items) at)))
              (set (cof tail) (cof sep)))
            (when (> klevel 0)
              (let (((<> btnode k v t) ref cin . #'(cast ((<> btnode k v t) *) child))
                    ((<> btnode k v t) ref sin . #'(cast ((<> btnode k v t) *) sib)))
                (let (((<> bthead k v t) ** kslot . #'(+ (-> cin kids) (+ (-> child n) 1))))
                  (set (cof kslot) (nth 0 (-> sin kids))))))
            (let (((<> pair k v) ref sep  . #'(+ (-> ph items) at))
                  ((<> pair k v) ref head . #'(+ (-> sib items) 0)))
              (set (cof sep) (cof head)))
            (memmove (-> sib items) (+ (-> sib items) 1)
                     (* (- (-> sib n) 1) (sizeof (<> pair k v))))
            (when (> klevel 0)
              (let (((<> btnode k v t) ref sin . #'(cast ((<> btnode k v t) *) sib)))
                (memmove (-> sin kids) (+ (-> sin kids) 1)
                         (* (-> sib n) (sizeof ((<> bthead k v t) *))))))
            (set (-> child n) (+ (-> child n) 1)
                 (-> sib n)   (- (-> sib n) 1))))

    ;; top kids[at] up to at least t pairs, and answer where it ended up -- a
    ;; merge with the LEFT sibling moves it back one slot
    (func (<> fill btree k v t) (((<> btnode k v t) ref parent) (size_t at) (size_t klevel))
          (out size_t)
          (let (((<> bthead k v t) ref ph . #'(aof (-> parent head))))
            (when (> at 0)
              (let (((<> bthead k v t) ref lsib . #'(nth (- at 1) (-> parent kids))))
                (when (>= (-> lsib n) t)
                  (block ((<> borrowLeft btree k v t) parent at klevel)
                         (return at)))))
            (when (< at (-> ph n))
              (let (((<> bthead k v t) ref rsib . #'(nth (+ at 1) (-> parent kids))))
                (when (>= (-> rsib n) t)
                  (block ((<> borrowRight btree k v t) parent at klevel)
                         (return at)))))
            (if (< at (-> ph n))
                (block ((<> merge btree k v t) parent at klevel)
                       (return at))
              (block ((<> merge btree k v t) parent (- at 1) klevel)
                     (return (- at 1))))))

    (func (<> del btree k v t) (((<> bthead k v t) ref h) (size_t level) (k key))
          (out bool)                          ; false when the key was not there
          (let ((size_t i . 0))
            (while (and (< i (-> h n)) (< ($ (nth i (-> h items)) key) key))
              (++ i))

            ;; ---- the key is in THIS node
            (when (and (< i (-> h n)) (== ($ (nth i (-> h items)) key) key))
              (block
                (when (== level 0)
                  (block
                    (memmove (+ (-> h items) i) (+ (-> h items) (+ i 1))
                             (* (- (- (-> h n) i) 1) (sizeof (<> pair k v))))
                    (set (-> h n) (- (-> h n) 1))
                    (return #t)))
                ;; internal: swap in a neighbour that CAN spare a pair, then
                ;; delete that neighbour instead. It is one level closer to a
                ;; leaf each time, so this terminates.
                (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
                  (let (((<> bthead k v t) ref lkid . #'(nth i (-> in kids))))
                    (when (>= (-> lkid n) t)
                    (let (((<> bthead k v t) ref cur . #'(nth i (-> in kids)))
                          (size_t cl . #'(- level 1)))
                      (while (> cl 0)
                        (let (((<> btnode k v t) ref cin . #'(cast ((<> btnode k v t) *) cur)))
                          (set cur (nth (-> cur n) (-> cin kids))
                               cl (- cl 1))))
                      (let (((<> pair k v) pred . #'(nth (- (-> cur n) 1) (-> cur items))))
                        (let (((<> pair k v) ref slot . #'(+ (-> h items) i)))
                          (set (cof slot) pred))
                        (return ((<> del btree k v t) (nth i (-> in kids)) (- level 1)
                                 ($ pred key)))))))
                  (let (((<> bthead k v t) ref rkid . #'(nth (+ i 1) (-> in kids))))
                    (when (>= (-> rkid n) t)
                    (let (((<> bthead k v t) ref cur . #'(nth (+ i 1) (-> in kids)))
                          (size_t cl . #'(- level 1)))
                      (while (> cl 0)
                        (let (((<> btnode k v t) ref cin . #'(cast ((<> btnode k v t) *) cur)))
                          (set cur (nth 0 (-> cin kids))
                               cl (- cl 1))))
                      (let (((<> pair k v) succ . #'(nth 0 (-> cur items))))
                        (let (((<> pair k v) ref slot . #'(+ (-> h items) i)))
                          (set (cof slot) succ))
                        (return ((<> del btree k v t) (nth (+ i 1) (-> in kids)) (- level 1)
                                 ($ succ key)))))))
                  ;; neither neighbour can spare one: merge and look again below
                  ((<> merge btree k v t) in i (- level 1))
                  (return ((<> del btree k v t) (nth i (-> in kids)) (- level 1) key)))))

            ;; ---- not here
            (when (== level 0) (return #f))
            (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) h)))
              (let (((<> bthead k v t) ref kid . #'(nth i (-> in kids))))
                (when (< (-> kid n) t)
                  (set i ((<> fill btree k v t) in i (- level 1)))))
              (return ((<> del btree k v t) (nth i (-> in kids)) (- level 1) key)))
            (return #f)))

    (func (<> delete btree k v t) (((<> btree k v t) ref tree) (k key))
          (out (<> Either BTREE_ERR size_t))
          (when (not (-> tree root))
            (return (left BT_NOT_FOUND)))
          (when (not ((<> del btree k v t) (-> tree root) (-> tree height) key))
            (return (left BT_NOT_FOUND)))
          ;; a merge can empty the root, and dropping it is the only way the
          ;; tree ever gets shorter -- and the only place `height' goes down
          (when (== (-> (-> tree root) n) 0)
            (let (((<> bthead k v t) ref old . #'(-> tree root)))
              (if (== (-> tree height) 0)
                  (set (-> tree root) nil)
                (let (((<> btnode k v t) ref in . #'(cast ((<> btnode k v t) *) old)))
                  (set (-> tree root) (nth 0 (-> in kids))
                       (-> tree height) (- (-> tree height) 1))))
              (syslog! (printf "FREE BTNODE: %p\n" old))
              (free old)))
          (set (-> tree len) (- (-> tree len) 1))
          (return (right (-> tree len))))

    ) ; guard

  ) ; impl-btree


;;;; ------------------------------------------------------------------
;;;; front ends: infer which instantiation the tree belongs to and dispatch.
;;;; An owned tree is passed by address, one already held by reference as is.
;;;; ------------------------------------------------------------------

(DEFUN btree-call< (tree)
  (MULTIPLE-VALUE-BIND (desc full-type root-type) (CICILI:TYPE-CHECK tree :TYPEOF :std_btree
                                                                          :MODIFIER '(move ref nil))
    (DECLARE (IGNORE desc))
    (VALUES (CAR root-type)
            (IF (CICILI:KEY-EQ (NTH 2 full-type) 'ref) tree `(aof ,tree)))))

(DEFMACRO free_btree (tree)
  (LET ((tree tree))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> free ,type-name) ,self))))

(DEFMACRO len_btree (tree)
  (LET ((tree tree))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> len ,type-name) ,self))))

(DEFMACRO height_btree (tree)
  (LET ((tree tree))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> height ,type-name) ,self))))

(DEFMACRO balanced_btree (tree)
  (LET ((tree tree))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> balanced ,type-name) ,self))))

(DEFMACRO search_btree (tree key)
  (LET ((tree tree) (key key))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> search ,type-name) ,self ,key))))

(DEFMACRO insert_btree (tree key val)
  (LET ((tree tree) (key key) (val val))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> insert ,type-name) ,self ,key ,val))))

(DEFMACRO delete_btree (tree key)
  (LET ((tree tree) (key key))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> delete ,type-name) ,self ,key))))

(DEFMACRO min_btree (tree)
  (LET ((tree tree))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> min ,type-name) ,self))))

(DEFMACRO max_btree (tree)
  (LET ((tree tree))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> max ,type-name) ,self))))

(DEFMACRO traverse_btree (tree callback)
  (LET ((tree tree) (callback callback))
    (MULTIPLE-VALUE-BIND (type-name self) (btree-call< tree)
      `((<> traverse ,type-name) ,self ,callback))))
