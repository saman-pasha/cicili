;;;; Cicili std prelude
;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :std)


;;; C standard library and POSIX declarations for type inference.
;;; These carry FILE, the standard streams, malloc/calloc/free, memcpy/memset,
;;; printf/fprintf and the rest of C17 + POSIX. Nothing in them emits C --
;;; see ./c/README.md. They must be imported before the std modules below,
;;; which use malloc/free/memcpy at specification time.
(import "./c/c.cicili")
(import "./c/posix.cicili")

(import "./maybe.cicili")
(import "./either.cicili")
(import "./array.cicili")
(import "./cell.cicili")
(import "./rc.cicili")
(import "./vector.cicili")

;;; A vector of char under a second name -- see the file. It comes after
;;; vector because it IS one.
(import "./string.cicili")

(import "./btree.cicili")

;;; The algebraic layer: `data' and `class' and the types built on them --
;;; Maybe, Either, Bool, List, String, Rc -- plus the pattern matching, the
;;; functor/applicative/monad instances and the lambda calculus forms.
;;;
;;; LAST, and that is not arbitrary. It reads the C declarations above at
;;; specification time the way the rest of std does, and `match' has to be in
;;; place before anything can be matched with it.
;;;
;;; It is imported here rather than being an optional layer because these are
;;; Cicili's own facilities, not an alternative to them: the `data' machinery is
;;; what lib/std/haskell/persistent-btree.cicili is written in, and until this
;;; line existed nothing could compile that file at all.
;;;
;;; The two names that look duplicated are not. `Maybe' is the ADT and `maybe'
;;; the tagged union above; case tells them apart under the :preserve readtable,
;;; and `match' answers for both -- see builtins.cicili, which dispatches on
;;; whether the scrutinee registered itself with def-matchable.
(import "./haskell/prelude.cicili")


(DEFMACRO init-macro ()
  `($$$
     ;; Cicili primitive types
     (decl) (struct char)
     (decl) (struct uchar)
     (decl) (struct short)
     (decl) (struct ushort)
     (decl) (struct int)
     (decl) (struct uint)
     (decl) (struct long)
     (decl) (struct ulong)
     (decl) (struct llong)
     (decl) (struct ullong)
     (decl) (struct i8)
     (decl) (struct u8)
     (decl) (struct i16)
     (decl) (struct u16)
     (decl) (struct i32)
     (decl) (struct u32)
     (decl) (struct i64)
     (decl) (struct u64)
     (decl) (struct i128)
     (decl) (struct u128)
     (decl) (struct float)
     (decl) (struct double)
     (decl) (struct real)
     (decl) (struct auto)
     (decl) (struct bool)
     (decl) (struct true)
     (decl) (struct false)
    )
  ) ; init-macro
