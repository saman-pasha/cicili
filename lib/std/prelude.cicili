;;;; Cicili std prelude

;;; C standard library and POSIX declarations for type inference.
;;; These carry FILE, the standard streams, malloc/calloc/free, memcpy/memset,
;;; printf/fprintf and the rest of C17 + POSIX. Nothing in them emits C --
;;; see ./c/README.md. They must be imported before the std modules below,
;;; which use malloc/free/memcpy at specification time.
(import "./c/c.cicili")
(import "./c/posix.cicili")

(import "./array.cicili")
(import "./cell.cicili")
(import "./rc.cicili")
(import "./vector.cicili")


(DEFMACRO init-macro ()
  `($$$
     ;; Cicili primitive types
     (decl) (struct char)
     (decl) (struct uchar)
     (decl) (struct short)
     (decl) (struct ushort)
     (decl) (struct int)
     (decl) (struct uint)
     (decl) (struct long)
     (decl) (struct ulong)
     (decl) (struct llong)
     (decl) (struct ullong)
     (decl) (struct i8)
     (decl) (struct u8)
     (decl) (struct i16)
     (decl) (struct u16)
     (decl) (struct i32)
     (decl) (struct u32)
     (decl) (struct i64)
     (decl) (struct u64)
     (decl) (struct i128)
     (decl) (struct u128)
     (decl) (struct float)
     (decl) (struct double)
     (decl) (struct real)
     (decl) (struct auto)
    )
  ) ; init-macro
