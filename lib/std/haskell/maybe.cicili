;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"
                                  "find-subseq" "expand-form<"))

(IN-PACKAGE :std)


(generic decl-Maybe
  (a)
  
  ;; uses this definition in c header
  ;; data Maybe = Nothing | Just a         
  (decl-data (Maybe (<> Maybe a))
    (= Just    (<> Just a) (a value))
    (= Nothing (<> Nothing a)))
  
  ) ; decl-Maybe

(generic impl-Maybe
  (a)
  
  ;; define inside c.cicili
  (impl-data (Maybe (<> Maybe a))
    (= Just    (<> Just a) (a value))
    (= Nothing (<> Nothing a)))
  
  ) ; impl-Maybe

(generic import-Maybe
  (a)

  ) ; import-Maybe
