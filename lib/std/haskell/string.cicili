;;; This file is part of the :std library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :std
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"
                                  "find-subseq" "expand-form<"))

(IN-PACKAGE :std)


(generic decl-String
  (type a)

  (decl-List type a)

  (decl) (func (<> new type Const) ((const a * buf)) (out type))

  ) ; decl-String

(generic impl-String
  (type a fmt sep)

  (impl-List type a fmt sep)

  (func (<> new type Const) ((const a * buf))
        (out type)
        (if (null buf)
            (return ((<> Nil a)))
            (let ((a item . #'(cof buf)))
              (if (== item #\Null)
                  (return ((<> Nil a)))
                  (return ((<> Cons a) item ((<> new type Const) (++ buf))))))))

  ) ; impl-String

(generic import-String
  (type a ctor)

  (import-List type a ctor)

  (DEFMACRO ctor (buf &OPTIONAL len)
    (LET ((len len))
      (IF len
          `((<> pure type) ,buf ,len)
          (IF (AND (LISTP buf) (CICILI:KEY-EQ (CAR buf) 'QUOTE))
              `((<> pure type) (cast (const a []) ,buf) ,(LENGTH (CADR buf)))
              (IF (STRINGP buf)
                  `((<> new type Const) ,buf)
                  (ERROR (FORMAT NIL "new_String len required for dynamic array input: ~A" buf)))))))

  ) ; import-String
