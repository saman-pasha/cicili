;;;; Cicili declarations for libtorch -- torch::optim
;;;;
;;;; Requires in target: (include <torch/torch.h>) and a C++ target (:cpp #t).
;;;; Nothing here emits C++. See tensor.cicili for what that means.
;;;;
;;;; An optimiser owns the training step, and the shape of the loop it belongs
;;;; to is the same for all of them:
;;;;
;;;;   (($ opt zero_grad))
;;;;   (letin* ((loss (torch::mse_loss out target)))
;;;;     (($ loss backward))
;;;;     (($ opt step)))
;;; This file is part of the :torch library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :torch
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :torch)


(DEFMACRO init-macro ()
  `($$$

     (decl) (struct torch::optim::Optimizer
              (method step      ())
              (method zero_grad ())
              (method param_groups () (out (t<> std::vector torch::optim::OptimizerParamGroup) &)))

     ;;; constructed from a module's parameters and a learning rate:
     ;;;   (letin* ((opt (torch::optim::SGD (($ net parameters)) 0.1)))
     (decl) (struct torch::optim::SGD (inherits torch::optim::Optimizer)
              (method step      ())
              (method zero_grad ()))

     (decl) (struct torch::optim::Adam (inherits torch::optim::Optimizer)
              (method step      ())
              (method zero_grad ()))

     (decl) (struct torch::optim::AdamW (inherits torch::optim::Optimizer)
              (method step      ())
              (method zero_grad ()))

     ;;; ---- learning-rate schedules ---------------------------------
     ;;; A scheduler holds a REFERENCE to the optimiser and changes its learning
     ;;; rate when stepped. It must therefore not outlive the optimiser, and it
     ;;; is stepped once per EPOCH -- stepping it per batch is the classic way
     ;;; to decay a learning rate to nothing in one pass.
     (decl) (struct torch::optim::StepLR
              (method step ()))

     ;;; the options each takes. Declared opaque: they are built with libtorch's
     ;;; own chained setters, which are member functions returning *this and are
     ;;; reached through the object rather than declared one by one here.
     (decl) (struct torch::optim::SGDOptions)
     (decl) (struct torch::optim::AdamOptions)

     ;;; the learning-rate schedule by hand: every group's options carry the lr
     (decl) (struct torch::optim::OptimizerOptions
              (const) (method get_lr () (out double))
              (method set_lr ((double lr))))
     (decl) (struct torch::optim::OptimizerParamGroup
              (method options () (out torch::optim::OptimizerOptions &)))
     (decl) (struct (t<> std::vector torch::optim::OptimizerParamGroup)
              (const) (method size () (out size_t))
              (method at ((size_t i)) (out torch::optim::OptimizerParamGroup &)))
     (decl) (struct (t<> std::unique_ptr torch::optim::Optimizer)
              (method reset ((torch::optim::Optimizer * p)))
              (const) (method get () (out torch::optim::Optimizer *)))

     ))
