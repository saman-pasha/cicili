;;;; Cicili declarations for the CPython C API -- the embedding subset
;;;;
;;;; Requires in target: (include <Python.h>) FIRST, before any other header --
;;;; CPython says so, and it is not a style preference: Python.h defines feature
;;;; macros that change what the system headers declare.
;;;;
;;;; NOTHING HERE EMITS C. These declarations exist so Cicili's type inference
;;;; knows what a PyObject is. The real ones come from the real header, exactly
;;;; as with lib/std/c and lib/cpp/torch.
;;;;
;;;; WHY THIS FILE EXISTS AT ALL. It is here because numpy's C API needs it:
;;;; there is no way to make a numpy array without a running interpreter, so
;;;; anything that touches numpy from C is either an extension module Python
;;;; loads, or a program that starts Python itself. Both need this.
;;;;
;;;; REFERENCE COUNTING IS YOURS. Py_DECREF and Py_INCREF are macros that
;;;; cannot be declared here, so the FUNCTIONS Py_DecRef and Py_IncRef are
;;;; declared instead -- CPython provides both spellings and the function form
;;;; is the one another language can call. Every function below is marked with
;;;; what it does to the count, because getting that wrong is a leak or a crash
;;;; and the header will not tell you:
;;;;
;;;;   NEW      you own it and must Py_DecRef it
;;;;   BORROWED you must NOT decref it; it dies with its owner
;;;;   STEALS   the callee takes your reference; do not decref it yourself
;;; This file is part of the :python library and shares its package. A library
;;; owns its namespace instead of borrowing the import prefix's; the full
;;; explanation is in doc/DOC-C.md, under "A library's package".
(DEFPACKAGE :python
  (:USE :COMMON-LISP)
  (:IMPORT-FROM :COMMON-LISP-USER "import" "generic" "cicili"))

(IN-PACKAGE :python)


;;; ------------------------------------------------------------------
;;; (python-support) -- emit the two functions that make letin* work
;;; ------------------------------------------------------------------
;;;
;;; Write it once, at target level. It defines two static functions and nothing
;;; else, and they exist because a letin* destructor has to be a NAMED FUNCTION
;;; taking the address of what it destroys -- that is what
;;; __attribute__((cleanup)) passes it. See lib/std/builtins for letin*.
;;;
;;; With them, an interpreter and every reference are scoped:
;;;
;;;     (python-support)
;;;
;;;     (main
;;;       (letin* ((py (py_open) py_finalize))          ; Py_Finalize at exit
;;;         (when (< py 0) (block (PyErr_Print) (return 1)))   ; -- even here
;;;         (letin* ((a (PyArray_SimpleNew …) py_decref))      ; Py_DecRef at exit
;;;           …)))
;;;
;;; THE EARLY RETURN IS THE POINT. Written by hand, the import-failed path
;;; leaves the interpreter running, and every `return' added later has to
;;; remember the decrefs above it. This is the same reason `letin' exists on
;;; the C side, applied to the API where getting it wrong is most common.
;;;
;;; py_open answers what _import_array answered: < 0 means numpy is not usable
;;; and an exception is set. Py_Finalize still runs.
;;; An EXTENSION MODULE starts no interpreter -- one is already running -- so
;;; it wants only the reference helper. Write (python-refs) there and
;;; (python-support) here; writing both defines py_decref twice.
(DEFMACRO python-refs ()
  `($$$
     (static) (func py_decref ((PyObject ** o))
                    (when (cof o) (Py_DecRef (cof o))))))

(DEFMACRO python-support ()
  `($$$
     (static) (func py_open () (out int)
                    (Py_Initialize)
                    (return (_import_array)))
     ;; the parameter is the ADDRESS of the variable, which is what cleanup
     ;; passes; its value is not needed, only the fact that the scope ended
     (static) (func py_finalize ((int * unused))
                    (cast void unused)
                    (Py_Finalize))
     (python-refs)))

(DEFMACRO init-macro ()
  `($$$

     ;;; ---- the object -----------------------------------------------
     (decl) (struct PyObject)
     ;;; Py_None is a macro for the address of a static object, so it is
     ;;; declared the way a global is -- see lib/std/c/stdio.cicili and
     ;;; `stdout'. It is a singleton: never decref it, never compare against
     ;;; it with anything but ==.
     (typedef PyObject * Py_None)
     (typedef PyObject * Py_True)
     (typedef PyObject * Py_False)

     ;;; ---- interpreter lifetime ------------------------------------
     (decl) (func Py_Initialize   ())
     (decl) (func Py_Finalize     ())
     (decl) (func Py_IsInitialized () (out int))
     ;; 0 on success, non-zero if the interpreter could not shut down cleanly
     (decl) (func Py_FinalizeEx   () (out int))

     ;;; ---- errors ---------------------------------------------------
     ;; PyErr_Occurred answers a BORROWED reference, or nil when nothing failed.
     ;; Check it after anything that can fail and before using what came back.
     ;;
     ;; THE RULE: a function that answers a pointer signals failure with nil,
     ;; and one that answers an int signals it with -1. Either way an exception
     ;; is left set, and leaving it set across the next call makes the next
     ;; failure look like this one. Print it or clear it.
     (decl) (func PyErr_Occurred   () (out PyObject *))                     ; BORROWED
     (decl) (func PyErr_Print      ())
     (decl) (func PyErr_Clear      ())
     ;; raise. Answers nil always, so it tail-calls out of a failing function.
     (decl) (func PyErr_SetString  ((PyObject * type) (const char * msg)))
     ;; the built-in exception types, declared the way globals are
     (typedef PyObject * PyExc_RuntimeError)
     (typedef PyObject * PyExc_ValueError)
     (typedef PyObject * PyExc_TypeError)
     (typedef PyObject * PyExc_IndexError)
     (typedef PyObject * PyExc_MemoryError)

     ;;; ---- reference counting ---------------------------------------
     ;; the function spellings of Py_DECREF / Py_INCREF. Both tolerate nil.
     (decl) (func Py_DecRef ((PyObject * o)))
     (decl) (func Py_IncRef ((PyObject * o)))

     ;;; ---- running code ---------------------------------------------
     ;; 0 on success, -1 on an exception (which it prints)
     (decl) (func PyRun_SimpleString ((const char * code)) (out int))

     ;;; ---- modules and attributes -----------------------------------
     (decl) (func PyImport_ImportModule    ((const char * name)) (out PyObject *))   ; NEW
     (decl) (func PyObject_GetAttrString   ((PyObject * o) (const char * name))
                  (out PyObject *))                                                  ; NEW
     (decl) (func PyObject_SetAttrString   ((PyObject * o) (const char * name) (PyObject * v))
                  (out int))
     (decl) (func PyObject_HasAttrString   ((PyObject * o) (const char * name)) (out int))
     ;; the already-imported module, without importing it. "__main__" is the
     ;; one PyRun_SimpleString runs in, so this is how you read back what a
     ;; snippet of Python left behind.
     (decl) (func PyImport_AddModule ((const char * name)) (out PyObject *))          ; BORROWED
     (decl) (func PyModule_GetDict   ((PyObject * m))      (out PyObject *))          ; BORROWED

     ;;; ---- calling --------------------------------------------------
     ;; args must be a tuple, or nil for no arguments
     (decl) (func PyObject_CallObject ((PyObject * callable) (PyObject * args))
                  (out PyObject *))                                                  ; NEW
     ;; with keywords: args is a tuple (never nil here), kwargs a dict or nil
     (decl) (func PyObject_Call ((PyObject * callable) (PyObject * args)
                                 (PyObject * kwargs))
                  (out PyObject *))                                                  ; NEW
     (decl) (func PyObject_CallNoArgs ((PyObject * callable)) (out PyObject *))       ; NEW
     (decl) (func PyCallable_Check    ((PyObject * o)) (out int))

     ;;; ---- tuples ---------------------------------------------------
     (decl) (func PyTuple_New     ((ssize_t n))                        (out PyObject *)) ; NEW
     ;; STEALS the reference to `v'. This is the classic CPython trap: passing
     ;; something you then decref yourself is a double free.
     (decl) (func PyTuple_SetItem ((PyObject * t) (ssize_t i) (PyObject * v)) (out int))
     (decl) (func PyTuple_GetItem ((PyObject * t) (ssize_t i))         (out PyObject *)) ; BORROWED
     (decl) (func PyTuple_Size    ((PyObject * t))                     (out ssize_t))

     ;;; ---- lists ----------------------------------------------------
     ;; SetItem steals like the tuple one; Append does NOT -- it increfs. The
     ;; two sit next to each other and behave differently, which is the second
     ;; classic trap after PyTuple_SetItem.
     (decl) (func PyList_New     ((ssize_t n))                        (out PyObject *)) ; NEW
     (decl) (func PyList_SetItem ((PyObject * l) (ssize_t i) (PyObject * v)) (out int)) ; STEALS v
     (decl) (func PyList_GetItem ((PyObject * l) (ssize_t i))         (out PyObject *)) ; BORROWED
     (decl) (func PyList_Append  ((PyObject * l) (PyObject * v))      (out int))
     (decl) (func PyList_Size    ((PyObject * l))                     (out ssize_t))

     ;;; ---- dicts ----------------------------------------------------
     ;; these steal nothing, unlike the sequence setters
     (decl) (func PyDict_New           ()                             (out PyObject *)) ; NEW
     (decl) (func PyDict_SetItem       ((PyObject * d) (PyObject * k) (PyObject * v))
                  (out int))
     (decl) (func PyDict_GetItem       ((PyObject * d) (PyObject * k))
                  (out PyObject *))                                                  ; BORROWED
     (decl) (func PyDict_SetItemString ((PyObject * d) (const char * k) (PyObject * v))
                  (out int))
     (decl) (func PyDict_GetItemString ((PyObject * d) (const char * k))
                  (out PyObject *))                                                  ; BORROWED
     (decl) (func PyDict_Size          ((PyObject * d))               (out ssize_t))

     ;;; ---- indexing -------------------------------------------------
     ;; what a[…] compiles to. The key is an object, so an integer index needs
     ;; PyLong_FromLong and a slice needs PySlice_New -- which is how a numpy
     ;; view is taken from C.
     (decl) (func PyObject_GetItem ((PyObject * o) (PyObject * key)) (out PyObject *)) ; NEW
     (decl) (func PyObject_SetItem ((PyObject * o) (PyObject * key) (PyObject * v))
                  (out int))
     (decl) (func PyObject_DelItem ((PyObject * o) (PyObject * key)) (out int))
     ;; any of the three may be nil, meaning the open end
     (decl) (func PySlice_New ((PyObject * start) (PyObject * stop) (PyObject * step))
                  (out PyObject *))                                                  ; NEW
     (decl) (func PyObject_Length ((PyObject * o)) (out ssize_t))

     ;;; ---- arithmetic -----------------------------------------------
     ;; the operators, as functions. On numpy arrays these ARE the ufuncs, so
     ;; this is how element-wise work is done from C without calling back
     ;; through the module. Every one answers a new array.
     (decl) (func PyNumber_Add            ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_Subtract       ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_Multiply       ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_TrueDivide     ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_FloorDivide    ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_Remainder      ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     ;; the third argument is the modulus of pow(a, b, m); pass Py_None
     (decl) (func PyNumber_Power          ((PyObject * a) (PyObject * b) (PyObject * m))
                  (out PyObject *))                                                       ; NEW
     ;; the @ operator -- matrix multiply
     (decl) (func PyNumber_MatrixMultiply ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_Negative       ((PyObject * a))                (out PyObject *)) ; NEW
     (decl) (func PyNumber_Absolute       ((PyObject * a))                (out PyObject *)) ; NEW
     ;; the in-place forms. For an array they write into `a' and answer it
     ;; increfed -- a SECOND reference you must also decref, which is the
     ;; thing that looks like it cannot leak and does.
     (decl) (func PyNumber_InPlaceAdd      ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_InPlaceSubtract ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_InPlaceMultiply ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW
     (decl) (func PyNumber_InPlaceTrueDivide ((PyObject * a) (PyObject * b)) (out PyObject *)) ; NEW

     ;;; ---- comparing ------------------------------------------------
     ;; RichCompare on two arrays answers an ARRAY of booleans, not a bool --
     ;; the same trap as writing `if a == b' in Python. Use PyObject_RichCompareBool
     ;; only on scalars.
     (decl) (func PyObject_RichCompare     ((PyObject * a) (PyObject * b) (int op))
                  (out PyObject *))                                                  ; NEW
     (decl) (func PyObject_RichCompareBool ((PyObject * a) (PyObject * b) (int op))
                  (out int))
     ;; -1 on error, so check PyErr_Occurred rather than trusting 0
     (decl) (func PyObject_IsTrue ((PyObject * o)) (out int))
     (typedef int Py_LT) (typedef int Py_LE) (typedef int Py_EQ)
     (typedef int Py_NE) (typedef int Py_GT) (typedef int Py_GE)

     ;;; ---- scalars in and out ---------------------------------------
     (decl) (func PyLong_FromLong      ((long v))          (out PyObject *))  ; NEW
     (decl) (func PyLong_AsLong        ((PyObject * o))    (out long))
     (decl) (func PyFloat_FromDouble   ((double v))        (out PyObject *))  ; NEW
     (decl) (func PyFloat_AsDouble     ((PyObject * o))    (out double))
     (decl) (func PyUnicode_FromString ((const char * s))  (out PyObject *))  ; NEW
     ;; the char * points into the string object and dies with it
     (decl) (func PyUnicode_AsUTF8     ((PyObject * o))    (out const char *)); BORROWED
     (decl) (func PyBool_FromLong      ((long v))          (out PyObject *))  ; NEW
     ;; a Python float from anything float-like -- including a numpy scalar or
     ;; a zero-dimensional array, which is what every numpy reduction answers
     (decl) (func PyFloat_Check        ((PyObject * o))    (out int))
     (decl) (func PyLong_Check         ((PyObject * o))    (out int))

     ;;; ---- introspection --------------------------------------------
     (decl) (func PyObject_Str  ((PyObject * o)) (out PyObject *))   ; NEW
     (decl) (func PyObject_Repr ((PyObject * o)) (out PyObject *))   ; NEW

     ))
