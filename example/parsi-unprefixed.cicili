;;;; Importing lib/parsi/parsi.cicili WITHOUT a prefix
;;;;
;;;; Its pair is example/parsi-prefixed.cicili -- the same page, one line
;;;; different:
;;;;
;;;;   (import "lib/parsi/parsi.cicili" :parsi "demo")   ->  (parsi.page …)
;;;;   (import "lib/parsi/parsi.cicili" nil    "site")   ->  (page …)
;;;;
;;;; NIL IS HOW YOU SAY "NAMESPACE, NO PREFIX". The second argument is the
;;;; prefix and the third is the namespace, and they are independent -- so a
;;;; file can have the plain names and still have its objects qualified. Leave
;;;; the third out as well and the page is simply `hello', served at /hello.zt.
;;;;
;;;; This works because the library declares its own package rather than taking
;;;; the one an importer would have made for it, and read-file evaluates that
;;;; DEFPACKAGE as it reads. Without it, an unprefixed import had nowhere to put
;;;; the definitions.
;;;;
;;;; ALL TWELVE WORK THIS WAY, class, type, sequence and enum included. That is
;;;; what the lower-case names buy: while they were upper case those four were
;;;; Common Lisp's and SB-ALIEN's symbols, could only be defined behind a
;;;; :shadow, and could not be reached from a DEFPARAMETER at all -- an object
;;;; is built by a form Common Lisp EVALUATES, and CL:EVAL resolves by symbol
;;;; identity rather than through the name-keyed table a target's forms go
;;;; through. Written `class', none of that applies.
;;;;
;;;; WHAT IT STILL COSTS. The names are registered GLOBALLY: bare, `page',
;;;; `table' and `include' are these macros for every Cicili file compiled in
;;;; the same process -- and `include' is one of Cicili's own clauses. A
;;;; target's own include wins, because specify-target tests for it before it
;;;; reaches the macro table, but that is a detail to know rather than to lean
;;;; on.
;;;;
;;;; So: this form for a file of your own, the prefixed form for anything a
;;;; second library will be imported beside.
;;;;
;;;; MARKUP IS WRITTEN AS FORMS here too, and it is where the case rule earns
;;;; its keep: (title) and (select) are HTML elements while TITLE and SELECT
;;;; are Parsi's, told apart by nothing but case.
;;;;
;;;; Run:
;;;;   sbcl --script cicili.lisp example/parsi-unprefixed.cicili
;;;;   cp example/site_hello.hpp example/site_hello.cpp $ZIGURATIP_HOME/ld/
;;;;   rm -f $ZIGURATIP_HOME/tmp/site_hello.hpp $ZIGURATIP_HOME/tmp/site_hello.cpp
;;;;   parsi example/hello-bare.parsi
;;;; then http://localhost:2190/site/hello.zt

(import "lib/parsi/parsi.cicili" nil "site")

(DEFPARAMETER *hello*
  (page hello
    (PUBLIC)
    (PAGE_LOAD
      ;; MARKUP AS FORMS, and note which words these are: the elements are
      ;; lower case and Parsi's clauses are upper case, which is the whole
      ;; reason (title) and (select) can be elements while TITLE and SELECT
      ;; belong to the language. A macro file is read with the case preserved.
      (ECHO (doctype) (html) (head) (title) "no prefix" (/title) (/head) (body))
      (ECHO (h1) "no prefix" (/h1))

      ;; the escape to Cicili -- lifted into site_hello.cpp and called from here
      (ECHO (p) "from Cicili: " (cicili (+ 20 22)) (/p))

      (ECHO (p) (a :href "/demo/hello.zt") "the prefixed one" (/a) (/p))
      (ECHO (/body) (/html)))))

;;; Named after the page, the same as in the prefixed file: site::hello lifts
;;; into site_hello.hpp and site_hello.cpp.
(header "site_hello.hpp"  (make :cpp #t) (hpp  *hello*))
(source "site_hello.cpp"  (make :cpp #t) (cpp  *hello*))
(header "hello-bare.parsi" (make :cpp #t) (file *hello*))
