(import "lib/std/haskell/stringbuffer.cicili")

(source "stringbuffer.c"
  (make :std #t
        :haskell #t
        :compile #t
        :link #t)

  (decl-StringBuffer char)
  (impl-StringBuffer char)
  
  (decl-StringBuffer int)
  (impl-StringBuffer int)

  (static)
  (func printCharArray ((const char * array))
        (while (cof array)
          (printf " %c" (cof array))
          (++ array)))

  (static)
  (func printIntArray ((const int * array) (int len))
        (let ((int counter . 0))
          (while (< counter len)
            (printf " %d" (nth counter array))
            (++ counter))))
  
  (main
    ;; char
    (let (((<> StringBuffer char) sb . #'((<> new StringBuffer char) 4 #t)))
      (set sb ((<> print StringBuffer char) sb "12345" 5))
      (set sb ((<> print StringBuffer char) sb "54321" 5))
      
      (io sb
        (NullTerminated buffer _cursor size step
                        (block
                          (printf "NullTerminatedBuffer char, size: %d, step %d, %s\n" size step buffer)
                          (printCharArray buffer)
                          (putchar #\Newline)))))

    ;; int
    (let (((<> StringBuffer int) sb . #'((<> new StringBuffer int) 4 #f)))
      (io sb
        (Bufferred buffer cursor size step
                   (block
                     (printf "StrignBuffer int, cursor: %d, size: %d, step %d\n" cursor size step)
                     (printIntArray buffer cursor)
                     (putchar #\Newline))))

      (set sb ((<> print StringBuffer int) sb (cast (int []) '{ 1 2 3 4 }) 4))

      (io sb
        (Bufferred buffer cursor size step
                   (block
                     (printf "StrignBuffer int, cursor: %d, size: %d, step %d\n" cursor size step)
                     (printIntArray buffer cursor)
                     (putchar #\Newline))))
      
      (set sb ((<> print StringBuffer int) sb (cast (int []) '{ 6 5 4 3 2 1 }) 6))
      
      (io sb
        (Bufferred buffer cursor size step
                   (block
                     (printf "StrignBuffer int, cursor: %d, size: %d, step %d\n" cursor size step)
                     (printIntArray buffer cursor)
                     (putchar #\Newline)))))))
