;;;; Cicili Fastcgi Server
;;;; uses and in respect to
;;;; $Id: fcgiapp.h,v 1.14 2003/06/22 00:16:44 robs Exp $

(import "draft/collection/btree.cicili")
(import "lib/std/pthread/pthread.cicili")

(header "router.h" (make :haskell #f)
        (include <fcgiapp.h>)
        (include <pthread.h>)

        ;; each path can handle many methods
        ;; (bitand GET POST)
        (enum RouteMethod
          (METHOD_GET     . 1)
          (METHOD_POST    . 2)
          (METHOD_PUT     . 4)
          (METHOD_DELETE  . 8)
          (METHOD_PATCH   . 16)
          (METHOD_HEAD    . 32)
          (METHOD_OPTIONS . 64))

        (typedef (Tuple CStr int) ParamResult)

        (decl-Maybe ParamResult)
        
        ;; stores request details and access parameters
        ;; RouterRequest rr
        (decl-class Request
          (MakeRequest (FCGX_Request * req)
            (CStr uri)
            (CStr method)
            (CStr queryString)
            (CStr postData))
          
          ;; warning! all params, queries and forms will be freed at the end of request
          (func param ((Request rr) (CStr param)) (out (<> Maybe CStr)))
          (func query ((Request rr) (CStr param)) (out (<> Maybe ParamResult)))
          (func form  ((Request rr) (CStr param)) (out (<> Maybe ParamResult))))
        
        (typedef func RouteHandler ((Request rr)))
        
        ;; Define Route type
        (typedef
            (Tuple
              CStr          ; path
              int           ; methods
              RouteHandler) ; request handler
          Route)

        ;; B-Tree dependency
        (decl-List List_Route Route)
        
        ;; a BTree which holds path to Routes
        ;; fast searchs huge amounts of routes
        (decl-B-Tree BTree_CStr_Route
          ;;   item : (Tuple CStr Route)
          CStr      ; CStr  : key type, route path
          Route)    ; Route : value type

        ;; Server Running Errors
        (decl-data RouterError
          (= ERR_UNKNOWN_ROUTER (<> Router ERR_UNKNOWN_ROUTER))
          (= ERR_FASTCGI_LIB    (<> Router ERR_FASTCGI_LIB) (int code) (CStr description))

          (func show ((RouterError error))))

        ;; server running error handling
        (decl-Either RouterError ; an error
          int)                   ; server file descriptor
        
        (decl-data Router
          (= SimpleRouter MakeSimpleRouter
             (CStr socket)              ; "/path/to/fcgi.sock" or ":9000"
             (BTree_CStr_Route routes)) ; stores routes

          ;; includes middleware processing
          (= DetailedRouter MakeDetailedRouter
             (CStr socket)                ; "/path/to/fcgi.sock" or ":9000"
             (BTree_CStr_Route routes)    ; stores routes
             (int backlog)                ; 5
             (int maxContentLength)       ; 2097152, 2MB
             (RouteHandler beforeRequest) ; process before request handling
             (RouteHandler afterRequest)  ; process after request handling
             (Bool multiThreading))       ; false: serlializing
          
          (func start ((Router router)) (out Either_RouterError_int)))
        
        ) ; router.h

(source "router.c" (make :std #t :haskell #t :compile #t :link #f)
        (include "router.h")
        (include <errno.h>)

        ;; RouteMethod private functions
        
        ;; correct method should be greater than 0
        (func CStrToRouteMethod ((CStr method))
              (out int)
              (if (== (strcmp method "GET") 0)
                  (return METHOD_GET)
                  (if (== (strcmp method "POST") 0)
                      (return METHOD_POST)
                      (if (== (strcmp method "PUT") 0)
                          (return METHOD_PUT)
                          (if (== (strcmp method "DELETE") 0)
                              (return METHOD_DELETE)
                              (if (== (strcmp method "PATCH") 0)
                                  (return METHOD_PATCH)
                                  (if (== (strcmp method "HEAD") 0)
                                      (return METHOD_HEAD)
                                      (if (== (strcmp method "OPTIONS") 0)
                                          (return METHOD_OPTIONS)
                                          (return 0)))))))))

        (impl-Maybe ParamResult)
        
        ;; RouterRequest rr private functions
        
        ;; Extract individual query/form parameter
        (func getParam ((CStr params) (CStr paramName))
              (out (<> Maybe ParamResult))
              (let ((CStr paramStart . #'(strstr params paramName)))
                (when paramStart
                  (set paramStart (+ paramStart (strlen paramName) 1))  
                  (let ((CStr delimiter . #'(strchr paramStart #\&)))  
                    (if delimiter
                        (return ((<> Just ParamResult) (cast ParamResult '{ paramStart (- delimiter paramStart) })))
                        (return ((<> Just ParamResult) (cast ParamResult '{ paramStart (strlen paramStart) })))))))
              (return ((<> Nothing ParamResult))))
        
        (impl-class Request
          (MakeRequest (FCGX_Request * req)
            (CStr uri)
            (CStr method)
            (CStr queryString)
            (CStr postData))

          ;; getRequestParam
          (func param ((Request rr) (CStr param))
                (out (<> Maybe CStr))
                (return (match rr
                          (* _ req (letn ((CStr value . #'(FCGX_GetParam param (-> req envp))))
                                     (? value
                                       ((<> Just CStr) value)
                                       ((<> Nothing CStr)))))
                          (default ((<> Nothing CStr))))))

          ;; getQueryStringParam
          (func query ((Request rr) (CStr param))
                (out (<> Maybe ParamResult))
                (return (match rr
                          (* _ _ _ _ queryString
                             (getParam queryString param))
                          (default ((<> Nothing ParamResult))))))

          ;; getPostDataParam
          (func form ((Request rr) (CStr param))
                (out (<> Maybe ParamResult))
                (return (match rr
                          (* _ _ _ _ _ postData
                             (getParam postData param))
                          (default ((<> Nothing ParamResult))))))

          (free (io this
                  (* _ _ _ _ _ payload
                     (free payload)))
                (free this))

          ) ; Request

        (static)
        (func compareKey ((CStr lkey) (CStr rkey))
              (out Ordering)
              (return (letin* ((cmp_res (strcmp lkey rkey)))
                        (case (<  cmp_res 0) (LT)
                              (== cmp_res 0) (EQ)
                              otherwise      (GT)))))

        (fn showKey -file -key
            (fprintf -file "%s" -key))
        
        (fn showItem -file -item
            (match -item
              ((\, path ((\, _ methods)))
               (fprintf -file "(path: %s, methods: %d" path methods))
              (default 0)))

        ;; B-Tree dependency
        (impl-List List_Route
          Route
          (\\ -file -r
              (match -r
                ((\, path methods)
                 (fprintf -file "(path: \"%s\", methods: %d)" path methods))
                (default 0)))
          "\n")
        
        ;; B-Tree item : (Tuple CStr Route)
        (impl-B-Tree BTree_CStr_Route
          CStr       ; key type, route path
          Route      ; value type
          3          ; m : order (degree)
          compareKey ; key comparision function
          showKey    ; show key function
          showItem)  ; show item function

        ;; Server Running Errors
        (impl-data RouterError
          (= ERR_UNKNOWN_ROUTER (<> Router ERR_UNKNOWN_ROUTER))
          (= ERR_FASTCGI_LIB    (<> Router ERR_FASTCGI_LIB) (int code) (CStr description))
          
          (func show ((RouterError error))
                (io error
                  (ERR_UNKNOWN_ROUTER (printf "unknown router"))
                  (ERR_FASTCGI_LIB code desc (printf "fastcgi error: %d, %s" code desc))
                  (default (printf "unknown error")))))
        
        (impl-Either RouterError ; an error
          int)                   ; server file descriptor

        ;; helper error handling functions
        (lambda left  -l ((<> Left  RouterError int) -l))
        (lambda right -r ((<> Right RouterError int) -r))

        ;; Router private functions

        ;; Parse form data
        ;; todo! parse xml/json too
        (func parsePostData ((FCGX_Request * req) (int maxContentLength))
              (out CStr)
              (let ((CStr clstr . #'(FCGX_GetParam "CONTENT_LENGTH" (-> req envp)))
                    (int contentLen . 0)
                    (CStr requestBody))
                (if clstr
                    (block (set contentLen (atoi clstr))
                           (when (> contentLen maxContentLength)
                             (set contentLen maxContentLength)))
                    (set contentLen maxContentLength))
                (set requestBody (calloc (+ contentLen 1) (sizeof char)))
                (set contentLen (FCGX_GetStr requestBody contentLen (-> req in)))
                (return requestBody)))

        ;; Process incoming requests based on routes
        (func processRoutes ((FCGX_Request * req)
                             (int maxContentLength)
                             (BTree_CStr_Route routes)
                             (RouteHandler beforeRequest)
                             (RouteHandler afterRequest))
              (let ((CStr req_uri         . #'(FCGX_GetParam "REQUEST_URI"    (-> req envp)))
                    (CStr req_method      . #'(FCGX_GetParam "REQUEST_METHOD" (-> req envp)))
                    (CStr req_queryString . #'(FCGX_GetParam "QUERY_STRING"   (-> req envp))))
                (info! (format #t "Request process begins: %d, %s, %s, %s\n" (-> req requestId) req_uri req_method req_queryString))
                (io ((<> search BTree_CStr_Route) routes req_uri)
                  (Just (\, _ (\, _ methods handler)) ; (Just Tuple (path (Tuple uri methods handler)))
                    (block (warn! (format #t "registered path: %s, methods: %d, request method: %d\n"
                                          req_uri methods (CStrToRouteMethod req_method)))
                           (if (> (bitand (CStrToRouteMethod req_method) methods) 0)
                               (let ((CStr payload . #'(parsePostData req maxContentLength)))
                                 (letin ((* request (MakeRequest req req_uri req_method req_queryString payload)))
                                   (when beforeRequest (beforeRequest request))
                                   (handler request)
                                   (when afterRequest (afterRequest request))))
                               (FCGX_PutS "HTTP/1.1 400 Bad Request\r\n" (-> req out)))))
                  (default (FCGX_PutS "HTTP/1.1 404 Not Found\r\n" (-> req out))))
                (info! (format #t "Request process done: %d, %s, %s, %s\n" (-> req requestId) req_uri req_method req_queryString))))

        (func releaseFCGXRequest ((FCGX_Request ** req))
              (info! (format #t "Releasing request: %d\n" (-> (cof req) requestId)))
              (FCGX_Finish_r *req)
              (FCGX_Free *req true))
        
        (func startWithArgs ((CStr socket)                ; ":9000"
                             (int backlog)                ; 5
                             (int maxContentLength)       ; 2097152, 2MB
                             (BTree_CStr_Route routes)    ; stores routes
                             (RouteHandler beforeRequest) ; process before request handling
                             (RouteHandler afterRequest)  ; process after request handling
                             (Bool multiThreading))       ; (False): serlializing
              (out Either_RouterError_int)
              (when (!= (FCGX_Init) 0) (return (left ((<> Router ERR_FASTCGI_LIB) errno (strerror errno)))))
              (let ((int server_fd . #'(FCGX_OpenSocket socket backlog)))
                (when (== server_fd -1) (return (left ((<> Router ERR_FASTCGI_LIB) errno (strerror errno)))))
                (format #t "FastCGI server running on %s ...\n" socket)
                
                (io multiThreading
                  (False (let ((FCGX_Request request))
                           (when (!= (FCGX_InitRequest (aof request) server_fd 0) 0)
                             (return (left ((<> Router ERR_FASTCGI_LIB) errno (strerror errno)))))
                           (while #t
                             (if (== (FCGX_Accept_r (aof request)) 0)
                                 (processRoutes (aof request) maxContentLength routes beforeRequest afterRequest)
                                 (return (left ((<> Router ERR_FASTCGI_LIB) errno (strerror errno))))))))
                  (True (while #t
                          (let ((FCGX_Request * request . #'(malloc (sizeof FCGX_Request))))
                            (when (!= (FCGX_InitRequest request server_fd 0) 0)
                              (error! (format #t "Request initiation error: %d, %s" errno (strerror errno))))
                            (if (== (FCGX_Accept_r request) 0)
                                (detach ((FCGX_Request * request)
                                         (int maxContentLength)
                                         (BTree_CStr_Route routes)
                                         (RouteHandler beforeRequest)
                                         (RouteHandler afterRequest))
                                  (letin* ((request request releaseFCGXRequest)) ; release resources on both error and succeed
                                    (processRoutes request maxContentLength routes beforeRequest afterRequest)))
                                (error! (format #t "Request acceptance error: %d, %s" errno (strerror errno))))))))
                (return (right server_fd))))

        (impl-data Router
          (= SimpleRouter MakeSimpleRouter
             (CStr socket)              ; ":9000"
             (BTree_CStr_Route routes)) ; stores routes

          ;; includes middleware processing
          (= DetailedRouter MakeDetailedRouter
             (CStr socket)                ; ":9000"
             (BTree_CStr_Route routes)    ; stores routes
             (int backlog)                ; 5
             (int maxContentLength)       ; 2097152, 2MB
             (RouteHandler beforeRequest) ; process before request handling
             (RouteHandler afterRequest)  ; process after request handling
             (Bool multiThreading))       ; false: serlializing
          
          ;; Start FastCGI Server
          (func start ((Router router))
                (out Either_RouterError_int)

                (return (match router
                          (SimpleRouter socket routes (startWithArgs socket 5 2097152 routes nil nil (False)))
                          (DetailedRouter socket routes backlog maxContentLength beforeRequest afterRequest multiThreading
                                          (startWithArgs socket backlog maxContentLength routes beforeRequest afterRequest multiThreading))
                          (default (left ((<> Router ERR_UNKNOWN_ROUTER)))))))

          ) ; Router

        ) ; router.c
