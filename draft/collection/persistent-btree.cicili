;;;; Persistent BTree

;; B-Tree
;; type: type name
;; k: key type
;; v: value type
;; m: order, The order of 3 will guarantee that nodes can be split or combined.
(generic decl-B-Tree
  (type k v)
  
  ;; forward btree class
  (typedef (struct (<> class type)) * type)

  ;; key-value tuple and the list
  (typedef (Tuple k v) (<> type pair_t))

  ;; Errors maybe raise during insertion or deletion
  (decl-data (BTreeError (<> type Error))
             (= ERR_INVALID_OBJECT    (<> type ERR_INVALID_OBJECT))
             (= ERR_INVALID_ORDER     (<> type ERR_INVALID_ORDER)     (size_t order))
             (= ERR_UNIQUE_KEY        (<> type ERR_UNIQUE_KEY)        ((<> type pair_t) item))
             (= ERR_NOT_FOUND         (<> type ERR_NOT_FOUND)         (k key))
             (= ERR_ACCESS_DEAD_CHILD (<> type ERR_ACCESS_DEAD_CHILD) ((<> type pair_t) item) (size_t index))
             (= ERR_INVALID_BRANCH    (<> type ERR_INVALID_BRANCH)    (type branch))
             (= ERR_CANT_BORROW       (<> type ERR_CANT_BORROW)       (char * reason))

             (func show (((<> type Error) error))))
  
  ;; dependencies
  (decl-Either (<> type Error) type)
  (decl-Maybe type)
  (decl-Maybe (<> type pair_t))       ; search/min/max return Maybe pair_t
  
  ;; items list
  (decl-List (<> List type pair_t) (<> type pair_t))
  (decl-Maybe (<> List type pair_t)) ; wleft parameters use Maybe (List pair_t)
  ;; children list
  ;; list of Rcs wrap each child
  (decl-Rc type)
  (decl-List (<> List (<> Rc type)) (<> Rc type))
  ;; fmap over 'Rc child' and 'List Rc child'
  (decl-Functor-List (<> List (<> Rc type)) (<> Rc type) (<> Rc type))

  (decl-class (BTree type)
              (= Branch (<> Branch type) ; Branch is used when split occures
                 ((<> List type pair_t) items)
                 ((<> List Rc type) children))
              (= Internal (<> Internal type)
                 ((<> List type pair_t) items)
                 ((<> List Rc type) children))
              (= Leaf (<> Leaf type)
                 ((<> List type pair_t) items))
              
              (func order     () (out size_t))
              (func insert    ((type tree) (k skey) (v svalue)) (out (<> Either (<> type Error) type)))
              (func search    ((type tree) (k skey)) (out (<> Maybe type pair_t)))
              (func delete    ((type tree) (k skey) (func callback (((<> type pair_t) item)))) (out (<> Either (<> type Error) type)))
              (func min       ((type tree)) (out (<> Maybe type pair_t)))
              (func max       ((type tree)) (out (<> Maybe type pair_t)))
              (func traverse  ((type tree) (func callback (((<> type pair_t) item) (Bool hasNext)))))
              (func show      ((CFile file) (type tree)) (out size_t))
              (func pure      ((k keys []) (v values []) (size_t len)) (out (<> Either (<> type Error) type)))
              ) ; decl-class
  
  ) ; decl-B-Tree

;; sh-key show a key of type k
;; sh-item show an item of type pair_t
(generic impl-B-Tree
  (type k v m cmp sh-key sh-item)

  (impl-data (BTreeError (<> type Error))
             (= ERR_INVALID_OBJECT    (<> type ERR_INVALID_OBJECT))
             (= ERR_INVALID_ORDER     (<> type ERR_INVALID_ORDER)     (size_t order))
             (= ERR_UNIQUE_KEY        (<> type ERR_UNIQUE_KEY)        ((<> type pair_t) item))
             (= ERR_NOT_FOUND         (<> type ERR_NOT_FOUND)         (k key))
             (= ERR_ACCESS_DEAD_CHILD (<> type ERR_ACCESS_DEAD_CHILD) ((<> type pair_t) item) (size_t index))
             (= ERR_INVALID_BRANCH    (<> type ERR_INVALID_BRANCH)    (type branch))
             (= ERR_CANT_BORROW       (<> type ERR_CANT_BORROW)       (char * reason))

             (func show (((<> type Error) error))
                   (io error
                     (ERR_INVALID_OBJECT (printf "invalid B-Tree object"))
                     (ERR_INVALID_ORDER order (printf "invalid B-Tree order: %zu" order))
                     (ERR_UNIQUE_KEY item (block (printf "unique key: ") ($> sh-item stdout item)))
                     (ERR_NOT_FOUND key (block (printf "key not found: ") ($> sh-key stdout key)))
                     (ERR_ACCESS_DEAD_CHILD item index (block (printf "dead child at index: %zu of item: " index) ($> sh-item stdout item)))
                     (ERR_INVALID_BRANCH branch (block (printf "invalid branch: ") ((<> show type) stdout branch)))
                     (ERR_CANT_BORROW reason (printf "borrow error: %s" reason))
                     (default (printf "unknown error")))))
  
  ;; dependencies
  (impl-Either (<> type Error) type)
  (impl-Maybe type)
  (impl-Maybe (<> type pair_t))
  
  (impl-List (<> List type pair_t) (<> type pair_t) sh-item " ")
  (impl-Maybe (<> List type pair_t))

  (impl-Rc type)
  (impl-List (<> List (<> Rc type)) (<> Rc type)
             (\\ -f -wChild (match ((<> get Rc type) -wChild)
                              (Just child ((<> show type) -f child))
                              (default 0)))
             " ")
  
  (impl-Functor-List (<> List (<> Rc type)) (<> Rc type) (<> Rc type))

  ;; private constants
  (var size_t (<> U type) . `m) ; inside generic default atom values should set with ` or QUASIQUOTE 
  (var size_t (<> L type) . `(CEILING m 2)) ; compile time calculation with ` or QUASIQUOTE inside generic

  ;; aliases
  (DEFMACRO branch   (-i -c) `((<> Branch   type) ,-i ,-c))
  (DEFMACRO internal (-i -c) `((<> Internal type) ,-i ,-c))
  (DEFMACRO leaf     (-i)    `((<> Leaf     type) ,-i))
  
  (lambda left  -l ((<> Left  (<> type Error) type) -l))
  (lambda right -r ((<> Right (<> type Error) type) -r))
  
  ;; private functions
  (func (<> split type) ((type tree))
        (out type)
        (return (match tree
                  (* Branch ~ Internal items children
                     ;; check for split
                     (case (>= ((<> len List type pair_t) items) (<> U type))
                           (letin ((* tree tree))
                             (branch
                              ;; items
                              ((<> wrap List type pair_t)
                               (match ((<> nth List type pair_t) (- (<> L type) 1) items)
                                 (Just nitem nitem)
                                 (default (cast (<> type pair_t) '{ }))))
                              ;; children
                              ((<> pure List Rc type)
                               (cast ((<> Rc type) []) '{
                                     ((<> new Rc type)
                                      (internal
                                       ((<> take List type pair_t) (- (<> L type) 1) items)
                                       (letin ((* r1 ((<> take List Rc type) (<> L type) children)))
                                         (((<> fmap List Rc type) (<> clone Rc type)) r1))))
                                     ((<> new Rc type)
                                      (internal
                                       ((<> drop List type pair_t) (<> L type) items)
                                       (letin ((* r1 ((<> drop List Rc type) (<> L type) children)))
                                         (((<> fmap List Rc type) (<> clone Rc type)) r1))))
                                     }) 2 )))
                           otherwise tree))
                  (* Leaf items
                     ;; check for split
                     (case (>= ((<> len List type pair_t) items) (<> U type))
                           ;; because split occures after new items added to leaf so the leaf has a new list of items
                           ;; this error of dangle temp tree pointer was found by Cicili analyzer
                           (letin ((* tree tree))
                             (branch
                              ;; items
                              ((<> wrap List type pair_t)
                               (match ((<> nth List type pair_t) (- (<> L type) 1) items)
                                 (Just nitem nitem)
                                 (default (cast (<> type pair_t) '{ }))))
                              ;; children
                              ((<> pure List Rc type)
                               (cast ((<> Rc type) []) '{
                                     ((<> new Rc type) (leaf ((<> take List type pair_t) (- (<> L type) 1) items)))
                                     ((<> new Rc type) (leaf ((<> drop List type pair_t) (<> L type) items)))
                                     }) 2 )))
                           otherwise tree))
                  (default tree)))
        ) ; split

  (func (<> splitForDelete type) ((type tree))
        (out type)
        (return (match tree
                  (* Branch ~ Internal items children
                     ;; check for split
                     (case (>= ((<> len List type pair_t) items) (<> U type))
                           (branch
                            ;; items
                            ((<> wrap List type pair_t)
                             (match ((<> nth List type pair_t) (- (<> L type) 1) items)
                               (Just nitem nitem)
                               (default (cast (<> type pair_t) '{ }))))
                            ;; children
                            ((<> pure List Rc type)
                             (cast ((<> Rc type) []) '{
                                   ((<> new Rc type)
                                    (internal
                                     ((<> take List type pair_t) (- (<> L type) 1) items)
                                     (letin ((* r1 ((<> take List Rc type) (<> L type) children)))
                                       (((<> fmap List Rc type) (<> clone Rc type)) r1))))
                                   ((<> new Rc type)
                                    (internal
                                     ((<> drop List type pair_t) (<> L type) items)
                                     (letin ((* r1 ((<> drop List Rc type) (<> L type) children)))
                                       (((<> fmap List Rc type) (<> clone Rc type)) r1))))
                                   }) 2 ))
                           otherwise tree))
                  (* Leaf items
                     ;; check for split
                     (case (>= ((<> len List type pair_t) items) (<> U type))
                           ;; because split occures after new items added to leaf so the leaf has a new list of items
                           ;; this error of dangle temp tree pointer was found by Cicili analyzer
                           (branch
                            ;; items
                            ((<> wrap List type pair_t)
                             (match ((<> nth List type pair_t) (- (<> L type) 1) items)
                               (Just nitem nitem)
                               (default (cast (<> type pair_t) '{ }))))
                            ;; children
                            ((<> pure List Rc type)
                             (cast ((<> Rc type) []) '{
                                   ((<> new Rc type) (leaf ((<> take List type pair_t) (- (<> L type) 1) items)))
                                   ((<> new Rc type) (leaf ((<> drop List type pair_t) (<> L type) items)))
                                   }) 2 ))
                           otherwise tree))
                  (default tree)))
        ) ; splitForDelete
  

  ;; merge with parent if needed
  (func (<> mergeUp type) (((<> List type pair_t) items)
                           ((<> List Rc type) children)
                           (size_t pitem_index)
                           (size_t pchild_index)
                           ((<> List type pair_t) left_items)
                           ((<> List Rc type) left_children)
                           ((<> List type pair_t) right_items)
                           ((<> List Rc type) right_children))
        (out type)

        (warn!
            (format #t "mergeUp:\n")
          (show items)
          (putchar #\Newline)
          (format #t "children:\n ")
          (show children)
          (format #t "left children:\n ")
          (show left_children)
          (format #t "right children:\n ")
          (show right_children)
          (format #t "indx: %ld, %ld\n" pitem_index pchild_index))

        (return
         (letin* ((merged (internal
                           ((<> append List type pair_t) left_items right_items)
                           (letin ((* r1 ((<> append List Rc type) left_children right_children)))
                             (((<> fmap List Rc type) (<> clone Rc type)) r1)))))
                 (match ((<> splitForDelete type) merged)
                   ;; splitted after merge
                   (= tmp_child * Branch (* Cons head) tmp_children
                      (letin ((* merged merged)
                              (* tmp_child tmp_child))
                        (internal
                         ((<> replaceAt List type pair_t) items head pitem_index)
                         (letin ((* r1 ((<> deleteAt List Rc type) children pchild_index))
                                 (* r2 ((<> take List Rc type) pchild_index r1))
                                 (* r3 ((<> drop List Rc type) (+ pchild_index 1) r1))
                                 (* r4 ((<> append List Rc type) tmp_children r3))
                                 (* r5 ((<> append List Rc type) r2 r4)))
                           (((<> fmap List Rc type) (<> clone Rc type)) r5)))))
                   (* Internal ; tmp_items tmp_children
                      (internal
                       ((<> deleteAt List type pair_t) items pitem_index)
                       (letin ((* r1 ((<> deleteAt List Rc type) children pchild_index))
                               (r2   ((<> new Rc type) merged))
                               (* r3 ((<> replaceAt List Rc type) r1 r2 pchild_index)))
                         (((<> fmap List Rc type) (<> clone Rc type)) r3))))
                   ;; never be happened
                   (default ((<> Leaf type) ((<> Nil type pair_t))))))))

  
  (decl) (func (<> deleteWithParent type) (((<> Maybe type) wparent)
                                           (size_t pitem_index)
                                           (size_t pchild_index)
                                           (type tree)
                                           (k skey)
                                           (func callback (((<> type pair_t) item))))
               (out (<> Either (<> type Error) type)))

  
  (func (<> borrowLeaf type) (((<> List type pair_t) items)
                              ((<> List Rc type) children)
                              ((<> Maybe (<> List type pair_t)) wleft)
                              ((<> List type pair_t) current)
                              (size_t index)
                              (type nchild)
                              (func callback (((<> type pair_t) item))))
        (out (<> Either (<> type Error) type))
        
        (warn!
            (format #t "*** borrowLeaf:\n")
          (format #t "items:\n")
          (show items)
          (putchar #\Newline)
          (format #t "children:\n")
          (show children)
          (putchar #\Newline)
          (io wleft
            (Just left
              (block (format #t "left:\n")
                     (show left)
                     (putchar #\Newline))))
          (show current)
          (putchar #\Newline)
          (format #t "%ld" index)
          (putchar #\Newline)
          (io nchild
            (* Branch ~ Internal ~ Leaf child_items
               (block (show child_items)
                      (putchar #\Newline)))))

        ;; borrow from right child
        (func borrowRight (((<> List type pair_t) child_items))
              (out (<> Either (<> type Error) type))

              (warn! (format #t "*** borrowLeafRight\n"))
              
              (return
               (match ((<> nth List Rc type) (+ index 1) children)
                 (Just right_child_rc -># right_child_rc
                       (dead (left ((<> type ERR_CANT_BORROW) "borrowRight 3")))

                       ;; right child is Leaf
                       (* Leaf right_child_items
                          (case (== ((<> hasLen List type pair_t) right_child_items (<> L type)) (<> L type))
                                (match right_child_items
                                  (* Cons first_item tail
                                     (right
                                      (internal
                                       ((<> replace List type pair_t) items first_item current)
                                       (letin ((* r1 ((<> take List Rc type) index children))
                                               (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                               (* r3 ((<> drop List Rc type) (+ index 2) children))
                                               (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                               (* r5 ((<> take List type pair_t) 1 current))
                                               (* r7 ((<> pure List Rc type)
                                                      (cast ((<> Rc type) []) '{
                                                            ((<> new Rc type)
                                                             (leaf ((<> append List type pair_t) child_items r5)))
                                                            ((<> new Rc type)
                                                             (leaf ((<> copy List type pair_t) tail)))
                                                            }) 2 ))
                                               (* r6 ((<> append List Rc type) r7 r4)))
                                         ((<> append List Rc type) r2 r6)))))
                                  (default (left ((<> type ERR_CANT_BORROW) "borrowRight R1"))))
                                ;; merge
                                otherwise (match current
                                            (* Cons head
                                               (right
                                                (internal
                                                 ((<> delete List type pair_t) items current)
                                                 (letin ((* r1 ((<> take List Rc type) index children))
                                                         (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                         (* r3 ((<> drop List Rc type) (+ index 2) children))
                                                         (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                                         (* r5 ((<> wrap List type pair_t) head))
                                                         (* r6 ((<> append List type pair_t) child_items r5))
                                                         (* r8 ((<> push List Rc type)
                                                                ((<> new Rc type)
                                                                 (leaf ((<> append List type pair_t) r6 right_child_items)))
                                                                r4)))
                                                   ((<> append List Rc type) r2 r8)))))
                                            (default (left ((<> type ERR_CANT_BORROW) "borrowRight R2"))))))

                       (default (left ((<> type ERR_CANT_BORROW) "borrowRight 3"))))
                 (default (left ((<> type ERR_CANT_BORROW) "borrowRight 4"))))))
        
        ;; borrow from left child
        (func borrowLeft (((<> List type pair_t) child_items))
              (out (<> Either (<> type Error) type))

              (warn! (format #t "*** borrowLeafLeft\n"))

              (return
               (match wleft
                 ;; left child exists
                 (Just (= left * Cons left_item) -> ((<> nth List Rc type) (- index 1) children)
                       (Just left_child_rc -># left_child_rc
                             (dead (left ((<> type ERR_CANT_BORROW) "borrowLeft 4")))
                             
                             ;; left child is Leaf 
                             (* Leaf left_child_items
                                (case (== ((<> hasLen List type pair_t) left_child_items (<> L type)) (<> L type))
                                      (match ((<> last List type pair_t) left_child_items)
                                        (= last * Cons last_item
                                           (letin ((* last last))
                                             (right
                                              (internal
                                               ((<> replace List type pair_t) items last_item left)
                                               ;; letin will free all temp lists
                                               (letin ((* r1 ((<> take List Rc type) (- index 1) children))
                                                       (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                       (* r3 ((<> drop List Rc type) (+ index 1) children))
                                                       (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                                       (* r5 ((<> pure List Rc type)
                                                              (cast ((<> Rc type) []) '{
                                                                    ((<> new Rc type)
                                                                     (leaf ((<> init List type pair_t) left_child_items)))
                                                                    ((<> new Rc type)
                                                                     (leaf ((<> push List type pair_t) left_item child_items)))
                                                                    }) 2 ))
                                                       (* r7 ((<> append List Rc type) r5 r4)))
                                                 ((<> append List Rc type) r2 r7))))))
                                        (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 2"))))
                                      ;; merge
                                      otherwise (match (borrowRight child_items)
                                                  ;; no right child
                                                  (Left (right
                                                         (internal
                                                          ((<> delete List type pair_t) items left)
                                                          (letin ((* r1 ((<> take List Rc type) (- index 1) children))
                                                                  (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                                  (* r3 ((<> drop List Rc type) (+ index 1) children))
                                                                  (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                                                  (* r8 ((<> wrap List type pair_t) left_item))
                                                                  (* r5 ((<> append List type pair_t) left_child_items r8))
                                                                  (* r7 ((<> push List Rc type)
                                                                         ((<> new Rc type)
                                                                          (leaf ((<> append List type pair_t) r5 child_items)))
                                                                         r4)))
                                                            ((<> append List Rc type) r2 r7)))))
                                                  (= right default right))))

                             (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 3"))))
                       (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 5"))))

                 ;; no left, check for right child existance
                 (default (borrowRight child_items)))))

        (return
         (letin* ((result
                   (match nchild
                     (* Branch ~ Internal ~ Leaf child_items
                        ;; has got minimum keys
                        (case (== ((<> hasLen List type pair_t) child_items (- (<> L type) 1)) (- (<> L type) 1))
                              (right
                               (internal
                                ((<> copy List type pair_t) items)
                                (letin ((r1   ((<> new Rc type) nchild))
                                        (* r2 ((<> replaceAt List Rc type) children r1 index)))
                                  (((<> fmap List Rc type) (<> clone Rc type)) r2))))
                              ;; hasn't got minimum keys
                              otherwise (letin ((* nchild nchild))
                                          (borrowLeft child_items))))
                     (default (left ((<> type ERR_CANT_BORROW) "borrow 1"))))))

                 (warn!
                     (format #t "*** borrowLeafEND:\n")
                   (io result (Right tr (show tr)))
                   (putchar #\Newline))

                 result))
        
        ) ; borrowLeaf
  
  ;; borrow over internal key deletion
  (func (<> borrowInternal type) (((<> Maybe type) wtree)
                                  ((<> List type pair_t) items)
                                  ((<> List Rc type) children)
                                  ((<> List type pair_t) current)
                                  (size_t index)
                                  (func callback (((<> type pair_t) item))))
        (out (<> Either (<> type Error) type))

        (warn!
            (format #t "*** borrowInternal:\n")
          (io wtree (Just tr (block (format #t "tree:\n")
                                    (show tr)
                                    (putchar #\Newline))))
          (format #t "items:\n")
          (show items)
          (putchar #\Newline)
          (format #t "children:\n ")
          (show children)
          (putchar #\Newline)
          (show current)
          (putchar #\Newline)
          (format #t "%ld" index)
          (putchar #\Newline))

        ;; borrow from right child (internal)
        (func borrowRightInternal (((<> List type pair_t) left_child_items)
                                   ((<> List Rc type) left_child_children))
              (out (<> Either (<> type Error) type))

              (warn!
                  (format #t "*** borrowRightInternal:\n")
                (show left_child_items)
                (putchar #\Newline)
                (show left_child_children)
                (putchar #\Newline))
              
              (return
               (match ((<> nth List Rc type) (+ index 1) children)
                 (Just right_child_rc -> ((<> get Rc type) right_child_rc)
                       (Just right_child -> right_child
                             (* Branch ~ Internal right_child_items right_child_children
                                (case (== ((<> hasLen List type pair_t) right_child_items (<> L type)) (<> L type))
                                      (match ((<> min type) right_child)
                                        (Just (= min (\, min_key)) -> ((<> delete type) right_child min_key nil)
                                              ;; new Internal child
                                              (Right nchild
                                                (right
                                                 (internal
                                                  ((<> replace List type pair_t) items min current)
                                                  (letin ((r1   ((<> new Rc type) nchild))
                                                          (* r2 ((<> replaceAt List Rc type) children r1 (+ index 1))))
                                                    (((<> fmap List Rc type) (<> clone Rc type)) r2)))))
                                              (= left default left))
                                        (default (left ((<> type ERR_CANT_BORROW) "borrowRI 1"))))
                                      
                                      ;; merge
                                      otherwise (match current
                                                  (* Cons (= current_item (\, current_key))
                                                     (letin ((* r1 ((<> push List type pair_t) current_item right_child_items))
                                                             (* r2 ((<> append List Rc type) left_child_children right_child_children))

                                                             (* r4 (internal ; temp combined internal
                                                                    ((<> append List type pair_t) left_child_items r1)
                                                                    (((<> fmap List Rc type) (<> clone Rc type)) r2)))
                                                             
                                                             (* r5 ((<> take List Rc type) index children))
                                                             (* r7 ((<> drop List Rc type) (+ index 2) children)))
                                                       (match ((<> delete type) r4 current_key nil)
                                                         (Right ntree -> ((<> splitForDelete type) ntree)
                                                                ;; was needed to split after combination (overflow)
                                                                (= tmp_result * Branch branch_items branch_children -> branch_items
                                                                   (* Cons branch_head
                                                                      (letin ((* ntree ntree)
                                                                              (* tmp_result tmp_result))
                                                                        (right
                                                                         (internal
                                                                          ((<> replace List type pair_t) items branch_head current)
                                                                          (letin ((* r10 ((<> append List Rc type) branch_children r7))
                                                                                  (* r11 ((<> append List Rc type) r5 r10)))
                                                                            (((<> fmap List Rc type) (<> clone Rc type)) r11))))))
                                                                   (default (left ((<> type ERR_CANT_BORROW) "borrowRI 2"))))
                                                                (* Internal
                                                                   (right
                                                                    (internal
                                                                     ((<> delete List type pair_t) items current)
                                                                     (letin ((r9    ((<> new Rc type) ntree))
                                                                             (* r10 ((<> push List Rc type) r9 r7))
                                                                             (* r11 ((<> append List Rc type) r5 r10)))
                                                                       (((<> fmap List Rc type) (<> clone Rc type)) r11)))))
                                                                (default (left ((<> type ERR_CANT_BORROW) "borrowRI 3"))))
                                                         (= left default left))))
                                                  (default (left ((<> type ERR_CANT_BORROW) "borrowRI 4"))))))
                             
                             ;; child is Leaf
                             (default (left ((<> type ERR_CANT_BORROW) "borrowRI 5"))))
                       (default (left ((<> type ERR_CANT_BORROW) "borrowRI 6")))) ; Dead Child
                 (default (left ((<> type ERR_CANT_BORROW) "borrowRI 7"))))) ; No Child
              ) ; borrowRightInternal

        ;; borrow from right child (leaf)
        (func borrowRightLeaf (((<> List type pair_t) left_child_items))
              (out (<> Either (<> type Error) type))

              (warn!
                  (format #t "*** borrowRightLeaf: ")
                (show left_child_items)
                (putchar #\Newline))
              
              (return
               (match ((<> nth List Rc type) (+ index 1) children)
                 (Just right_child_rc -> ((<> get Rc type) right_child_rc)
                       (Just right_child -> right_child
                             (* Leaf right_child_items
                                (case (== ((<> hasLen List type pair_t) right_child_items (<> L type)) (<> L type))
                                      (match ((<> min type) right_child)
                                        (Just (= min (\, min_key)) -> ((<> delete type) right_child min_key nil)
                                              ;; new Internal child
                                              (Right nchild
                                                (right
                                                 (internal
                                                  ((<> replace List type pair_t) items min current)
                                                  (letin ((r1   ((<> new Rc type) nchild))
                                                          (* r2 ((<> replaceAt List Rc type) children r1 (+ index 1))))
                                                    (((<> fmap List Rc type) (<> clone Rc type)) r2)))))
                                              (= left default left))
                                        (default (left ((<> type ERR_CANT_BORROW) "borrowRI 8"))))
                                      ;; merge parent down
                                      otherwise (right
                                                 (internal
                                                  ((<> delete List type pair_t) items current) ; check length of items
                                                  (letin ((* r1 ((<> take List Rc type) index children))
                                                          (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                          (* r3 ((<> drop List Rc type) (+ index 2) children))
                                                          (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                                          (* r5 ((<> push List Rc type)
                                                                 ((<> new Rc type)
                                                                  (leaf ((<> append List type pair_t) left_child_items right_child_items)))
                                                                 r4)))
                                                    ((<> append List Rc type) r2 r5))))))
                             ;; child is Internal
                             (default (left ((<> type ERR_CANT_BORROW) "borrowRI 9"))))
                       (default (left ((<> type ERR_CANT_BORROW) "borrowRI 10")))) ; Dead Child
                 (default (left ((<> type ERR_CANT_BORROW) "borrowRI 11")))))) ; No Child

        ;; borrow from left child
        (return
         (letin* ((result
                   (match ((<> nth List Rc type) index children)
                     (Just left_child_rc -> ((<> get Rc type) left_child_rc)
                           (Just left_child -> left_child 
                                 (* Branch ~ Internal left_child_items left_child_children
                                    (case (== ((<> hasLen List type pair_t) left_child_items (<> L type)) (<> L type))
                                          (match ((<> max type) left_child)
                                            (Just (= max (\, max_key)) -> ((<> delete type) left_child max_key nil)
                                                  ;; new Internal child
                                                  (Right nchild
                                                    (right
                                                     (internal
                                                      ((<> replace List type pair_t) items max current)
                                                      (letin ((r1   ((<> new Rc type) nchild))
                                                              (* r2 ((<> replaceAt List Rc type) children r1 index)))
                                                        (((<> fmap List Rc type) (<> clone Rc type)) r2)))))
                                                  (= left default left))
                                            (default (left ((<> type ERR_CANT_BORROW) "borrowRI 12"))))
                                          ;; try right
                                          otherwise (borrowRightInternal left_child_items left_child_children)))
                                 (* Leaf left_child_items
                                    (case (== ((<> hasLen List type pair_t) left_child_items (<> L type)) (<> L type))
                                          (match ((<> max type) left_child)
                                            (Just (= max (\, max_key)) -> ((<> delete type) left_child max_key nil)
                                                  ;; new Internal child
                                                  (Right nchild
                                                    (right
                                                     (internal
                                                      ((<> replace List type pair_t) items max current)
                                                      (letin ((r1   ((<> new Rc type) nchild))
                                                              (* r2 ((<> replaceAt List Rc type) children r1 index)))
                                                        (((<> fmap List Rc type) (<> clone Rc type)) r2)))))
                                                  (= left default left))
                                            (default (left ((<> type ERR_CANT_BORROW) "borrowRI 13"))))
                                          ;; try right
                                          otherwise (borrowRightLeaf left_child_items)))
                                 (default (left ((<> type ERR_CANT_BORROW) "borrowRI 14"))))
                           (default (left ((<> type ERR_CANT_BORROW) "borrowRI 15")))) ; Dead child
                     (default (left ((<> type ERR_CANT_BORROW) "borrowRI 16")))))) ; No Child

                 (warn!
                     (format #t "*** borrowInternalEND:\n")
                   (io result (Right tr (show tr)))
                   (putchar #\Newline))

                 result))
        
        ) ; borrowInternal

  (func (<> deleteWithParent type) (((<> Maybe type) wparent)
                                    (size_t pitem_index)
                                    (size_t pchild_index)
                                    (type tree)
                                    (k skey)
                                    (func callback (((<> type pair_t) item))))
        (out (<> Either (<> type Error) type))
        
        (analyze-data!
            (fprintf __h_stack_out "*** deleteWithParent: ")
          ($> sh-key __h_stack_out skey))

        (warn!
            (format #t "*** deleteWP: ")
          ($> sh-key stdout skey)
          (putchar #\Newline)
          (format #t "Parent item index: %ld, child index: %ld\n" pitem_index pchild_index))
        
        ;; delete from an internal
        (func deleteInternal (((<> Maybe type) tree)
                              ((<> List type pair_t) items)
                              ((<> List Rc type) children)
                              ((<> Maybe (<> List type pair_t)) wleft)
                              ((<> List type pair_t) current)
                              (size_t index))
              (out (<> Either (<> type Error) type))

              (analyze-data! ((<> show List type pair_t) __h_stack_out current))
              
              (warn!
                  (format #t "*** deleteInternal:\n")
                (show items)
                (putchar #\Newline)
                (format #t "children:\n ")
                (show children)
                (putchar #\Newline)
                (io wleft
                  (Just left
                    (block (format #t "left:\n")
                           (show left)
                           (putchar #\Newline))))
                (format #t "current:\n")
                (show current)
                (putchar #\Newline)
                (format #t "index: %ld" index)
                (putchar #\Newline))

              (return
               (letin*
                ((result
                  (match current

                    ;; checks against existing keys
                    (* Cons (= head (\, key)) tail -> (cmp skey key)
                       (LT -> ((<> nth List Rc type) index children) ; lower than
                           ;; using -> inner match application operator to prevent inner match keyword repeatition
                           ;; child exists
                           (Just child -> ((<> get Rc type) child)
                                 ;; if child tree pointer alive
                                 (Just tr -> tr
                                       (* Branch ~ Internal -> ((<> deleteWithParent type) tree
                                                                (? (> index 0) (- index 1) index)
                                                                index tr skey callback)
                                          (Right nchild -> nchild
                                                 (* Branch child_items child_children
                                                    (match ((<> nth List Rc type) (- index 1) children)
                                                      ;; merge left
                                                      (Just wleft -># wleft
                                                            (dead (left ((<> type ERR_CANT_BORROW) "BWPL1")))
                                                            (* Branch ~ Internal left_items left_children
                                                               (letin ((* nchild nchild))
                                                                 (right
                                                                  ((<> mergeUp type)
                                                                   items children
                                                                   (? (> index 0) (- index 1) index) (? (> index 0) (- index 1) index)
                                                                   left_items left_children
                                                                   child_items child_children))))
                                                            (default (left ((<> type ERR_CANT_BORROW) "BWPL1-1"))))
                                                      ;; merge right
                                                      (default -> ((<> nth List Rc type) (+ index 1) children)
                                                               (Just wright -># wright
                                                                     (dead (left ((<> type ERR_CANT_BORROW) "BWPR2")))
                                                                     (* Branch ~ Internal right_items right_children
                                                                        (letin ((* nchild nchild))
                                                                          (right
                                                                           ((<> mergeUp type)
                                                                            items children
                                                                            (? (> index 0) (- index 1) index) index
                                                                            child_items child_children
                                                                            right_items right_children))))
                                                                     (default (left ((<> type ERR_CANT_BORROW) "BWPR2-1"))))
                                                               (default (left ((<> type ERR_CANT_BORROW) "BWPR1"))))))
                                                 (default (right
                                                           (internal
                                                            ((<> copy List type pair_t) items)
                                                            (letin ((r1   ((<> new Rc type) nchild))
                                                                    (* r2 ((<> replaceAt List Rc type) children r1 index)))
                                                              (((<> fmap List Rc type) (<> clone Rc type)) r2))))))
                                          (= left default left))
                                       (default -> ((<> deleteWithParent type) tree
                                                    (? (> index 0) (- index 1) index)
                                                    index tr skey callback)
                                                ;; successful deletion in child
                                                (Right nchild
                                                  ((<> borrowLeaf type) items children wleft current index nchild callback))
                                                ;; propagate error
                                                (= left default left)))
                                 (default (left ((<> type ERR_ACCESS_DEAD_CHILD) head index))))
                           (default (left ((<> type ERR_NOT_FOUND) skey))))
                       
                       ;; case           ; equal
                       (EQ (letin* ((result ((<> borrowInternal type) tree items children current index callback)))
                                   (io result (Right (when callback (callback head))))
                                   result))
                       
                       ;; case           ; greater than
                       (default (deleteInternal tree items children ((<> Just (<> List type pair_t)) current) tail (+ index 1))))
                    
                    ;; no any key (item) exists
                    (default (match ((<> nth List Rc type) index children)
                               ;; using -> inner match application operator to prevent inner match keyword repeatition
                               ;; m+1 child exists
                               (Just child -> ((<> get Rc type) child)
                                     ;; if child tree pointer alive
                                     (Just tr -> tr
                                           ;; item is deleted
                                           (* Branch ~ Internal -> 
                                              ((<> deleteWithParent type) tree (- index 1) index tr skey callback)
                                              (Right nchild -> nchild 
                                                     (* Branch child_items child_children
                                                        (match ((<> nth List Rc type) (- index 1) children)
                                                          ;; merge left
                                                          (Just wleft -># wleft
                                                                (dead (left ((<> type ERR_CANT_BORROW) "BWPL11")))
                                                                (* Branch ~ Internal left_items left_children
                                                                   (letin ((* nchild nchild))
                                                                     (right
                                                                      ((<> mergeUp type)
                                                                       items children
                                                                       (- index 1) (- index 1)
                                                                       left_items left_children
                                                                       child_items child_children))))
                                                                (default (left ((<> type ERR_CANT_BORROW) "BWPL111"))))
                                                          ;; merge right
                                                          (default -> ((<> nth List Rc type) (+ index 1) children)
                                                                   (Just wright -># wright
                                                                         (dead (left ((<> type ERR_CANT_BORROW) "BWPR22")))
                                                                         (* Branch ~ Internal right_items right_children
                                                                            (letin ((* nchild nchild))
                                                                              (right
                                                                               ((<> mergeUp type)
                                                                                items children
                                                                                (- index 1) index
                                                                                child_items child_children
                                                                                right_items right_children))))
                                                                         (default (left ((<> type ERR_CANT_BORROW) "BWPR222"))))
                                                                   (default (left ((<> type ERR_CANT_BORROW) "BWPR221"))))))
                                                     (default (right
                                                               (internal
                                                                ((<> copy List type pair_t) items)
                                                                (letin ((r1   ((<> new Rc type) nchild))
                                                                        (* r2 ((<> replaceAt List Rc type) children r1 index)))
                                                                  (((<> fmap List Rc type) (<> clone Rc type)) r2))))))
                                              (= left default left))
                                           (default -> ((<> deleteWithParent type) tree (- index 1) index tr skey callback)
                                                    ;; successful deletion in child
                                                    (Right nchild
                                                      ((<> borrowLeaf type) items children wleft current index nchild callback))
                                                    ;; propagate error
                                                    (= left default left)))
                                     (default (left ((<> type ERR_ACCESS_DEAD_CHILD) (cast (<> type pair_t) '{ }) index))))
                               (default (left ((<> type ERR_NOT_FOUND) skey)))))))
                 ) ; decl result
                
                (warn!
                    (format #t "*** deleteInternalEND:\n")
                  (format #t "index: %ld" index)
                  (io result
                    (Right tr (block (format #t "\nresult:\n")
                                     (show tr))))
                  (putchar #\Newline))

                (letin* ((rs (match result
                               (Right ntr -> ntr
                                      (* Branch ~ Internal items children
                                         (letin* ((items_len ((<> hasLen List type pair_t) items (- (<> L type) 1))))
                                                 (case (== items_len (- (<> L type) 1)) result
                                                       ;; hasn't got minimum keys
                                                       otherwise
                                                       (match wparent
                                                         ;; has parent
                                                         (Just ptree -> ptree
                                                               (* Branch ~ Internal pitems ->
                                                                  ((<> nth List type pair_t) pitem_index pitems)
                                                                  (Just bitem
                                                                    (letin ((* ntr ntr))
                                                                      (right
                                                                       ;; helper to signal underflow
                                                                       (branch
                                                                        ((<> insertAt List type pair_t) items bitem
                                                                         (match (cmp (match bitem
                                                                                       ((\, key) key)
                                                                                       (default skey))
                                                                                     (match items
                                                                                       (* Cons (\, key) key)
                                                                                       (default skey)))
                                                                           (LT 0)
                                                                           (default items_len)))
                                                                        (((<> fmap List Rc type) (<> clone Rc type)) children)))))
                                                                  (default (left ((<> type ERR_CANT_BORROW) "parent borrow 2"))))
                                                               (default (left ((<> type ERR_CANT_BORROW) "parent borrow 1"))))
                                                         ;; no parent
                                                         (default
                                                             (case (== items_len 0)
                                                                   (match children
                                                                     ;; shrink
                                                                     (* Cons head -># ((<> clone Rc type) head)
                                                                        (dead (left ((<> type ERR_CANT_BORROW) "parent borrow 3")))
                                                                        (= chtr * default (letin ((* ntr ntr))
                                                                                            (right chtr))))
                                                                     (default result))
                                                                   otherwise result))))))
                                      (default result))
                               (default result))))
                        
                        (warn!
                            (format #t "*** deleteInternal underflow:\n")
                          (io rs (Right tr (show tr)))
                          (putchar #\Newline))

                        rs)))
              ) ; deleteInternal

        ;; delete from a leaf
        (func deleteLeaf (((<> List type pair_t) items)
                          ((<> List type pair_t) current)
                          (size_t index))
              (out (<> Either (<> type Error) type))

              (warn!
                  (format #t "*** deleteLeaf:\n")
                (show items)
                (putchar #\Newline)
                (show current)
                (putchar #\Newline)
                (format #t "%ld" index)
                (putchar #\Newline))

              (return (match current
                        (* Cons (= head (\, key)) tail -> (cmp skey key)
                           (LT (left ((<> type ERR_NOT_FOUND) skey)))
                           
                           ;; case
                           (EQ (letin* ((result (right (leaf ((<> delete List type pair_t) items current)))))
                                       (io result (Right (when callback (callback head))))
                                       result))
                           
                           ;; case
                           (default (deleteLeaf items tail (+ index 1))))
                        
                        (default (left ((<> type ERR_NOT_FOUND) skey))))))
        
        (return 
         (letin* ((result
                   (match tree
                     (* Branch ~ Internal items children
                        (deleteInternal ((<> Just type) tree) items children ((<> Nothing (<> List type pair_t))) items 0))
                     (* Leaf items (deleteLeaf items items 0))
                     (default (left ((<> type ERR_INVALID_OBJECT)))))))
                 
                 (warn!
                     (format #t "*** deleteWPEND: ")
                   ($> sh-key stdout skey)
                   (putchar #\Newline)
                   (format #t "Parent item index: %ld, child index: %ld\n" pitem_index pchild_index)
                   (io result (Right tr (show tr)))
                   (putchar #\Newline))

                 result)) ; return
        ) ; deleteWithParent
  
  (impl-class (BTree type)
              (= Branch (<> Branch type)
                 ((<> List type pair_t) items)
                 ((<> List Rc type) children))
              (= Internal (<> Internal type)
                 ((<> List type pair_t) items)
                 ((<> List Rc type) children))
              (= Leaf (<> Leaf type)
                 ((<> List type pair_t) items))

              (func order ()
                    (out size_t)
                    (return m))
              
              (func insert ((type tree) (k skey) (v svalue))
                    (out (<> Either (<> type Error) type))
                    
                    (analyze-data!
                        (fprintf __h_stack_out "*** insert ")
                      ($> sh-key __h_stack_out skey))
                    
                    (debug!
                        (printf "\n*** insert ")
                      ($> sh-key stdout skey)
                      (putchar #\Newline))
                    
                    (when (< m 3) (return (left ((<> type ERR_INVALID_ORDER) m))))

                    ;; insert into an internal
                    (func insertInternal (((<> List type pair_t) items)
                                          ((<> List Rc type) children)
                                          ((<> List type pair_t) current)
                                          (size_t index))
                          (out (<> Either (<> type Error) type))
                          
                          (debug!
                              (printf "insertInternal %ld " index)
                            (show items)
                            (printf "\ninsertInternal current -> ")
                            (io ((<> head List type pair_t) current)
                              (Just cur ($> sh-item stdout cur))
                              (default (printf "Nil")))
                            (printf "\ninsertInternal children\n ")
                            (io children (* _ (putchar #\Space)))
                            (show children))
                          
                          (return (match current

                                    ;; checks against existing keys
                                    (* Cons (= head (\, key)) tail -> (cmp skey key) ; lower than
                                       
                                       (LT -> ((<> nth List Rc type) index children)
                                           ;; has child
                                           (Just child -> ((<> get Rc type) child)
                                                 (Just tr -> ((<> insert type) tr skey svalue)
                                                       (Right child_tree -> child_tree
                                                              ;; new Branch child
                                                              (* Branch child_items child_children -> child_items
                                                                 ;; join up the child
                                                                 ;; a child with only a single item which is produced by split
                                                                 (* Cons single_item (* Nil)
                                                                    ;; this error of dangle temp tree pointer was found by Cicili analyzer
                                                                    (letin ((* child_tree child_tree))
                                                                      (right
                                                                       (internal
                                                                        ((<> insert List type pair_t) items single_item current)
                                                                        (letin ((* r1 ((<> take List Rc type) index children))
                                                                                (* r2 ((<> drop List Rc type) (+ index 1) children))
                                                                                (* r3 ((<> append List Rc type) child_children r2))
                                                                                (* r4 ((<> append List Rc type) r1 r3)))
                                                                          (((<> fmap List Rc type) (<> clone Rc type)) r4))))))
                                                                 (default (left ((<> type ERR_INVALID_BRANCH) child_tree))))

                                                              ;; new Internal child
                                                              ;; join new child
                                                              (* Internal
                                                                 (right
                                                                  (internal
                                                                   ((<> copy List type pair_t) items)
                                                                   (letin ((* r1 ((<> take List Rc type) index children))
                                                                           (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                                           (* r3 ((<> drop List Rc type) (+ index 1) children))
                                                                           (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                                                           (* r5 ((<> push List Rc type) ((<> new Rc type) child_tree) r4)))
                                                                     ((<> append List Rc type) r2 r5)))))
                                                              
                                                              ;; new Leaf child
                                                              (default
                                                                  (right
                                                                   (internal
                                                                    ((<> copy List type pair_t) items)
                                                                    (letin ((* r1 ((<> take List Rc type) index children))
                                                                            (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                                            (* r3 ((<> drop List Rc type) (+ index 1) children))
                                                                            (* r4 (((<> fmap List Rc type) (<> clone Rc type)) r3))
                                                                            (* r5 ((<> push List Rc type) ((<> new Rc type) child_tree) r4)))
                                                                      ((<> append List Rc type) r2 r5))))))
                                                       
                                                       ;; propagate error
                                                       (= left default left))
                                                 ;; on dead child pointer
                                                 (default (left ((<> type ERR_ACCESS_DEAD_CHILD) head index))))

                                           ;; no child
                                           (default (right
                                                     (leaf
                                                      ((<> insert List type pair_t)
                                                       items (cast (<> type pair_t) '{ skey svalue }) current)))))
                                       
                                       ;; case
                                       (EQ (left ((<> type ERR_UNIQUE_KEY) head))) ; key exists

                                       ;; case
                                       (default (insertInternal items children tail (+ index 1)))) ; greater than
                                    
                                    ;; no any key (item) exists
                                    (default (match ((<> nth List Rc type) index children)
                                               
                                               ;; has d+1 child
                                               (Just child -> ((<> get Rc type) child) 
                                                     (Just tr -> ((<> insert type) tr skey svalue)
                                                           (Right child_tree -> child_tree
                                                                  ;; new Branch child
                                                                  (* Branch child_items child_children -> child_items
                                                                     ;; join up the child
                                                                     ;; a child with only a single item which is produced by split
                                                                     (* Cons single_item (* Nil)
                                                                        ;; this error of dangle temp tree pointer was found by Cicili analyzer
                                                                        (letin ((* child_tree child_tree))
                                                                          (right
                                                                           (internal
                                                                            ((<> insert List type pair_t) items single_item current)
                                                                            (letin ((* r1 ((<> take List Rc type) index children))
                                                                                    (* r2 ((<> drop List Rc type) (+ index 1) children))
                                                                                    (* r3 ((<> append List Rc type) child_children r2))
                                                                                    (* r4 ((<> append List Rc type) r1 r3)))
                                                                              (((<> fmap List Rc type) (<> clone Rc type)) r4))))))
                                                                     (default (left ((<> type ERR_INVALID_BRANCH) child_tree))))
                                                                  
                                                                  ;; new Internal child
                                                                  ;; join new child
                                                                  (* Internal
                                                                     (right
                                                                      (internal
                                                                       ((<> copy List type pair_t) items)
                                                                       (letin ((* r1 ((<> take List Rc type) index children))
                                                                               (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                                               (* r3 ((<> wrap List Rc type) ((<> new Rc type) child_tree))))
                                                                         ((<> append List Rc type) r2 r3)))))

                                                                  ;; new Leaf child
                                                                  (default
                                                                      (right
                                                                       (internal
                                                                        ((<> copy List type pair_t) items)
                                                                        (letin ((* r1 ((<> take List Rc type) index children))
                                                                                (* r2 (((<> fmap List Rc type) (<> clone Rc type)) r1))
                                                                                (* r3 ((<> wrap List Rc type) ((<> new Rc type) child_tree))))
                                                                          ((<> append List Rc type) r2 r3))))))
                                                           
                                                           ;; propagate error
                                                           (= left default left))
                                                     ;; on dead child pointer
                                                     (default (left ((<> type ERR_ACCESS_DEAD_CHILD) (cast (<> type pair_t) '{ }) index))))

                                               ;; no d+1 child
                                               (default (right
                                                         (leaf
                                                          (letin ((* r1 ((<> wrap List type pair_t) (cast (<> type pair_t) '{ skey svalue }))))
                                                            ((<> append List type pair_t) items r1)))))
                                               ))))
                          ) ; insertInternal

                    ;; insert into a leaf
                    (func insertLeaf (((<> List type pair_t) items)
                                      ((<> List type pair_t) current)
                                      (size_t index))
                          (out (<> Either (<> type Error) type))

                          (debug!
                              (printf "insertLeaf %ld " index)
                            (show items)
                            (printf "\ninsertLeaf current -> ")
                            (io ((<> head List type pair_t) current)
                              (Just cur ($> sh-item stdout cur))
                              (default (printf "Nil")))
                            (putchar #\Newline))
                          
                          ;; insert_
                          (return (match current

                                    ;; checks against existing keys
                                    (* Cons (= head (\, key)) tail -> (cmp skey key) ; lower than
                                       (LT (right (leaf ((<> insert List type pair_t) items (cast (<> type pair_t) '{ skey svalue }) current))))
                                       
                                       ;; case
                                       (EQ (left ((<> type ERR_UNIQUE_KEY) head))) ; key exists

                                       ;; case
                                       (default (insertLeaf items tail (+ index 1)))) ; greater than
                                    
                                    ;; no any key (item) exists
                                    (default (right (leaf (letin ((* r1 ((<> wrap List type pair_t) (cast (<> type pair_t) '{ skey svalue }))))
                                                            ((<> append List type pair_t) items r1)))))))
                          ) ; insertLeaf
                    
                    ;; insert
                    ;; checks for overflow
                    (return (match tree
                              (* Branch ~ Internal items children
                                 (match (insertInternal items children items 0)
                                   (Right tr (right ((<> split type) tr)))
                                   (= left default left)))
                              (* Leaf items
                                 (match (insertLeaf items items 0)
                                   (Right tr (right ((<> split type) tr)))
                                   (= left default left)))
                              (default (left ((<> type ERR_INVALID_OBJECT))))))
                    ) ; insert
              
              
              (func search ((type tree) (k skey))
                    (out (<> Maybe type pair_t))

                    (func searchInternal (((<> List Rc type) children)
                                          ((<> List type pair_t) current)
                                          (size_t index))
                          (out (<> Maybe type pair_t))
                          
                          (return (match current
                                    (* Cons (= head (\, key)) tail -> (cmp skey key)
                                       (LT -> ((<> nth List Rc type) index children)
                                           (Just node -> ((<> get Rc type) node)
                                                 (Just tr ((<> search type) tr skey))
                                                 (default ((<> Nothing type pair_t))))
                                           (default ((<> Nothing type pair_t))))
                                       
                                       (EQ ((<> Just type pair_t) head))
                                       
                                       (default -> tail
                                                (* Nil -> ((<> nth List Rc type) (+ index 1) children)
                                                   (Just node -> ((<> get Rc type) node)
                                                         (Just tr ((<> search type) tr skey))
                                                         (default ((<> Nothing type pair_t))))
                                                   (default ((<> Nothing type pair_t))))
                                                (default (searchInternal children tail (+ index 1)))))
                                    (default ((<> Nothing type pair_t))))))

                    (func searchLeaf (((<> List type pair_t) current)
                                      (size_t index))
                          (out (<> Maybe type pair_t))
                          
                          (return (match current
                                    (* Cons (= head (\, key)) tail -> (cmp skey key)
                                       (EQ ((<> Just type pair_t) head))
                                       (default -> tail
                                                (* Nil ((<> Nothing type pair_t)))
                                                (default (searchLeaf tail (+ index 1)))))
                                    (default ((<> Nothing type pair_t))))))

                    (return (match tree
                              (* Branch ~ Internal items children (searchInternal children items 0))
                              (* Leaf items (searchLeaf items 0))
                              (default ((<> Nothing type pair_t))))))

              
              (func delete ((type tree) (k skey) (func callback (((<> type pair_t) item))))
                    (out (<> Either (<> type Error) type))

                    (return ((<> deleteWithParent type) ((<> Nothing type)) 0 0 tree skey callback)))
              
              
              (func min ((type tree))
                    (out (<> Maybe type pair_t))

                    (debug!
                        (format #t "min:\n")
                      (show tree)
                      (putchar #\Newline))

                    (auto) (decl) (func minLeaf (((<> List type pair_t) first)) (out (<> Maybe type pair_t)))

                    (func minInternal (((<> List Rc type) first))
                          (out (<> Maybe type pair_t))
                          (return (match first
                                    (* Cons head -> ((<> get Rc type) head)
                                       (Just child -> child
                                             (* Branch ~ Internal _ nchildren (minInternal nchildren))
                                             (* Leaf items (minLeaf items))
                                             (default ((<> Nothing type pair_t))))
                                       (default ((<> Nothing type pair_t))))
                                    (default ((<> Nothing type pair_t))))))

                    (func minLeaf (((<> List type pair_t) first))
                          (out (<> Maybe type pair_t))
                          (return (match first
                                    (* Cons head ((<> Just type pair_t) head))
                                    (default ((<> Nothing type pair_t))))))

                    (return (match tree
                              (* Branch ~ Internal _ children (minInternal children))
                              (* Leaf items (minLeaf items))
                              (default ((<> Nothing type pair_t))))))

              
              (func max ((type tree))
                    (out (<> Maybe type pair_t))

                    (debug!
                        (format #t "max:\n")
                      (show tree)
                      (putchar #\Newline))

                    (auto) (decl) (func maxLeaf (((<> List type pair_t) current)) (out (<> Maybe type pair_t)))
                    
                    (func maxInternal (((<> List Rc type) current))
                          (out (<> Maybe type pair_t))
                          (return (match current
                                    (* Cons head tail -> tail
                                       (* Nil -> ((<> get Rc type) head)
                                          (Just child -> child
                                                (* Branch ~ Internal _ nchildren (maxInternal nchildren))
                                                (* Leaf items (maxLeaf items))
                                                (default ((<> Nothing type pair_t))))
                                          (default ((<> Nothing type pair_t))))
                                       (default (maxInternal tail)))
                                    (default ((<> Nothing type pair_t))))))

                    (func maxLeaf (((<> List type pair_t) current))
                          (out (<> Maybe type pair_t))
                          (return (match current
                                    (* Cons head tail -> tail
                                       (* Nil ((<> Just type pair_t) head))
                                       (default (maxLeaf tail)))
                                    (default ((<> Nothing type pair_t))))))

                    (return (match tree
                              (* Branch ~ Internal _ children (maxInternal children))
                              (* Leaf items (maxLeaf items))
                              (default ((<> Nothing type pair_t))))))

              
              (func traverse ((type tree) (func callback (((<> type pair_t) item) (Bool hasNext))))
                    
                    (auto) (decl) (func traverseLeaf (((<> List type pair_t) current) (Bool hasNextLeaf)))
                    
                    (func traverseInternal (((<> List type pair_t) currentItem) ((<> List Rc type) currentChild))                   
                          (io currentChild
                            (* Cons wheadC tailC -> ((<> get Rc type) wheadC)
                               (Just headC (io tailC
                                             (* Cons (block (io headC
                                                              (* Branch ~ Internal items children (traverseInternal items children))
                                                              (* Leaf items (traverseLeaf items (True))))
                                                            (io currentItem
                                                              (* Cons headI tailI (block (callback headI (True))
                                                                                         (traverseInternal tailI tailC))))))
                                             (default (block (io headC
                                                               (* Branch ~ Internal items children (traverseInternal items children))
                                                               (* Leaf items (traverseLeaf items (False))))
                                                             (io currentItem
                                                               (* Cons headI tailI (block (callback headI (False))
                                                                                          (traverseInternal tailI tailC)))))))))))
                    
                    (func traverseLeaf (((<> List type pair_t) current) (Bool hasNextLeaf))
                          (io current
                            (* Cons head tail (block (callback head (match hasNextLeaf
                                                                      (True hasNextLeaf)
                                                                      (default (match tail (* Cons (True)) (default (False))))))
                                                     (traverseLeaf tail hasNextLeaf)))))

                    (io tree
                      (* Branch ~ Internal items children (traverseInternal items children))
                      (* Leaf items (traverseLeaf items (False)))))
              

              (func show ((CFile file) (type tree))
                    (out size_t)
                    
                    (auto) (decl) (func showTree ((int indent) (type tree)) (out size_t))

                    (func showChildren ((int indent) ((<> List Rc type) children))
                          (out size_t)
                          (return (match children
                                    (* Cons head tail
                                       (+ (match tail
                                            (* Cons (match ((<> get Rc type) head)
                                                      (Just tr (+ (showTree indent tr)
                                                                  (fprintf file "\n")))
                                                      (default 0)))
                                            (default (match ((<> get Rc type) head)
                                                       (Just tr (showTree indent tr))
                                                       (default 0))))
                                          (showChildren indent tail)))
                                    (default 0))))
                    
                    (func showTree ((int indent) (type tree))
                          (out size_t)
                          (return (+ (fprintf file "%d%*c" indent (* indent 2) #\Space)
                                     (match tree
                                       (* Branch ~ Internal items children
                                          (+ ((<> show (<> List type pair_t)) file items)
                                             (match children
                                               (* Cons (+ (fprintf file "\n")
                                                          (showChildren (+ indent 1) children)))
                                               (default 0))))
                                       (* Leaf items ((<> show (<> List type pair_t)) file items))
                                       (default 0)))))

                    (return (+ (showTree 1 tree)
                               (fprintf file "\n"))))

              (func pure ((k keys []) (v values []) (size_t len))
                    (out (<> Either (<> type Error) type))
                    
                    (return (letn ((type tree . #'((<> Leaf type) ((<> Nil type pair_t)))))
                              (for ((size_t i . 0)) (< i len) ((++ i))
                                   (io ((<> insert type) tree (nth i keys) (nth i values))
                                     (Right new_tree (block ((<> free type) (aof tree))
                                                            (set tree new_tree)))
                                     (= left default (block ((<> free type) (aof tree))
                                                            (return left)))))
                              (right tree))))
              
              (free ; free a B-Tree
                
                (func freeChildren (((<> List Rc type) children))
                      (io children
                        (* Cons head tail
                           (block
                             ((<> free Rc type) (aof head))
                             (freeChildren tail)))))
                
                (io this
                  (* Branch ~ Internal items children
                     (block
                       (syslog!
                           (printf "freeing Internal\n")
                         (show items)
                         (putchar #\Newline))
                       ((<> free List type pair_t) (aof items))
                       (freeChildren children)
                       (syslog! (printf "freeing Internal children list: %ld\n" ((<> len List Rc type) children)))
                       ((<> free List Rc type) (aof children))
                       (free this)))
                  (* Leaf items
                     (block
                       (syslog!
                           (printf "freeing Leaf\n")
                         (show items)
                         (putchar #\Newline))
                       ((<> free List type pair_t) (aof items))
                       (free this))))))

  ) ; impl-B-Tree

(generic import-B-Tree
  (type k v ctor)

  ;; dependencies
  (import-Either (<> type Error) type)
  (import-Maybe type)
  (import-Maybe (<> type pair_t))

  (import-List (<> List type pair_t) (<> type pair_t) (<> new List type pair_t))

  (import-Rc type)
  (import-List (<> List (<> Rc type)) (<> Rc type) (<> new List (<> Rc type)))

  (DEFMACRO ctor (&REST kvs)
    (WHEN (ODDP (LENGTH kvs)) (ERROR (FORMAT NIL "invalid Dynamic Object definition: ~A" kvs)))
    (LET ((ks NIL)
          (vs NIL))
      (LOOP FOR (key value) ON kvs BY #'CDDR DO (PROGN (PUSH key ks) (PUSH value vs)))
      (SETQ ks (NREVERSE ks))
      (SETQ vs (NREVERSE vs))
      `((<> pure type) (cast (k []) '( ,@ks )) (cast (v []) '( ,@vs)) ,(LENGTH ks))))

  ;; build a tree from two literal (compile-time) lists of keys and values
  (DEFMACRO (<> ctor FromLists) (keys values)
    (UNLESS (= (LENGTH keys) (LENGTH values))
      (ERROR (FORMAT NIL "FromLists: keys/values length mismatch: ~A / ~A" keys values)))
    `((<> pure type) (cast (k []) '( ,@keys )) (cast (v []) '( ,@values )) ,(LENGTH keys)))

  ) ; import-B-Tree
