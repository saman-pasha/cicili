;;;; Non-Persistent BTree

(import "./vector.cicili")

;; B-Tree
;; type: type name
;; k: key type
;; v: value type
;; m: order, The order of 3 will guarantee that nodes can be split or combined.
(generic decl-B-Tree
  (type k v)
  
  ;; forward btree class
  (typedef (struct (<> class type)) * type)

  ;; key-value tuple and the list
  (typedef (Tuple k v) (<> type pair_t))

  ;; Errors maybe raise during insertion or deletion
  (decl-data (BTreeError (<> type Error))
    (= ERR_INVALID_OBJECT    (<> type ERR_INVALID_OBJECT))
    (= ERR_INVALID_ORDER     (<> type ERR_INVALID_ORDER)     (size_t order))
    (= ERR_UNIQUE_KEY        (<> type ERR_UNIQUE_KEY)        ((<> type pair_t) item))
    (= ERR_NOT_FOUND         (<> type ERR_NOT_FOUND)         (k key))
    (= ERR_ACCESS_DEAD_CHILD (<> type ERR_ACCESS_DEAD_CHILD) ((<> type pair_t) item) (size_t index))
    (= ERR_INVALID_BRANCH    (<> type ERR_INVALID_BRANCH)    (type branch))
    (= ERR_CANT_BORROW       (<> type ERR_CANT_BORROW)       (char * reason))

    (func show (((<> type Error) error))))
  
  ;; dependencies
  (decl-Either (<> type Error) type)
  (decl-Maybe type)
  
  ;; items list
  (decl-Vector (<> Vector type pair_t) (<> type pair_t) NIL)
  ;; children list
  ;; list of Rcs wrap each child
  (decl-Rc type)
  (decl-Vector (<> Vector (<> Rc type)) (<> Rc type) NIL)
  ;; fmap over 'Rc child' and 'Vector Rc child'
  (decl-Functor-Vector (<> Vector (<> Rc type)) (<> Rc type) (<> Rc type))

  (decl-class (BTree type)
    (= Branch (<> Branch type) ; Branch is used when split occures
       ((<> Vector type pair_t) items)
       ((<> Vector Rc type) children))
    (= Internal (<> Internal type)
       ((<> Vector type pair_t) items)
       ((<> Vector Rc type) children))
    (= Leaf (<> Leaf type)
       ((<> Vector type pair_t) items))
    
    (func order    () (out size_t))
    (func insert   ((type tree) (k skey) (v svalue)) (out (<> Either (<> type Error) type)))
    (func search   ((type tree) (k skey)) (out (<> Maybe type pair_t)))
    (func delete   ((type tree) (k skey) (func callback (((<> type pair_t) item)))) (out (<> Either (<> type Error) type)))
    (func min      ((type tree)) (out (<> Maybe type pair_t)))
    (func max      ((type tree)) (out (<> Maybe type pair_t)))
    (func traverse ((type tree) (func callback (((<> type pair_t) * item) (Bool hasNext)))))
    (func show     ((CFile file) (type tree)) (out size_t))
    (func pure     ((k keys []) (v values []) (size_t len)) (out (<> Either (<> type Error) type)))
    ) ; decl-class
  
  ) ; decl-B-Tree

;; sh-key show a key of type k
;; sh-item show an item of type pair_t
(generic impl-B-Tree
  (type k v m cmp sh-key sh-item)

  (impl-data (BTreeError (<> type Error))
    (= ERR_INVALID_OBJECT    (<> type ERR_INVALID_OBJECT))
    (= ERR_INVALID_ORDER     (<> type ERR_INVALID_ORDER)     (size_t order))
    (= ERR_UNIQUE_KEY        (<> type ERR_UNIQUE_KEY)        ((<> type pair_t) item))
    (= ERR_NOT_FOUND         (<> type ERR_NOT_FOUND)         (k key))
    (= ERR_ACCESS_DEAD_CHILD (<> type ERR_ACCESS_DEAD_CHILD) ((<> type pair_t) item) (size_t index))
    (= ERR_INVALID_BRANCH    (<> type ERR_INVALID_BRANCH)    (type branch))
    (= ERR_CANT_BORROW       (<> type ERR_CANT_BORROW)       (char * reason))

    (func show (((<> type Error) error))
          (io error
            (ERR_INVALID_OBJECT (printf "invalid B-Tree object"))
            (ERR_INVALID_ORDER order (printf "invalid B-Tree order: %zu" order))
            (ERR_UNIQUE_KEY item (block (printf "unique key: ") ($> sh-item stdout item)))
            (ERR_NOT_FOUND key (block (printf "key not found: ") ($> sh-key stdout key)))
            (ERR_ACCESS_DEAD_CHILD item index (block (printf "dead child at index: %zu of item: " index) ($> sh-item stdout item)))
            (ERR_INVALID_BRANCH branch (block (printf "invalid branch: ") (show branch)))
            (ERR_CANT_BORROW reason (printf "borrow error: %s" reason))
            (default (printf "unknown error")))))
  
  ;; dependencies
  (impl-Either (<> type Error) type)
  (impl-Maybe type)
  
  (impl-Vector   (<> Vector type pair_t) (<> type pair_t) sh-item " " NIL NIL)
  (import-Vector (<> Vector type pair_t) (<> type pair_t) NIL (<> new Vector type pair_t))
               
  (impl-Rc type)
  (impl-Vector (<> Vector (<> Rc type)) (<> Rc type)
             (\\ -f -wChild (match ((<> get Rc type) -wChild)
                              (Just child ((<> show type) -f child))
                              (default 0)))
             " " NIL NIL)
  (import-Vector (<> Vector (<> Rc type)) (<> Rc type) NIL (<> new Vector Rc type))
  
  (impl-Functor-Vector (<> Vector (<> Rc type)) (<> Rc type) (<> Rc type))

  ;; private constants
  (var size_t (<> U type) . `m)
  (var size_t (<> L type) . `(CEILING m 2)) ; compile time calculation with ` or QUASIQUOTE inside generic

  ;; aliases
  (DEFMACRO branch   (-i -c) `((<> Branch   type) ,-i ,-c))
  (DEFMACRO internal (-i -c) `((<> Internal type) ,-i ,-c))
  (DEFMACRO leaf     (-i)    `((<> Leaf     type) ,-i))
  
  (lambda left  -l ((<> Left  (<> type Error) type) -l))
  (lambda right -r ((<> Right (<> type Error) type) -r))
  
  ;; private functions
  (func (<> split type) ((type tree))
        (out type)
        (return (match tree
                  (* Branch ~ Internal items children
                     ;; check for split
                     (case (>= ((<> len Vector type pair_t) items) (<> U type))
                           (letin ((* tree tree))
                             (branch
                                 ;; items
                                 ((<> wrap Vector type pair_t)
                                  (match ((<> nth Vector type pair_t) (- (<> L type) 1) items)
                                    (Just nitem nitem)
                                    (default (cast (<> type pair_t) '{ }))))
                               ;; children
                               ((<> new Vector Rc type)
                                (cast ((<> Rc type) []) '{
                                      ((<> new Rc type)
                                       (internal
                                        ((<> take Vector type pair_t) (- (<> L type) 1) items)
                                        (letin ((r1 ((<> take Vector Rc type) (<> L type) children)))
                                          (((<> fmap Vector Rc type) (<> clone Rc type)) r1))))
                                      ((<> new Rc type)
                                       (internal
                                        ((<> drop Vector type pair_t) (<> L type) items)
                                        (letin ((r1 ((<> drop Vector Rc type) (<> L type) children)))
                                          (((<> fmap Vector Rc type) (<> clone Rc type)) r1))))
                                      }) 2 )))
                           otherwise tree))
                  (* Leaf items
                     ;; check for split
                     (case (>= ((<> len Vector type pair_t) items) (<> U type))
                           ;; because split occures after new items added to leaf so the leaf has a new list of items
                           ;; this error of dangle temp tree pointer was found by Cicili analyzer
                           (letin ((* tree tree))
                             (branch
                                 ;; items
                                 ((<> wrap Vector type pair_t)
                                  (match ((<> nth Vector type pair_t) (- (<> L type) 1) items)
                                    (Just nitem nitem)
                                    (default (cast (<> type pair_t) '{ }))))
                               ;; children
                               ((<> new Vector Rc type)
                                (cast ((<> Rc type) []) '{
                                      ((<> new Rc type) (leaf ((<> take Vector type pair_t) (- (<> L type) 1) items)))
                                      ((<> new Rc type) (leaf ((<> drop Vector type pair_t) (<> L type) items)))
                                      }) 2 )))
                           otherwise tree))
                  (default tree)))
        ) ; split
  

  (func (<> splitForDelete type) ((type tree))
        (out type)
        (return (match tree
                  (* Branch ~ Internal items children
                     ;; check for split
                     (case (>= ((<> len Vector type pair_t) items) (<> U type))
                           (branch
                               ;; items
                               ((<> wrap Vector type pair_t)
                                (match ((<> nth Vector type pair_t) (- (<> L type) 1) items)
                                  (Just nitem nitem)
                                  (default (cast (<> type pair_t) '{ }))))
                             ;; children
                             ((<> new Vector Rc type)
                              (cast ((<> Rc type) []) '{
                                    ((<> new Rc type)
                                     (internal
                                      ((<> take Vector type pair_t) (- (<> L type) 1) items)
                                      (letin ((r1 ((<> take Vector Rc type) (<> L type) children)))
                                        (((<> fmap Vector Rc type) (<> clone Rc type)) r1))))
                                    ((<> new Rc type)
                                     (internal
                                      ((<> drop Vector type pair_t) (<> L type) items)
                                      (letin ((r1 ((<> drop Vector Rc type) (<> L type) children)))
                                        (((<> fmap Vector Rc type) (<> clone Rc type)) r1))))
                                    }) 2 ))
                           otherwise tree))
                  (* Leaf items
                     ;; check for split
                     (case (>= ((<> len Vector type pair_t) items) (<> U type))
                           ;; because split occures after new items added to leaf so the leaf has a new list of items
                           ;; this error of dangle temp tree pointer was found by Cicili analyzer
                           (branch
                               ;; items
                               ((<> wrap Vector type pair_t)
                                (match ((<> nth Vector type pair_t) (- (<> L type) 1) items)
                                  (Just nitem nitem)
                                  (default (cast (<> type pair_t) '{ }))))
                             ;; children
                             ((<> new Vector Rc type)
                              (cast ((<> Rc type) []) '{
                                    ((<> new Rc type) (leaf ((<> take Vector type pair_t) (- (<> L type) 1) items)))
                                    ((<> new Rc type) (leaf ((<> drop Vector type pair_t) (<> L type) items)))
                                    }) 2 ))
                           otherwise tree))
                  (default tree)))
        ) ; splitForDelete
  

  ;; merge with parent if needed
  (func (<> mergeUp type) (((<> Vector type pair_t) items)
                           ((<> Vector Rc type) children)
                           (size_t pitem_index)
                           (size_t pchild_index)
                           ((<> Vector type pair_t) left_items)
                           ((<> Vector Rc type) left_children)
                           ((<> Vector type pair_t) right_items)
                           ((<> Vector Rc type) right_children))
        (out type)

        (warn!
          (format #t "mergeUp:\n")
          (show items)
          (putchar #\Newline)
          (format #t "children:\n ")
          (show children)
          (format #t "left children:\n ")
          (show left_children)
          (format #t "right children:\n ")
          (show right_children)
          (format #t "indx: %ld, %ld\n" pitem_index pchild_index))

        (return
          (letin* ((merged (internal
                            ((<> append Vector type pair_t) left_items right_items)
                            (letin ((r1 ((<> append Vector Rc type) left_children right_children)))
                              (((<> fmap Vector Rc type) (<> clone Rc type)) r1)))))
            (match ((<> splitForDelete type) merged)
              ;; splitted after merge
              (= tmp_child * Branch tmp_items tmp_children
                 (match ((<> head Vector type pair_t) tmp_items)
                   (Just head
                     (letin ((* merged merged)
                             (* tmp_child tmp_child))
                       (internal
                        ((<> replaceAt Vector type pair_t) items head pitem_index)
                        (letin ((r1 ((<> deleteAt Vector Rc type) children pchild_index))
                                (r2 ((<> take Vector Rc type) pchild_index r1))
                                (r3 ((<> drop Vector Rc type) (+ pchild_index 1) r1))
                                (r4 ((<> append Vector Rc type) tmp_children r3))
                                (r5 ((<> append Vector Rc type) r2 r4)))
                          (((<> fmap Vector Rc type) (<> clone Rc type)) r5)))))
                   (default ((<> Leaf type) ((<> pure Vector type pair_t) (- m 1))))))
              (* Internal ; tmp_items tmp_children
                 (internal
                  ((<> deleteAt Vector type pair_t) items pitem_index)
                  (letin ((r1 ((<> deleteAt Vector Rc type) children pchild_index))
                          (r2 ((<> new Rc type) merged))
                          (r3 ((<> replaceAt Vector Rc type) r1 r2 pchild_index)))
                    (((<> fmap Vector Rc type) (<> clone Rc type)) r3))))
              ;; never be happened
              (default ((<> Leaf type) ((<> pure Vector type pair_t) (- m 1))))))))

  
  (decl) (func (<> deleteWithParent type) (((<> Maybe type) wparent)
                                           (size_t pitem_index)
                                           (size_t pchild_index)
                                           (type tree)
                                           (k skey)
                                           (func callback (((<> type pair_t) item))))
               (out (<> Either (<> type Error) type)))

  
  (func (<> borrowLeaf type) (((<> Vector type pair_t) items)
                              ((<> Vector Rc type) children)
                              ((<> Maybe (<> Vector type pair_t)) wleft)
                              ((<> Vector type pair_t ptr_t) current)
                              (size_t index)
                              (type nchild)
                              (func callback (((<> type pair_t) item))))
        (out (<> Either (<> type Error) type))
        
        (warn!
          (format #t "*** borrowLeaf:\n")
          (format #t "items:\n")
          (show items)
          (putchar #\Newline)
          (format #t "children:\n")
          (show children)
          (putchar #\Newline)
          (io wleft
            (Just left
              (block (format #t "left:\n")
                     (show left)
                     (putchar #\Newline))))
          (show current)
          (putchar #\Newline)
          (format #t "%ld" index)
          (putchar #\Newline)
          (io nchild
            (* Branch ~ Internal ~ Leaf child_items
               (block (show child_items)
                      (putchar #\Newline)))))

        ;; borrow from right child
        (func borrowRight (((<> Vector type pair_t) child_items))
              (out (<> Either (<> type Error) type))

              (warn! (format #t "*** borrowLeafRight\n"))
              
              (return
                (match ((<> nth Vector Rc type) (+ index 1) children)
                  (Just right_child_rc -># right_child_rc
                        (dead (left ((<> type ERR_CANT_BORROW) "borrowRight 3")))

                        ;; right child is Leaf
                        (* Leaf right_child_items
                           (case (== ((<> hasLen Vector type pair_t) right_child_items (<> L type)) (<> L type))
                                 (match ((<> head Vector type pair_t) right_child_items)
                                   (Just first_item
                                      (right
                                       (internal
                                        ((<> replaceAt Vector type pair_t) items first_item index)
                                        (letin ((r1 ((<> take Vector Rc type) index children))
                                                (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                (r3 ((<> drop Vector Rc type) (+ index 2) children))
                                                (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                (r7 ((<> new Vector Rc type)
                                                       (cast ((<> Rc type) []) '{
                                                             ((<> new Rc type)
                                                              (leaf ((<> push Vector type pair_t) child_items (cof current))))
                                                             ((<> new Rc type)
                                                              (leaf ((<> tail Vector type pair_t) right_child_items)))
                                                             }) 2 ))
                                                (r6 ((<> append Vector Rc type) r7 r4)))
                                          ((<> append Vector Rc type) r2 r6)))))
                                   (default (left ((<> type ERR_CANT_BORROW) "borrowRight R1"))))
                                 ;; merge
                                 otherwise (match (cof current)
                                             (Just head
                                               (right
                                                 (internal
                                                  ((<> deleteAt Vector type pair_t) items index)
                                                  (letin ((r1 ((<> take Vector Rc type) index children))
                                                          (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                          (r3 ((<> drop Vector Rc type) (+ index 2) children))
                                                          (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                          (r6 ((<> push Vector type pair_t) child_items (cof current)))
                                                          (r8 ((<> push Vector Rc type)
                                                                 ((<> new Rc type)
                                                                  (leaf ((<> append Vector type pair_t) r6 right_child_items)))
                                                                 r4)))
                                                    ((<> append Vector Rc type) r2 r8)))))
                                             (default (left ((<> type ERR_CANT_BORROW) "borrowRight R2"))))))

                        (default (left ((<> type ERR_CANT_BORROW) "borrowRight 3"))))
                  (default (left ((<> type ERR_CANT_BORROW) "borrowRight 4"))))))
        
        ;; borrow from left child
        (func borrowLeft (((<> Vector type pair_t) child_items))
              (out (<> Either (<> type Error) type))

              (warn! (format #t "*** borrowLeafLeft\n"))

              (return
                (match wleft
                  ;; left child exists
                  (Just left -> ((<> head Vector type pair_t) left)
                        (Just left_item -> ((<> nth Vector Rc type) (- index 1) children)
                              (Just left_child_rc -># left_child_rc
                                    (dead (left ((<> type ERR_CANT_BORROW) "borrowLeft 4")))
                                    
                                    ;; left child is Leaf 
                                    (* Leaf left_child_items
                                       (case (== ((<> hasLen Vector type pair_t) left_child_items (<> L type)) (<> L type))
                                             (match ((<> last Vector type pair_t) left_child_items)
                                               (Just last_item
                                                 (right
                                                  (internal
                                                   ((<> replaceAt Vector type pair_t) items last_item (- index 1))
                                                   ;; letin will free all temp lists
                                                   (letin ((r1 ((<> take Vector Rc type) (- index 1) children))
                                                           (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                           (r3 ((<> drop Vector Rc type) (+ index 1) children))
                                                           (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                           (r5 ((<> new Vector Rc type)
                                                                (cast ((<> Rc type) []) '{
                                                                      ((<> new Rc type)
                                                                       (leaf ((<> init Vector type pair_t) left_child_items)))
                                                                      ((<> new Rc type)
                                                                       (leaf ((<> push Vector type pair_t) left_item child_items)))
                                                                      }) 2 ))
                                                           (r7 ((<> append Vector Rc type) r5 r4)))
                                                     ((<> append Vector Rc type) r2 r7)))))
                                               (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 2"))))
                                             ;; merge
                                             otherwise (match (borrowRight child_items)
                                                         ;; no right child
                                                         (Left (right
                                                                (internal
                                                                 ((<> deleteAt Vector type pair_t) items (- index 1))
                                                                 (letin ((r1 ((<> take Vector Rc type) (- index 1) children))
                                                                         (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                                         (r3 ((<> drop Vector Rc type) (+ index 1) children))
                                                                         (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                                         (r8 ((<> wrap Vector type pair_t) left_item))
                                                                         (r5 ((<> append Vector type pair_t) left_child_items r8))
                                                                         (r7 ((<> push Vector Rc type)
                                                                              ((<> new Rc type)
                                                                               (leaf ((<> append Vector type pair_t) r5 child_items)))
                                                                              r4)))
                                                                   ((<> append Vector Rc type) r2 r7)))))
                                                         (= right default right))))

                                    (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 3"))))
                              (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 5"))))
                        (default (left ((<> type ERR_CANT_BORROW) "borrowLeft 6"))))

                  ;; no left, check for right child existance
                  (default (borrowRight child_items)))))

        (return
          (letin* ((result
                    (match nchild
                      (* Branch ~ Internal ~ Leaf child_items
                         ;; has got minimum keys
                         (case (== ((<> hasLen Vector type pair_t) child_items (- (<> L type) 1)) (- (<> L type) 1))
                               (right
                                (internal
                                 ((<> copy Vector type pair_t) items)
                                 (letin ((r1 ((<> new Rc type) nchild))
                                         (r2 ((<> replaceAt Vector Rc type) children r1 index)))
                                   (((<> fmap Vector Rc type) (<> clone Rc type)) r2))))
                               ;; hasn't got minimum keys
                               otherwise (letin ((* nchild nchild))
                                           (borrowLeft child_items))))
                      (default (left ((<> type ERR_CANT_BORROW) "borrow 1"))))))

            (warn!
              (format #t "*** borrowLeafEND:\n")
              (io result (Right tr (show tr)))
              (putchar #\Newline))

            result))
        
        ) ; borrowLeaf
  
  ;; borrow over internal key deletion
  (func (<> borrowInternal type) (((<> Maybe type) wtree)
                                  ((<> Vector type pair_t) items)
                                  ((<> Vector Rc type) children)
                                  ((<> Vector type pair_t ptr_t) current)
                                  (size_t index)
                                  (func callback (((<> type pair_t) item))))
        (out (<> Either (<> type Error) type))

        (warn!
          (format #t "*** borrowInternal:\n")
          (io wtree (Just tr (block (format #t "tree:\n")
                                    (show tr)
                                    (putchar #\Newline))))
          (format #t "items:\n")
          (show items)
          (putchar #\Newline)
          (format #t "children:\n ")
          (show children)
          (putchar #\Newline)
          (show current)
          (putchar #\Newline)
          (format #t "%ld" index)
          (putchar #\Newline))

        ;; borrow from right child (internal)
        (func borrowRightInternal (((<> Vector type pair_t) left_child_items)
                                   ((<> Vector Rc type) left_child_children))
              (out (<> Either (<> type Error) type))

              (warn!
                (format #t "*** borrowRightInternal:\n")
                (show left_child_items)
                (putchar #\Newline)
                (show left_child_children)
                (putchar #\Newline))
              
              (return
                (match ((<> nth Vector Rc type) (+ index 1) children)
                  (Just right_child_rc -> ((<> get Rc type) right_child_rc)
                        (Just right_child -> right_child
                              (* Branch ~ Internal right_child_items right_child_children
                                 (case (== ((<> hasLen Vector type pair_t) right_child_items (<> L type)) (<> L type))
                                       (match ((<> min type) right_child)
                                         (Just (= min (\, min_key)) -> ((<> delete type) right_child min_key nil)
                                               ;; new Internal child
                                               (Right nchild
                                                      (right
                                                       (internal
                                                        ((<> replaceAt Vector type pair_t) items min index)
                                                        (letin ((r1 ((<> new Rc type) nchild))
                                                                (r2 ((<> replaceAt Vector Rc type) children r1 (+ index 1))))
                                                          (((<> fmap Vector Rc type) (<> clone Rc type)) r2)))))
                                               (= left default left))
                                         (default (left ((<> type ERR_CANT_BORROW) "borrowRI 1"))))
                                       
                                       ;; merge
                                       otherwise (match (cof current)
                                                   (Just (= current_item (\, current_key))
                                                      (letin ((r1 ((<> push Vector type pair_t) current_item right_child_items))
                                                              (r2 ((<> append Vector Rc type) left_child_children right_child_children))

                                                              (* r4 (internal ; temp combined internal
                                                                     ((<> append Vector type pair_t) left_child_items r1)
                                                                     (((<> fmap Vector Rc type) (<> clone Rc type)) r2)))
                                                              
                                                              (r5 ((<> take Vector Rc type) index children))
                                                              (r7 ((<> drop Vector Rc type) (+ index 2) children)))
                                                        (match ((<> delete type) r4 current_key nil)
                                                          (Right ntree -> ((<> splitForDelete type) ntree)
                                                                 ;; was needed to split after combination (overflow)
                                                                 (= tmp_result * Branch branch_items branch_children ->
                                                                    ((<> head Vector type pair_t) branch_items)
                                                                    (Just branch_head
                                                                      (letin ((* ntree ntree)
                                                                              (* tmp_result tmp_result))
                                                                        (right
                                                                         (internal
                                                                          ((<> replaceAt Vector type pair_t) items branch_head index)
                                                                          (letin ((r10 ((<> append Vector Rc type) branch_children r7))
                                                                                  (r11 ((<> append Vector Rc type) r5 r10)))
                                                                            (((<> fmap Vector Rc type) (<> clone Rc type)) r11))))))
                                                                    (default (left ((<> type ERR_CANT_BORROW) "borrowRI 2"))))
                                                                 (* Internal
                                                                    (right
                                                                     (internal
                                                                      ((<> deleteAt Vector type pair_t) items index)
                                                                      (letin ((r9  ((<> new Rc type) ntree))
                                                                              (r10 ((<> push Vector Rc type) r9 r7))
                                                                              (r11 ((<> append Vector Rc type) r5 r10)))
                                                                        (((<> fmap Vector Rc type) (<> clone Rc type)) r11)))))
                                                                 (default (left ((<> type ERR_CANT_BORROW) "borrowRI 3"))))
                                                          (= left default left))))
                                                   (default (left ((<> type ERR_CANT_BORROW) "borrowRI 4"))))))
                              
                              ;; child is Leaf
                              (default (left ((<> type ERR_CANT_BORROW) "borrowRI 5"))))
                        (default (left ((<> type ERR_CANT_BORROW) "borrowRI 6")))) ; Dead Child
                  (default (left ((<> type ERR_CANT_BORROW) "borrowRI 7"))))) ; No Child
              ) ; borrowRightInternal

        ;; borrow from right child (leaf)
        (func borrowRightLeaf (((<> Vector type pair_t) left_child_items))
              (out (<> Either (<> type Error) type))

              (warn!
                (format #t "*** borrowRightLeaf: ")
                (show left_child_items)
                (putchar #\Newline))
              
              (return
                (match ((<> nth Vector Rc type) (+ index 1) children)
                  (Just right_child_rc -> ((<> get Rc type) right_child_rc)
                        (Just right_child -> right_child
                              (* Leaf right_child_items
                                 (case (== ((<> hasLen Vector type pair_t) right_child_items (<> L type)) (<> L type))
                                       (match ((<> min type) right_child)
                                         (Just (= min (\, min_key)) -> ((<> delete type) right_child min_key nil)
                                               ;; new Internal child
                                               (Right nchild
                                                      (right
                                                       (internal
                                                        ((<> replaceAt Vector type pair_t) items min index)
                                                        (letin ((r1 ((<> new Rc type) nchild))
                                                                (r2 ((<> replaceAt Vector Rc type) children r1 (+ index 1))))
                                                          (((<> fmap Vector Rc type) (<> clone Rc type)) r2)))))
                                               (= left default left))
                                         (default (left ((<> type ERR_CANT_BORROW) "borrowRI 8"))))
                                       ;; merge parent down
                                       otherwise (right
                                                  (internal
                                                   ((<> deleteAt Vector type pair_t) items index) ; check length of items
                                                   (letin ((r1 ((<> take Vector Rc type) index children))
                                                           (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                           (r3 ((<> drop Vector Rc type) (+ index 2) children))
                                                           (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                           (r5 ((<> push Vector Rc type)
                                                                ((<> new Rc type)
                                                                 (leaf ((<> append Vector type pair_t) left_child_items right_child_items)))
                                                                r4)))
                                                     ((<> append Vector Rc type) r2 r5))))))
                              ;; child is Internal
                              (default (left ((<> type ERR_CANT_BORROW) "borrowRI 9"))))
                        (default (left ((<> type ERR_CANT_BORROW) "borrowRI 10")))) ; Dead Child
                  (default (left ((<> type ERR_CANT_BORROW) "borrowRI 11")))))) ; No Child

        ;; borrow from left child
        (return
          (letin* ((result
                    (match ((<> nth Vector Rc type) index children)
                      (Just left_child_rc -> ((<> get Rc type) left_child_rc)
                            (Just left_child -> left_child 
                                  (* Branch ~ Internal left_child_items left_child_children
                                     (case (== ((<> hasLen Vector type pair_t) left_child_items (<> L type)) (<> L type))
                                           (match ((<> max type) left_child)
                                             (Just (= max (\, max_key)) -> ((<> delete type) left_child max_key nil)
                                                   ;; new Internal child
                                                   (Right nchild
                                                          (right
                                                           (internal
                                                            ((<> replaceAt Vector type pair_t) items max index)
                                                            (letin ((r1 ((<> new Rc type) nchild))
                                                                    (r2 ((<> replaceAt Vector Rc type) children r1 index)))
                                                              (((<> fmap Vector Rc type) (<> clone Rc type)) r2)))))
                                                   (= left default left))
                                             (default (left ((<> type ERR_CANT_BORROW) "borrowRI 12"))))
                                           ;; try right
                                           otherwise (borrowRightInternal left_child_items left_child_children)))
                                  (* Leaf left_child_items
                                     (case (== ((<> hasLen Vector type pair_t) left_child_items (<> L type)) (<> L type))
                                           (match ((<> max type) left_child)
                                             (Just (= max (\, max_key)) -> ((<> delete type) left_child max_key nil)
                                                   ;; new Internal child
                                                   (Right nchild
                                                          (right
                                                           (internal
                                                            ((<> replaceAt Vector type pair_t) items max index)
                                                            (letin ((r1 ((<> new Rc type) nchild))
                                                                    (r2 ((<> replaceAt Vector Rc type) children r1 index)))
                                                              (((<> fmap Vector Rc type) (<> clone Rc type)) r2)))))
                                                   (= left default left))
                                             (default (left ((<> type ERR_CANT_BORROW) "borrowRI 13"))))
                                           ;; try right
                                           otherwise (borrowRightLeaf left_child_items)))
                                  (default (left ((<> type ERR_CANT_BORROW) "borrowRI 14"))))
                            (default (left ((<> type ERR_CANT_BORROW) "borrowRI 15")))) ; Dead child
                      (default (left ((<> type ERR_CANT_BORROW) "borrowRI 16")))))) ; No Child

            (warn!
              (format #t "*** borrowInternalEND:\n")
              (io result (Right tr (show tr)))
              (putchar #\Newline))

            result))
        
        ) ; borrowInternal

  (func (<> deleteWithParent type) (((<> Maybe type) wparent)
                                    (size_t pitem_index)
                                    (size_t pchild_index)
                                    (type tree)
                                    (k skey)
                                    (func callback (((<> type pair_t) item))))
        (out (<> Either (<> type Error) type))
        
        (analyze-data!
          (fprintf __h_stack_out "*** deleteWithParent: ")
          ($> sh-key __h_stack_out skey))

        (warn!
          (format #t "*** deleteWP: ")
          ($> sh-key stdout skey)
          (putchar #\Newline)
          (format #t "Parent item index: %ld, child index: %ld\n" pitem_index pchild_index))
        
        ;; delete from an internal
        (func deleteInternal (((<> Maybe type) tree)
                              ((<> Vector type pair_t) items)
                              ((<> Vector Rc type) children)
                              ((<> Maybe (<> Vector type pair_t)) wleft)
                              ((<> Vector type pair_t ptr_t) current)
                              (size_t index))
              (out (<> Either (<> type Error) type))

              (analyze-data! ((<> show Vector type pair_t) __h_stack_out current))
              
              (warn!
                (format #t "*** deleteInternal:\n")
                (show items)
                (putchar #\Newline)
                (format #t "children:\n ")
                (show children)
                (putchar #\Newline)
                (io wleft
                  (Just left
                    (block (format #t "left:\n")
                           (show left)
                           (putchar #\Newline))))
                (format #t "current:\n")
                (show current)
                (putchar #\Newline)
                (format #t "index: %ld" index)
                (putchar #\Newline))

              (return
                (letin*
                    ((result
                      (match (cof current)

                        ;; checks against existing keys
                        (Just (= head (\, key)) tail -> (cmp skey key)
                           (LT -> ((<> nth Vector Rc type) index children) ; lower than
                               ;; using -> inner match application operator to prevent inner match keyword repeatition
                               ;; child exists
                               (Just child -> ((<> get Rc type) child)
                                     ;; if child tree pointer alive
                                     (Just tr -> tr
                                           (* Branch ~ Internal -> ((<> deleteWithParent type) tree
                                                                    (? (> index 0) (- index 1) index)
                                                                    index tr skey callback)
                                              (Right nchild -> nchild
                                                     (* Branch child_items child_children
                                                        (match ((<> nth Vector Rc type) (- index 1) children)
                                                          ;; merge left
                                                          (Just wleft -># wleft
                                                                (dead (left ((<> type ERR_CANT_BORROW) "BWPL1")))
                                                                (* Branch ~ Internal left_items left_children
                                                                   (letin ((* nchild nchild))
                                                                     (right
                                                                      ((<> mergeUp type)
                                                                       items children
                                                                       (? (> index 0) (- index 1) index) (? (> index 0) (- index 1) index)
                                                                       left_items left_children
                                                                       child_items child_children))))
                                                                (default (left ((<> type ERR_CANT_BORROW) "BWPL1-1"))))
                                                          ;; merge right
                                                          (default -> ((<> nth Vector Rc type) (+ index 1) children)
                                                                   (Just wright -># wright
                                                                         (dead (left ((<> type ERR_CANT_BORROW) "BWPR2")))
                                                                         (* Branch ~ Internal right_items right_children
                                                                            (letin ((* nchild nchild))
                                                                              (right
                                                                               ((<> mergeUp type)
                                                                                items children
                                                                                (? (> index 0) (- index 1) index) index
                                                                                child_items child_children
                                                                                right_items right_children))))
                                                                         (default (left ((<> type ERR_CANT_BORROW) "BWPR2-1"))))
                                                                   (default (left ((<> type ERR_CANT_BORROW) "BWPR1"))))))
                                                     (default (right
                                                               (internal
                                                                ((<> copy Vector type pair_t) items)
                                                                (letin ((r1   ((<> new Rc type) nchild))
                                                                        (r2 ((<> replaceAt Vector Rc type) children r1 index)))
                                                                  (((<> fmap Vector Rc type) (<> clone Rc type)) r2))))))
                                              (= left default left))
                                           (default -> ((<> deleteWithParent type) tree
                                                        (? (> index 0) (- index 1) index)
                                                        index tr skey callback)
                                                    ;; successful deletion in child
                                                    (Right nchild
                                                           ((<> borrowLeaf type) items children wleft current index nchild callback))
                                                    ;; propagate error
                                                    (= left default left)))
                                     (default (left ((<> type ERR_ACCESS_DEAD_CHILD) head index))))
                               (default (left ((<> type ERR_NOT_FOUND) skey))))
                           
                           ;; case           ; equal
                           (EQ (letin* ((result ((<> borrowInternal type) tree items children current index callback)))
                                 (io result (Right (when callback (callback head))))
                                 result))
                           
                           ;; case           ; greater than
                           (default (deleteInternal tree items children ((<> Just (<> Vector type pair_t ptr_t)) current) tail (+ index 1))))
                        
                        ;; no any key (item) exists
                        (default (match ((<> nth Vector Rc type) index children)
                                   ;; using -> inner match application operator to prevent inner match keyword repeatition
                                   ;; m+1 child exists
                                   (Just child -> ((<> get Rc type) child)
                                         ;; if child tree pointer alive
                                         (Just tr -> tr
                                               ;; item is deleted
                                               (* Branch ~ Internal -> 
                                                  ((<> deleteWithParent type) tree (- index 1) index tr skey callback)
                                                  (Right nchild -> nchild 
                                                         (* Branch child_items child_children
                                                            (match ((<> nth Vector Rc type) (- index 1) children)
                                                              ;; merge left
                                                              (Just wleft -># wleft
                                                                    (dead (left ((<> type ERR_CANT_BORROW) "BWPL11")))
                                                                    (* Branch ~ Internal left_items left_children
                                                                       (letin ((* nchild nchild))
                                                                         (right
                                                                          ((<> mergeUp type)
                                                                           items children
                                                                           (- index 1) (- index 1)
                                                                           left_items left_children
                                                                           child_items child_children))))
                                                                    (default (left ((<> type ERR_CANT_BORROW) "BWPL111"))))
                                                              ;; merge right
                                                              (default -> ((<> nth Vector Rc type) (+ index 1) children)
                                                                       (Just wright -># wright
                                                                             (dead (left ((<> type ERR_CANT_BORROW) "BWPR22")))
                                                                             (* Branch ~ Internal right_items right_children
                                                                                (letin ((* nchild nchild))
                                                                                  (right
                                                                                   ((<> mergeUp type)
                                                                                    items children
                                                                                    (- index 1) index
                                                                                    child_items child_children
                                                                                    right_items right_children))))
                                                                             (default (left ((<> type ERR_CANT_BORROW) "BWPR222"))))
                                                                       (default (left ((<> type ERR_CANT_BORROW) "BWPR221"))))))
                                                         (default (right
                                                                   (internal
                                                                    ((<> copy Vector type pair_t) items)
                                                                    (letin ((r1   ((<> new Rc type) nchild))
                                                                            (r2 ((<> replaceAt Vector Rc type) children r1 index)))
                                                                      (((<> fmap Vector Rc type) (<> clone Rc type)) r2))))))
                                                  (= left default left))
                                               (default -> ((<> deleteWithParent type) tree (- index 1) index tr skey callback)
                                                        ;; successful deletion in child
                                                        (Right nchild
                                                               ((<> borrowLeaf type) items children wleft current index nchild callback))
                                                        ;; propagate error
                                                        (= left default left)))
                                         (default (left ((<> type ERR_ACCESS_DEAD_CHILD) head index))))
                                   (default (left ((<> type ERR_NOT_FOUND) skey)))))))
                     ) ; decl result
                  
                  (warn!
                    (format #t "*** deleteInternalEND:\n")
                    (format #t "index: %ld" index)
                    (io result
                      (Right tr (block (format #t "\nresult:\n")
                                       (show tr))))
                    (putchar #\Newline))

                  (letin* ((rs (match result
                                 (Right ntr -> ntr
                                        (* Branch ~ Internal items children
                                           (letin* ((items_len ((<> hasLen Vector type pair_t) items (- (<> L type) 1))))
                                             (case (== items_len (- (<> L type) 1)) result
                                                   ;; hasn't got minimum keys
                                                   otherwise
                                                   (match wparent
                                                     ;; has parent
                                                     (Just ptree -> ptree
                                                           (* Branch ~ Internal pitems ->
                                                              ((<> nth Vector type pair_t) pitem_index pitems)
                                                              (Just bitem
                                                                (letin ((* ntr ntr))
                                                                  (right
                                                                   ;; helper to signal underflow
                                                                   (branch
                                                                       ((<> insertAt Vector type pair_t) items bitem
                                                                        (match (cmp (match bitem
                                                                                      ((\, key) key)
                                                                                      (default skey))
                                                                                 (match items
                                                                                   (* Cons (\, key) key)
                                                                                   (default skey)))
                                                                          (LT 0)
                                                                          (default items_len)))
                                                                     (((<> fmap Vector Rc type) (<> clone Rc type)) children)))))
                                                              (default (left ((<> type ERR_CANT_BORROW) "parent borrow 2"))))
                                                           (default (left ((<> type ERR_CANT_BORROW) "parent borrow 1"))))
                                                     ;; no parent
                                                     (default
                                                         (case (== items_len 0)
                                                               (match children
                                                                 ;; shrink
                                                                 (* Cons head -># ((<> clone Rc type) head)
                                                                    (dead (left ((<> type ERR_CANT_BORROW) "parent borrow 3")))
                                                                    (= chtr * default (letin ((* ntr ntr))
                                                                                        (right chtr))))
                                                                 (default result))
                                                               otherwise result))))))
                                        (default result))
                                 (default result))))
                    
                    (warn!
                      (format #t "*** deleteInternal underflow:\n")
                      (io rs (Right tr (show tr)))
                      (putchar #\Newline))

                    rs)))
              ) ; deleteInternal

        ;; delete from a leaf
        (func deleteLeaf (((<> Vector type pair_t) items)
                          ((<> Vector type pair_t) current)
                          (size_t index))
              (out (<> Either (<> type Error) type))

              (warn!
                (format #t "*** deleteLeaf:\n")
                (show items)
                (putchar #\Newline)
                (show current)
                (putchar #\Newline)
                (format #t "%ld" index)
                (putchar #\Newline))

              (return (match ((<> head Vector type pair_t) current)
                        (Just (= head (\, key)) tail -> (cmp skey key)
                           (LT (left ((<> type ERR_NOT_FOUND) skey)))
                           
                           ;; case
                           (EQ (letin* ((result (right (leaf ((<> delete Vector type pair_t) items current)))))
                                 (io result (Right (when callback (callback head))))
                                 result))
                           
                           ;; case
                           (default (deleteLeaf items tail (+ index 1))))
                        
                        (default (left ((<> type ERR_NOT_FOUND) skey))))))
        
        (return 
          (letin* ((result
                    (match tree
                      (* Branch ~ Internal items children
                         (deleteInternal ((<> Just type) tree) items children ((<> Nothing (<> Vector type pair_t))) items 0))
                      (* Leaf items (deleteLeaf items items 0))
                      (default (left ((<> type ERR_INVALID_OBJECT)))))))
            
            (warn!
              (format #t "*** deleteWPEND: ")
              ($> sh-key stdout skey)
              (putchar #\Newline)
              (format #t "Parent item index: %ld, child index: %ld\n" pitem_index pchild_index)
              (io result (Right tr (show tr)))
              (putchar #\Newline))

            result)) ; return
        ) ; deleteWithParent
  
  (impl-class (BTree type)
    (= Branch (<> Branch type)
       ((<> Vector type pair_t) items)
       ((<> Vector Rc type) children))
    (= Internal (<> Internal type)
       ((<> Vector type pair_t) items)
       ((<> Vector Rc type) children))
    (= Leaf (<> Leaf type)
       ((<> Vector type pair_t) items))

    (func order ()
          (out size_t)
          (return m))
    
    (func insert ((type tree) (k skey) (v svalue))
          (out (<> Either (<> type Error) type))
          
          (analyze-data!
            (fprintf __h_stack_out "*** insert ")
            ($> sh-key __h_stack_out skey))
          
          (debug!
            (printf "\n*** insert ")
            ($> sh-key stdout skey)
            (putchar #\Newline))
          
          (when (< m 3) (return (left ((<> type ERR_INVALID_ORDER) m))))

          ;; insert into an internal
          (func insertInternal (((<> Vector type pair_t) items)
                                ((<> Vector Rc type) children)
                                (size_t index))
                (out (<> Either (<> type Error) type))
                
                (debug!
                  (printf "insertInternal %ld " index)
                  (show items)
                  (printf "\ninsertInternal current -> ")
                  (io ((<> head Vector type pair_t) current)
                    (Just cur ($> sh-item stdout cur))
                    (default (printf "Nil")))
                  (printf "\ninsertInternal children\n ")
                  (io children (* _ (putchar #\Space)))
                  (show children))
                
                (return (match ((<> nth Vector type pair_t) index items)

                          ;; checks against existing keys
                          (Just (= head (\, key)) -> (cmp skey key) ; lower than
                             
                             (LT -> ((<> nth Vector Rc type) index children)
                                 ;; has child
                                 (Just child -> ((<> get Rc type) child)
                                       (Just tr -> ((<> insert type) tr skey svalue)
                                             (Right child_tree -> child_tree
                                                    ;; new Branch child
                                                    (* Branch child_items child_children -> ((<> head Vector type pair_t) child_items)
                                                       ;; join up the child
                                                       ;; a child with only a single item which is produced by split
                                                       (Just single_item <!> (== ((<> len Vector type pair_t) child_items) 1)
                                                             ;; this error of dangle temp tree pointer was found by Cicili analyzer
                                                          (letin ((* child_tree child_tree))
                                                            (right
                                                             (internal
                                                              ((<> insertAt Vector type pair_t) items single_item index)
                                                              (letin ((r1 ((<> take Vector Rc type) index children))
                                                                      (r2 ((<> drop Vector Rc type) (+ index 1) children))
                                                                      (r3 ((<> append Vector Rc type) child_children r2))
                                                                      (r4 ((<> append Vector Rc type) r1 r3)))
                                                                (((<> fmap Vector Rc type) (<> clone Rc type)) r4))))))
                                                       (default (left ((<> type ERR_INVALID_BRANCH) child_tree))))

                                                    ;; new Internal child
                                                    ;; join new child
                                                    (* Internal
                                                       (right
                                                        (internal
                                                         ((<> copy Vector type pair_t) items)
                                                         (letin ((r1 ((<> take Vector Rc type) index children))
                                                                 (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                                 (r3 ((<> drop Vector Rc type) (+ index 1) children))
                                                                 (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                                 (r5 ((<> push Vector Rc type) ((<> new Rc type) child_tree) r4)))
                                                           ((<> append Vector Rc type) r2 r5)))))
                                                    
                                                    ;; new Leaf child
                                                    (default
                                                        (right
                                                         (internal
                                                          ((<> copy Vector type pair_t) items)
                                                          (letin ((r1 ((<> take Vector Rc type) index children))
                                                                  (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                                  (r3 ((<> drop Vector Rc type) (+ index 1) children))
                                                                  (r4 (((<> fmap Vector Rc type) (<> clone Rc type)) r3))
                                                                  (r5 ((<> push Vector Rc type) ((<> new Rc type) child_tree) r4)))
                                                            ((<> append Vector Rc type) r2 r5))))))
                                             
                                             ;; propagate error
                                             (= left default left))
                                       ;; on dead child pointer
                                       (default (left ((<> type ERR_ACCESS_DEAD_CHILD) head index))))

                                 ;; no child
                                 (default (right
                                           (leaf
                                            ((<> insertAt Vector type pair_t)
                                             items (cast (<> type pair_t) '{ skey svalue }) index)))))
                             
                             ;; case
                             (EQ (left ((<> type ERR_UNIQUE_KEY) head))) ; key exists

                             ;; case
                             (default (insertInternal items children (+ index 1)))) ; greater than
                          
                          ;; no any key (item) exists
                          (default (match ((<> nth Vector Rc type) index children)
                                     
                                     ;; has d+1 child
                                     (Just child -> ((<> get Rc type) child) 
                                           (Just tr -> ((<> insert type) tr skey svalue)
                                                 (Right child_tree -> child_tree
                                                        ;; new Branch child
                                                        (* Branch child_items child_children -> ((<> head Vector type pair_t) child_items)
                                                           ;; join up the child
                                                           ;; a child with only a single item which is produced by split
                                                       (Just single_item <!> (== ((<> len Vector type pair_t) child_items) 1)
                                                              ;; this error of dangle temp tree pointer was found by Cicili analyzer
                                                              (letin ((* child_tree child_tree))
                                                                (right
                                                                 (internal
                                                                  ((<> insertAt Vector type pair_t) items single_item index)
                                                                  (letin ((r1 ((<> take Vector Rc type) index children))
                                                                          (r2 ((<> drop Vector Rc type) (+ index 1) children))
                                                                          (r3 ((<> append Vector Rc type) child_children r2))
                                                                          (r4 ((<> append Vector Rc type) r1 r3)))
                                                                    (((<> fmap Vector Rc type) (<> clone Rc type)) r4))))))
                                                           (default (left ((<> type ERR_INVALID_BRANCH) child_tree))))
                                                        
                                                        ;; new Internal child
                                                        ;; join new child
                                                        (* Internal
                                                           (right
                                                            (internal
                                                             ((<> copy Vector type pair_t) items)
                                                             (letin ((r1 ((<> take Vector Rc type) index children))
                                                                     (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                                     (r3 ((<> wrap Vector Rc type) ((<> new Rc type) child_tree))))
                                                               ((<> append Vector Rc type) r2 r3)))))

                                                        ;; new Leaf child
                                                        (default
                                                            (right
                                                             (internal
                                                              ((<> copy Vector type pair_t) items)
                                                              (letin ((r1 ((<> take Vector Rc type) index children))
                                                                      (r2 (((<> fmap Vector Rc type) (<> clone Rc type)) r1))
                                                                      (r3 ((<> wrap Vector Rc type) ((<> new Rc type) child_tree))))
                                                                ((<> append Vector Rc type) r2 r3))))))
                                                 
                                                 ;; propagate error
                                                 (= left default left))
                                           ;; on dead child pointer
                                           (default (left ((<> type ERR_ACCESS_DEAD_CHILD) head index))))

                                     ;; no d+1 child
                                     (default (right
                                               (leaf
                                                (letin ((r1 ((<> wrap Vector type pair_t) (cast (<> type pair_t) '{ skey svalue }))))
                                                  ((<> append Vector type pair_t) items r1)))))
                                     ))))
                ) ; insertInternal

          ;; insert into a leaf
          (func insertLeaf (((<> Vector type pair_t) items)
                            (size_t index))
                (out (<> Either (<> type Error) type))

                (debug!
                  (printf "insertLeaf %ld " index)
                  (show items)
                  (printf "\ninsertLeaf current -> ")
                  (io ((<> head Vector type pair_t) current)
                    (Just cur ($> sh-item stdout cur))
                    (default (printf "Nil")))
                  (putchar #\Newline))
                
                ;; insert_
                (return (match ((<> nth Vector type pair_t) index items)

                          ;; checks against existing keys
                          (Just (= head (\, key)) -> (cmp skey key) ; lower than
                             (LT (right (leaf ((<> insertAt Vector type pair_t) items (cast (<> type pair_t) '{ skey svalue }) index))))
                             
                             ;; case
                             (EQ (left ((<> type ERR_UNIQUE_KEY) head))) ; key exists

                             ;; case
                             (default (insertLeaf items (+ index 1)))) ; greater than
                          
                          ;; no any key (item) exists
                          (default (right (leaf (letin ((r1 ((<> wrap Vector type pair_t) (cast (<> type pair_t) '{ skey svalue }))))
                                                  ((<> append Vector type pair_t) items r1)))))))
                ) ; insertLeaf
          
          ;; insert
          ;; checks for overflow
          (return (match tree
                    (* Branch ~ Internal items children
                       (match (insertInternal items children 0)
                         (Right tr (right ((<> split type) tr)))
                         (= left default left)))
                    (* Leaf items
                       (match (insertLeaf items 0)
                         (Right tr (right ((<> split type) tr)))
                         (= left default left)))
                    (default (left ((<> type ERR_INVALID_OBJECT))))))
          ) ; insert
    
    
    (func search ((type tree) (k skey))
          (out (<> Maybe type pair_t))
          (return (match tree
                    (* Branch ~ Internal items children
                       (letn ((auto iiter . #'((<> iterator Vector type pair_t) items))
                              (auto citer . #'((<> iterator Vector Rc type) children)))
                         (match citer
                           ((\, cbegin cend)
                            (match iiter
                              ((\, ibegin iend)
                               (progn
                                 (while (!= cbegin cend)
                                   (when (!= ibegin iend)
                                     (io (cof ibegin)
                                       ((\, key) -> (cmp skey key)
                                        (LT (return (match ((<> get Rc type) (cof cbegin))
                                                      (Just child ((<> search type) child skey))
                                                      (default ((<> Nothing type pair_t))))))
                                        (EQ (return ((<> Just type pair_t) (cof ibegin))))))
                                     (++ ibegin))
                                   (++ cbegin))
                                 ((<> Nothing type pair_t))))
                              (default ((<> Nothing type pair_t)))))
                           (default ((<> Nothing type pair_t))))))
                    (* Leaf items (letn ((auto iiter . #'((<> iterator Vector type pair_t) items)))
                                    (match iiter
                                      ((\, ibegin iend)
                                       (progn
                                         (while (!= ibegin iend)
                                           (io (cof ibegin)
                                             ((\, key) -> (cmp skey key)
                                              (EQ (return ((<> Just type pair_t) (cof ibegin))))))
                                           (++ ibegin))
                                         ((<> Nothing type pair_t))))
                                      (default ((<> Nothing type pair_t))))))
                    (default ((<> Nothing type pair_t))))))

    
    (func delete ((type tree) (k skey) (func callback (((<> type pair_t) item))))
          (out (<> Either (<> type Error) type))
          (return ((<> deleteWithParent type) ((<> Nothing type)) 0 0 tree skey callback)))
    
    
    (func min ((type tree))
          (out (<> Maybe type pair_t))
          (return (match tree
                    (* Branch ~ Internal _ children
                       (letn ((auto citer . #'((<> iterator Vector Rc type) children)))
                         (match citer
                           ((\, cbegin cend)
                            (case (!= cbegin cend)
                                  (match ((<> get Rc type) (cof cbegin))
                                    (Just child ((<> min type) child))
                                    (default ((<> Nothing type pair_t))))
                                  otherwise ((<> Nothing type pair_t))))
                           (default ((<> Nothing type pair_t))))))
                    (* Leaf items
                       (letn ((auto iiter . #'((<> iterator Vector type pair_t) items)))
                         (match iiter
                           ((\, ibegin iend)
                            (case (!= ibegin iend) ((<> Just type pair_t) (cof ibegin))
                                  otherwise ((<> Nothing type pair_t))))
                           (default ((<> Nothing type pair_t))))))
                    (default ((<> Nothing type pair_t))))))
    
    
    (func max ((type tree))
          (out (<> Maybe type pair_t))
          (return (match tree
                    (* Branch ~ Internal _ children
                       (letn ((auto citer . #'((<> iterator Vector Rc type) children)))
                         (match citer
                           ((\, cbegin cend)
                            (case (!= cbegin cend)
                                  (match ((<> get Rc type) (cof (- cend 1)))
                                    (Just child ((<> max type) child))
                                    (default ((<> Nothing type pair_t))))
                                  otherwise ((<> Nothing type pair_t))))
                           (default ((<> Nothing type pair_t))))))
                    (* Leaf items
                       (letn ((auto iiter . #'((<> iterator Vector type pair_t) items)))
                         (match iiter
                           ((\, ibegin iend)
                            (case (!= ibegin iend) ((<> Just type pair_t) (cof (- iend 1)))
                                  otherwise ((<> Nothing type pair_t))))
                           (default ((<> Nothing type pair_t))))))
                    (default ((<> Nothing type pair_t))))))

    
    (func traverse ((type tree) (func callback (((<> type pair_t) * item) (Bool hasNext))))
          (io tree
            (* Branch ~ Internal items children
               (let ((auto iiter . #'((<> iterator Vector type pair_t) items))
                     (auto citer . #'((<> iterator Vector Rc type) children)))
                 (io citer
                   ((\, cbegin cend)
                    (io iiter
                      ((\, ibegin iend)
                       (while (!= cbegin cend)
                         (io ((<> get Rc type) (cof cbegin))  
                           (Just child ((<> traverse type) child callback))
                           (default (return)))
                         (when (!= ibegin iend)
                           (callback ibegin (? (!= (+ ibegin 1) iend) (True) (False)))
                           (++ ibegin))
                         (++ cbegin))))))))
            (* Leaf items (let ((auto iiter . #'((<> iterator Vector type pair_t) items)))
                            (io iiter
                              ((\, ibegin iend)
                               (while (!= ibegin iend)
                                 (callback ibegin (? (!= (+ ibegin 1) iend) (True) (False)))
                                 (++ ibegin))))))))
    

    (func show ((CFile file) (type tree))
          (out size_t)
          
          (func showTree ((int indent) (type tree))
                (out size_t)
                (return (+ (fprintf file "%d%*c" indent (* indent 2) #\Space)
                           (match tree
                             (* Branch ~ Internal items children
                                (letn ((auto iiter . #'((<> iterator Vector type pair_t) items))
                                       (auto citer . #'((<> iterator Vector Rc type) children)))
                                  (match citer
                                    ((\, cbegin cend)
                                     (match iiter
                                       ((\, ibegin iend)
                                        (letn ((size_t count . 0))
                                          (while (!= cbegin cend)
                                            (io ((<> get Rc type) (cof cbegin))  
                                              (Just child (set count (+ count (showTree (+ indent 1) child))))
                                              (default (return 0)))
                                            (when (!= ibegin iend)
                                              (set count (+ count ($> sh-item file (cof ibegin))))
                                              (++ ibegin))
                                            (++ cbegin))
                                          count))
                                       (default 0)))
                                    (default 0))))
                             (* Leaf items (letn ((auto iiter . #'((<> iterator Vector type pair_t) items)))
                                             (match iiter
                                               ((\, ibegin iend)
                                                (letn ((size_t count . 0))
                                                  (while (!= ibegin iend)
                                                    (set count (+ count ($> sh-item file (cof ibegin))))
                                                    (++ ibegin))
                                                  count))
                                               (default 0))))
                             (default 0)))))

          (return (+ (showTree 1 tree)
                     (fprintf file "\n"))))

    
    (func pure ((k keys []) (v values []) (size_t len))
          (out (<> Either (<> type Error) type))
          (return (letn ((type tree . #'((<> Leaf type) ((<> pureCapacity Vector type pair_t)
                                                         (- ((<> order type)) 1)
                                                         (- ((<> order type)) 1))))) ; m - 1
                    (for ((size_t i . 0)) (< i len) ((++ i))
                         (io ((<> insert type) tree (nth i keys) (nth i values))
                           (Right new_tree (block ((<> free type) (aof tree))
                                                  (set tree new_tree)))
                           (= left default (return left))))
                    (right tree))))

    
    (free ; free a B-Tree
      (io this
        (* Branch ~ Internal items children
           (block (iterate (cbeg cend children)
                    (io ((<> get Rc type) (cof cbeg))
                      (Just child ((<> free type) (aof child)))))
                  ((<> free Box Vector Rc type) (aof children))
                  ((<> free Box Vector type pair_t) (aof items))))
        (* Leaf items ((<> free Box Vector type pair_t) (aof items))))
      (free this))
    
    ) ; impl-class
  ) ; impl-B-Tree

(generic import-B-Tree
  (type k v ctor)

  ;; dependencies
  (import-Either (<> type Error) type)
  (import-Maybe type)

  (import-Vector (<> Vector type pair_t) (<> type pair_t) (<> new Vector type pair_t))

  (import-Rc type)
  (import-Vector (<> Vector (<> Rc type)) (<> Rc type) (<> new Vector (<> Rc type)))

  (DEFMACRO ctor (&REST kvs)
    (LET ((ks NIL)
          (vs NIL))
      (LOOP FOR (key value) ON kvs BY #'CDDR DO (PROGN (SETQ ks (PUSH key ks)) (SETQ vs (PUSH value vs))))
      (UNLESS (= (LENGTH ks) (LENGTH vs)) (ERROR (FORMAT NIL "invalid Dynamic Object definition: ~A" kvs)))
      `((<> pure type) (cast (k []) '( ,@ks )) (cast (v []) '( ,@vs)) ,(LENGTH ks))))
  
  ) ; import-B-Tree
