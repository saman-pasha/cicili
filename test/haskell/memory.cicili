
(import "../../haskell/rc.cicili")

;;;; Memory management tests
(source "memory.c" (:std #t :compile #t :link "-L{$CCL} -lhaskell.o -L{$CWD} memory.o -o main")
        (include "../../haskell.h")

        ;; a simple pointer holder class
        (decl-class (Ptr IntPtr)
          (= Ptr (<> make IntPtr) (int * pointer)))

        (impl-class (Ptr IntPtr)
          (= Ptr (<> make IntPtr) (int * pointer))

          (free (io this
                  (* Ptr pointer (printf "free IntPtr class: %p\n" pointer)))))
        
        (decl-Cell IntPtr)
        (impl-Cell IntPtr)
        
        (decl-Rc IntPtr)
        (impl-Rc IntPtr)
        
        (main
            (let ((int i1 . 10)                                ; some pointer
                  (IntPtr intPtr1 . #'((<> make IntPtr) &i1))) ; a class instance
              (letin ((life1 ((<> new Cell IntPtr) intPtr1)))  ; Cell, letin will free Cell's content (a class) automatically

                (io life1 ; double pointer, a pointer to an instance of a class
                  (Alive (** Ptr ptr) (printf "life1: Alive: %d\n" *ptr)) ; unsafe way
                  (Dead               (printf "life1: Dead\n")))
                
                (letin ((life2 life1)) ; this letin will free first

                  (io life2
                    (Alive (** Ptr ptr) (printf "life2: Alive: %d\n" *ptr))
                    (Dead               (printf "life2: Dead\n")))

                  ((<> free Cell IntPtr) &life2) ; short circuit drop
                  
                  (io ((<> get Cell IntPtr) life2) ; safe way
                    (Just (* Ptr ptr) (printf "life2 again: Alive: %d\n" *ptr))
                    (default          (printf "life2 again: Dead\n")))

                  ) ; letin-2

                (printf "after first letin-2\n")

                (io ((<> take Cell IntPtr) &life1) ; safe way
                  (Just (= intPtr * Ptr ptr) (progn
                                               (printf "life1 again: Alive: %d\n" *ptr)
                                               ((<> free IntPtr) &intPtr))) ; should free pointer, have been taking ownership
                  (Nothing (printf "life1 again: Dead\n")))
                
                ) ; letin-1
              ) ; let
          (printf "after first let\n")
          
          (let ((int i2 . 20)                                ; some pointer
                (IntPtr intPtr2 . #'((<> make IntPtr) &i2))) ; a class instance
            (letin ((life1 ((<> new Rc IntPtr) intPtr2)))    ; rc, letin will free rc's content (a class) automatically

              (io life1
                (Hold (** Ptr ptr) (printf "life1: Hold: %d\n" *ptr)) ; double pointer, a pointer to an instance of a class
                (Gone               (printf "life1: Gone\n")))
              
              (letin ((life2 ((<> clone Rc IntPtr) life1))) ; this letin will free first

                (io life2
                  (Hold (** Ptr ptr) (printf "life2: Hold: %d\n" *ptr))
                  (Gone              (printf "life2: Gone\n")))

                ;; uncomment to change drop time
                ;; ((<> free Rc IntPtr) &life2) ; handled drop
                
                (io ((<> get Rc IntPtr) life2) ; safe way
                  (Just (* Ptr ptr) (printf "life2 again: Alive: %d\n" *ptr))
                  (default          (printf "life2 again: Dead\n")))

                ) ; letin-2

              (printf "after second letin-2\n")

              (io ((<> take Rc IntPtr) &life1) ; safe way
                (Just (= intPtr * Ptr ptr) (progn
                                             (printf "life1 again: Alive: %d\n" *ptr)
                                             ((<> free IntPtr) &intPtr))) ; should free pointer, have been taking ownership
                (Nothing (printf "life1 again: Dead\n")))
              
              ) ; letin-1
            ) ; let
          (printf "after second let\n")

          (return 0)
          ) ; main
        
        ) ; memory.c
