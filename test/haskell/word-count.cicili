;;; sample code
;;; writes a few sentences to a temporary file
;;; reads the file into a List of char
;;; counts the words, separated by a space or a newline
;;;
;;; A LIST OF CHAR, NOT A LIST OF STRINGS. The haskell List stores its payload
;;; BY VALUE, and a std string is (non-copy) because it owns a heap buffer -- so
;;; a List_string cannot hold one. The old String got away with it by being a
;;; box: an Rc round a class pointer, copyable because the pointer was. That
;;; mechanic is gone, and a char needs none of it.
;;;
;;; The error side is a plain char * for the same reason, and a better one: `strerror'
;;; hands back a pointer it owns, so there is nothing here to take ownership of.
(source "word_count.c" (:std #t :compile #t :link "-L{$CWD} word_count.o -o word_count")
        (include <errno.h>)

        ;; the layer no longer defines CStr or CFile -- those were haskell.h's,
        ;; and a target names the types it wants
        (typedef char * cstr_t)
        (typedef FILE * cfile_t)

        (decl-List List_char char)
        (impl-List List_char char (\\ -f -v (fprintf -f "%c" -v)) "")

        (decl-Either cstr_t cfile_t)
        (impl-Either cstr_t cfile_t)

        (func writeTmpFile ()
              (out Either_cstr_t_cfile_t) ; Haskell error handling model in Cicili

              (let ((FILE * tmpf . #'(tmpfile)))

                (when (== tmpf nil)
                  (return (Left_cstr_t_cfile_t (strerror errno)))) ; on failure, the reason

                (fputs "Alan Turing\n"      tmpf)
                (fputs "John von Neumann\n" tmpf)
                (fputs "Alonzo Church\n"    tmpf)

                (return (Right_cstr_t_cfile_t tmpf)))) ; on success returns FILE*

        ;; the whole file as a List of char, one cell per character
        (func safeReadFile ((FILE * file))
              (out List_char)
              (when (== file nil)
                (return ((<> Nil char))))
              (let ((int c . #'(fgetc file)))
                (when (== c EOF)
                  (return ((<> Nil char))))
                (return ((<> Cons char) (cast char c) (safeReadFile file)))))

        ;; split on #\Space or #\Newline
        ;;
        ;; TRANSITIONS INTO A WORD, not separators plus one. Counting separators
        ;; assumes exactly one between each pair of words and none at either
        ;; end, and a file ending in a newline breaks that -- three lines of two,
        ;; three and two words counted as 8. This counts a word where a
        ;; non-separator follows a separator or the start, which is what wc does
        ;; and what word_count.hs's `BSC.words' does.
        (func count_from ((List_char text) (int in_word))
              (out int)
              (return (match text
                        (* Cons ch tail
                           (case (or (== ch #\Space) (== ch #\Newline)) (count_from tail 0)
                                 otherwise (+ (? in_word 0 1) (count_from tail 1))))
                        (default 0))))

        (func count_words ((List_char text))
              (out int)
              (return (count_from text 0)))

        (func file_close ((FILE ** file_ptr))
              (fclose (cof file_ptr)))

        (main
            (letin* ((tmpf (writeTmpFile)))
              (io tmpf
                (Left error (block (fprintf stderr "File opening error: %s\n" error)
                                   (return 1)))
                ;; the binding is named apart from the case's: (letin* ((file file …)))
                ;; declares the inner `file' before reading its own initialiser, so
                ;; it initialises from itself and rewind() gets a null
                (Right opened
                       (letin* ((file opened file_close))
                         (rewind file)
                         (letin* ((text (safeReadFile file) (<> free List_char)))
                           (printf "Word count: %d\n" (count_words text)))))))
            (return 0)))
