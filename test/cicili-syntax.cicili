
import "../draft/collection/btree.cicili"

source "btree_insert_delete.c"
  :std #t
  :compile #t
  :link "-L{$CCL} -lhaskell.o -L{$CWD} btree_insert_delete.o -o btree_insert_delete"

  include "../haskell.h"

  typedef (Tuple String int) User

  generic tree-type
          (3t)
          
          decl-B-Tree 3t int User

          func searchMany
               ,3t tree
               ,int from
               ,int to
               out void
               for (int i . from) (<= i to) ((++ i))
                   io ((<> search 3t) tree i)
                      Just item
                           block
                             format #t "Search Found: "
                             $> showItem stdout item
                             putchar #\Newline
                      Nothing error!
                                (printf "Search Not Found: %d\n" i)
                                (putchar #\Newline)
