;;;; test Cicili std maybe -- the `just' / `nothing' front ends
;;; The back-end constructors ((<> just maybe T) v) always worked; what is
;;; under test here is that the front ends name no instantiation and still
;;; land on the right one, and that they expand to the struct literal rather
;;; than to a call.

(source "maybe.c"
  (make :std #t :compile #t :link ("-lmaybe.o" "-o" "maybe_test"))

  ;; (decl-array int) already pulls in (decl-maybe int) -- a generic has no
  ;; re-instantiation guard, so asking for it twice is a redefinition in C
  (decl-array int)     (impl-array int)
  (decl-maybe size_t)  (impl-maybe size_t)
  (decl-maybe double)  (impl-maybe double)

  (func check ((const char * what) (llong got) (llong want))
        (out int)
        (if (== got want)
            (block (printf "ok   %-34s %lld\n" what got) (return 0))
          (block (printf "FAIL %-34s got %lld want %lld\n" what got want) (return 1)))
        (return 1))

  ;; ---- the shape the front ends exist for -----------------------------
  ;; both constructors read (out (<> maybe size_t)); neither spells it out
  (func (<> find array int) ((int needle) ((<> array int) ref array))
        (out (<> maybe size_t))
        (for ((size_t i . 0)) (< i (-> array len)) ((1+ i))
          (when (== (nth i (-> array arr)) needle)
            (return (just i))))
        (return (nothing)))

  ;; a bare 0 infers as int, but the out type is what decides: this is a
  ;; maybe_size_t, no cast at the call site
  (func zero ()
        (out (<> maybe size_t))
        (return (just 0)))

  ;; a second instantiation in the same file, to prove the front ends dispatch
  ;; per function and not per program
  (func half ((double x))
        (out (<> maybe double))
        (when (< x 0) (return (nothing)))
        (return (just (/ x 2))))

  ;; 'nothing follows the innermost out type: inside a closure it is the
  ;; closure's, which is a maybe_int here, not the enclosing maybe_size_t
  (func nested ()
        (out (<> maybe size_t))
        (let ((int n . #'(matchn (closure ((<> cl inner))
                                   (out (<> maybe int))
                                   (return (nothing)))
                           (just v v)
                           (nothing -7))))
          (when (== n -7) (return (just (cast size_t 1))))
          (return (nothing))))

  (main
    (let ((int bad . 0))
      (letin ((arr (new^array (cast (const int []) '{ 3 5 7 9 }))))

        ;; ---- found / not found ------------------------------------------
        (+= bad (check "just, through match"
                  (matchn ((<> find array int) 7 (aof arr)) (just at (cast llong at)) (nothing -1))
                  2))
        (+= bad (check "nothing, through match"
                  (matchn ((<> find array int) 8 (aof arr)) (just at (cast llong at)) (nothing -1))
                  -1))

        ;; the statement form of match sees the same two cases
        (let ((int hits . 0))
          (match ((<> find array int) 3 (aof arr))
            (just    at (block (cast void at) (++ hits)))
            (nothing    (-- hits)))
          (match ((<> find array int) 4 (aof arr))
            (just    at (block (cast void at) (++ hits)))
            (nothing    (-- hits)))
          (+= bad (check "match statement, both arms" hits 0)))

        ;; ---- the out type decides, not the value ------------------------
        ;; (just 0) in a maybe_size_t function is present with payload 0 --
        ;; the very case a sentinel return cannot express
        (+= bad (check "just 0 is present"
                  (matchn (zero) (just v (cast llong v)) (nothing -1)) 0))

        ;; ---- a second instantiation --------------------------------------
        (+= bad (check "just, maybe double"
                  (matchn (half 9.0) (just v (cast llong (* v 100))) (nothing -1)) 450))
        (+= bad (check "nothing, maybe double"
                  (matchn (half -1.0) (just v (cast llong (* v 100))) (nothing -1)) -1))

        ;; ---- the innermost out type wins ----------------------------------
        (+= bad (check "nothing inside a closure"
                  (matchn (nested) (just v (cast llong v)) (nothing -1)) 1))

        ;; ---- away from a return, the value decides -------------------------
        ;; no function out type to read here, so (just 42) is a maybe_int
        (let (((<> maybe int) m . #'(just 42)))
          (+= bad (check "just in a let, from the value"
                    (matchn m (just v (cast llong v)) (nothing -1)) 42)))

        ;; the back ends are still the way to name an instantiation directly
        (+= bad (check "back-end just still works"
                  (matchn ((<> just maybe int) 5) (just v (cast llong v)) (nothing -1)) 5))
        (+= bad (check "back-end nothing still works"
                  (matchn ((<> nothing maybe int)) (just v (cast llong v)) (nothing -1)) -1))

        ) ; letin

      (if (== bad 0)
          (printf "maybe: all ok\n")
        (printf "maybe: %d FAILED\n" bad))
      (return bad))))

;; sbcl --script cicili.lisp ./test/std/maybe.cicili
;; ./test/std/maybe_test
