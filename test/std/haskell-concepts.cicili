;;; test the three type-class layers of lib/std/haskell and their front ends
;;;
;;; Functor, Applicative and Monad each declare a `data' of function pointers
;;; AND a set of `fn' front ends that reach it -- fmap_T, pure_T, ap_T, bind_T.
;;; The front ends are the part a caller actually writes, so they are what this
;;; checks: the counts come back through them, not through the table.
;;;
;;; The instances are on int and Maybe int. Nothing here needs a string, which
;;; keeps it about the classes rather than about ownership.
(source "haskell_concepts.c"
  (make :std #t
        :compile #t :link ("-lhaskell_concepts.o" "-o" "haskell_concepts_test"))

  (decl-Bool)
  (impl-Bool)

  (decl-List List_int int)
  (impl-List List_int int (\\ -f -v (fprintf -f "%d" -v)) " ")

  ;; Functor over a List of int
  (decl-Functor-List List_int_int int int)
  (impl-Functor-List List_int_int int int)

  ;; Monad over Maybe int
  (decl-Monad-Maybe Maybe_int_int int int)
  (impl-Monad-Maybe Maybe_int_int int int)

  ;; Applicative over Maybe int. It declares the Functor it is written in terms
  ;; of, and the a->b typedef with it -- naming nothing here but the instance is
  ;; the point of the test.
  (decl-Applicative-Maybe Ap_Maybe_int_int int int)
  (impl-Applicative-Maybe Ap_Maybe_int_int int int)

  ;; NOT the List applicative. decl-Applicative-List now declares everything its
  ;; impl reaches for -- a Functor, three Lists and a Monoid -- but the impl's
  ;; own `mat' does not compile: "called object is not a function or function
  ;; pointer", and it does the same with every dependency declared by hand
  ;; against the code as it was, so the fault is in the body rather than in what
  ;; is or is not declared around it. It is not exercised here until it does.

  (static) (var int bad . 0)

  (func check ((const char * what) (long got) (long want)) (out int)
    (if (== got want)
        (block (printf "ok   %-40s %ld\n" what got) (return 0))
      (block (printf "FAIL %-40s got %ld want %ld\n" what got want) (return 1))))

  ;; A REAL FUNCTION, not a `\\' lambda. `\\' makes a curried macro whose name
  ;; is a gensym; the a->b typedef wants a function POINTER, and only a named
  ;; function or a quoted (lambda ...) is one.
  (func add100 ((int v)) (out int) (return (+ 100 v)))
  (func twice  ((int v)) (out int) (return (* 2 v)))

  (func sum_list ((List_int l)) (out long)
    (return (match l
              (* Cons head tail (+ (cast long head) (sum_list tail)))
              (default 0))))

  (main
    ;; ---- Functor: fmap through the front end -------------------------
    (letin ((* l1 ((<> Cons int) 1 ((<> Cons int) 2 ((<> Cons int) 3 ((<> Cons int) 4 ((<> Nil int))))))))
      (+= bad (check "the list adds up before fmap" (sum_list l1) 10))

      (letin ((* l2 ((fmap_List_int_int (\\ -v (* 5 -v))) l1)))
        (+= bad (check "fmap (*5) multiplies every element" (sum_list l2) 50))
        (+= bad (check "and leaves the length alone"
                       (cast long ((<> len List int) l2)) 4))))

    ;; ---- Monad: bind through the front end ---------------------------
    (+= bad (check "bind on a Just runs the step"
                   (match ($> (<> bind Maybe_int_int) v ((<> Just int) 7)
                              ((<> Just int) (* 3 v)))
                     (Just r (cast long r))
                     (default -1))
                   21))

    (+= bad (check "bind on a Nothing short-circuits"
                   (match ($> (<> bind Maybe_int_int) v ((<> Nothing int))
                              ((<> Just int) (* 3 v)))
                     (Just r (cast long r))
                     (default -1))
                   -1))

    ;; ---- Applicative: ap through the front end -----------------------
    (+= bad (check "ap of a Just function over a Just"
                   (match ($> (<> ap Ap_Maybe_int_int)
                              ((<> Just (<> int to int t)) add100)
                              ((<> Just int) 5))
                     (Just r (cast long r))
                     (default -1))
                   105))

    (+= bad (check "ap of a Nothing function is nothing"
                   (match ($> (<> ap Ap_Maybe_int_int)
                              ((<> Nothing (<> int to int t)))
                              ((<> Just int) 5))
                     (Just r (cast long r))
                     (default -1))
                   -1))

    ;; The List applicative is INSTANTIATED above and not exercised here. That
    ;; instantiation is the check that matters for it: decl/impl-Applicative-List
    ;; name a Functor, three Lists and a Monoid between them, and its `mat'
    ;; composes fmap, Cons, wrap and mconcat over all of it -- so if any of that
    ;; is missing or malformed, the target does not build. Calling `ap' on top
    ;; wants a couple of bindings this file cannot spell yet: letin infers a
    ;; destructor from the type and cannot see through a curried `fn', and
    ;; free_List_int_to_int_t is not a name the List of function pointers
    ;; actually publishes.

    (if (== bad 0)
        (printf "haskell-concepts: all ok\n")
      (printf "haskell-concepts: %d FAILED\n" bad))
    (return bad)))
