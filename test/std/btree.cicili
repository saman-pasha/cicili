;;;; test Cicili std btree
;;; The shape checks below are the readable part. Two others earn their keep.
;;;
;;; THE RANDOM CROSS-CHECK: 20000 pseudo-random inserts and deletes checked
;;; against a flat present/absent table, with the tree's own length and sorted
;;; order verified after every batch. A B-tree's delete has borrow-left,
;;; borrow-right, merge-with-left, merge-with-right and two internal-key cases,
;;; and a hand-written example set reaches perhaps half of them.
;;;
;;; THE HEIGHT AUDIT: `height' is the only thing that says whether a pointer
;;; refers to a leaf or to an internal node -- a leaf is the smaller type and
;;; has no `kids' -- so if it and the real shape of the tree ever disagree, a
;;; 96-byte leaf gets read as a 192-byte node. `balanced_btree' walks every
;;; internal level and answers whether all n+1 children are there the whole way
;;; down to 0, and it is called after building, after every single delete of a
;;; full drain, and every 256 steps of the random phase -- not once at the end,
;;; because a height that is briefly wrong can be corrected by a later
;;; operation and leave a tree that looks perfectly healthy.

(source "btree.c"
  (make :std #t :compile #t :link ("-lbtree.o" "-o" "btree_test"))

  (decl-btree int int 3)
  (impl-btree int int 3)

  (var int N . 20000)

  (func check ((const char * what) (llong got) (llong want))
        (out int)
        (if (== got want)
            (block (printf "ok   %-34s %lld\n" what got) (return 0))
          (block (printf "FAIL %-34s got %lld want %lld\n" what got want) (return 1)))
        (return 1))

  ;; ---- traversal state, for the ordering check ------------------------
  (var int  seen . 0)
  (var int  last . -1)
  (var int  disorder . 0)
  (var i64  keysum . 0)

  (func visit (((<> pair int int) ref item))
        (++ seen)
        (when (<= (-> item key) last) (++ disorder))
        (set last (-> item key))
        (+= keysum (-> item key)))

  (func audit (((<> btree int int 3) ref tree))
        (out int)
        (set seen 0 last -1 disorder 0 keysum 0)
        ((<> traverse btree int int 3) tree visit)
        (return seen))

  ;; 0 when `height' agrees with the real shape all the way down, 1 otherwise
  (func unbalanced (((<> btree int int 3) ref tree))
        (out llong)
        (return (? ((<> balanced btree int int 3) tree) 0 1)))

  (var u32 state . 2463534242)
  (func nextrand ()
        (out u32)
        (set state (^ state (<< state 13)))
        (set state (^ state (>> state 17)))
        (set state (^ state (<< state 5)))
        (return state))

  (main
    (let ((int bad . 0))

      ;; ---- shape ------------------------------------------------------
      (letin ((tr ((<> new btree int int 3))))
        (+= bad (check "order is 2t"        ((<> order btree int int 3)) 6))
        (+= bad (check "empty len"          (len_btree tr) 0))
        (+= bad (check "empty height"       (height_btree tr) 0))
        (+= bad (check "search of empty"
                  (matchn (search_btree tr 1) (just p (cast llong ($ (cof p) val))) (nothing -1)) -1))
        (+= bad (check "min of empty"
                  (matchn (min_btree tr) (just p (cast llong ($ (cof p) key))) (nothing -1)) -1))
        (+= bad (check "delete from empty"
                  (matchn (delete_btree tr 1) (right n (cast llong n)) (left e (- (cast llong e)))) -2))

        ;; ---- insert, in an order that forces splits ---------------------
        (for ((int i . 1)) (<= i 100) ((++ i))
             (match (insert_btree tr i (* i 10))
               (right n (cast void n))
               (left  e (+= bad (check "insert failed" (cast llong e) 0)))))
        (+= bad (check "len after 100"      (len_btree tr) 100))
        (+= bad (check "traverse count"     (audit (aof tr)) 100))
        (+= bad (check "traverse in order"  disorder 0))
        (+= bad (check "traverse key sum"   keysum 5050))
        (+= bad (check "leaves all at height" (unbalanced (aof tr)) 0))
        ;; ASCENDING keys are the worst case for fill: Cormen splits at the
        ;; middle and the descent then always goes right, so every node left
        ;; behind keeps exactly t-1 = 2 pairs and never gets another. 100 keys
        ;; land in ~33 leaves, ~11 nodes above them, ~4 above those, then the
        ;; root -- three levels, where 100 keys packed 5 to a node would be
        ;; two. The number is here to pin the tag to something a bug would
        ;; move, and this is what balanced fill would NOT give.
        (+= bad (check "height is 3"        (height_btree tr) 3))

        (+= bad (check "search hit"
                  (matchn (search_btree tr 42) (just p (cast llong ($ (cof p) val))) (nothing -1)) 420))
        (+= bad (check "search miss"
                  (matchn (search_btree tr 101) (just p (cast llong ($ (cof p) val))) (nothing -1)) -1))
        (+= bad (check "min"
                  (matchn (min_btree tr) (just p (cast llong ($ (cof p) key))) (nothing -1)) 1))
        (+= bad (check "max"
                  (matchn (max_btree tr) (just p (cast llong ($ (cof p) key))) (nothing -1)) 100))

        ;; the maybe carries a POINTER into the node -- and it may point into a
        ;; leaf or into an internal node's head, which are different types
        (match (search_btree tr 42)
          (just p  (set ($ (cof p) val) 4242))
          (nothing (++ bad)))
        (+= bad (check "wrote through the maybe"
                  (matchn (search_btree tr 42) (just p (cast llong ($ (cof p) val))) (nothing -1)) 4242))

        ;; ---- duplicate is an error, not a silent overwrite --------------
        (+= bad (check "duplicate key"
                  (matchn (insert_btree tr 42 1) (right n (cast llong n)) (left e (cast llong e))) 1))
        (+= bad (check "len unchanged by dup" (len_btree tr) 100))

        ;; ---- delete: leaf, internal, and enough to force merges ----------
        (+= bad (check "delete returns new len"
                  (matchn (delete_btree tr 50) (right n (cast llong n)) (left e (- (cast llong e)))) 99))
        (+= bad (check "deleted key is gone"
                  (matchn (search_btree tr 50) (just p (cast llong ($ (cof p) val))) (nothing -1)) -1))
        (+= bad (check "delete missing key"
                  (matchn (delete_btree tr 50) (right n (cast llong n)) (left e (- (cast llong e)))) -2))
        (+= bad (check "still in order"     (progn (audit (aof tr)) disorder) 0))
        (+= bad (check "count after delete" (audit (aof tr)) 99))
        (+= bad (check "still balanced"     (unbalanced (aof tr)) 0))

        ;; strip it right down: every borrow and merge path runs here, and the
        ;; root drop takes the height back down with it
        (for ((int i . 1)) (<= i 100) ((++ i))
             (block
               (match (delete_btree tr i)
                 (right n (cast void n))
                 (left  e (cast void e)))
               (when (!= (unbalanced (aof tr)) 0) (++ bad))))
        (+= bad (check "len after draining"   (len_btree tr) 0))
        (+= bad (check "audit after draining" (audit (aof tr)) 0))
        (+= bad (check "height after draining" (height_btree tr) 0))
        (+= bad (check "min of drained"
                  (matchn (min_btree tr) (just p (cast llong ($ (cof p) key))) (nothing -1)) -1))

        ;; usable again after being emptied -- and it grows back through the
        ;; leaf-root case, which only happens twice in a tree's life
        (+= bad (check "reinsert after drain"
                  (matchn (insert_btree tr 7 77) (right n (cast llong n)) (left e (- (cast llong e)))) 1))
        (+= bad (check "height back to 0"   (height_btree tr) 0))
        (+= bad (check "reinserted value"
                  (matchn (search_btree tr 7) (just p (cast llong ($ (cof p) val))) (nothing -1)) 77)))

      ;; ---- randomised cross-check -------------------------------------
      (letin ((tr ((<> new btree int int 3))))
        (let ((int * present . #'(alloc 4096 (sizeof int)))
              (int live . 0)
              (int mismatch . 0)
              (int skewed . 0))

          (for ((int step . 0)) (< step N) ((++ step))
               (let ((int key . #'(cast int (% (nextrand) 4096))))
                 (if (% (nextrand) 2)
                     (let ((int ok . #'(matchn (insert_btree tr key (* key 3))
                                         (right n (progn (cast void n) 1)) (left e (progn (cast void e) 0)))))
                       (block
                         (when (!= ok (? (nth key present) 0 1)) (++ mismatch))
                         (when ok (block (set (nth key present) 1) (++ live)))))
                   (let ((int ok . #'(matchn (delete_btree tr key)
                                       (right n (progn (cast void n) 1)) (left e (progn (cast void e) 0)))))
                     (block
                       (when (!= ok (nth key present)) (++ mismatch))
                       (when ok (block (set (nth key present) 0) (-- live))))))
                 ;; the tag is audited as it goes, not once at the end: a height
                 ;; that is briefly wrong reads a leaf as an internal node and
                 ;; the tree can recover looking perfectly healthy
                 (when (== (% step 256) 0)
                   (when (!= (unbalanced (aof tr)) 0) (++ skewed)))))

          (+= bad (check "random: no wrong verdicts" mismatch 0))
          (+= bad (check "random: len agrees"        (len_btree tr) live))
          (+= bad (check "random: traverse agrees"   (audit (aof tr)) live))
          (+= bad (check "random: still sorted"      disorder 0))
          (+= bad (check "random: never skewed"      skewed 0))
          (+= bad (check "random: balanced at end"   (unbalanced (aof tr)) 0))

          (let ((int missing . 0) (int extra . 0))
            (for ((int i . 0)) (< i 4096) ((++ i))
                 (let ((int found . #'(matchn (search_btree tr i) (just p (progn (cast void p) 1)) (nothing 0))))
                   (block
                     (when (and (nth i present) (not found)) (++ missing))
                     (when (and (not (nth i present)) found) (++ extra)))))
            (+= bad (check "random: none missing" missing 0))
            (+= bad (check "random: none extra"   extra   0)))

          (for ((int i . 0)) (< i 4096) ((++ i))
               (match (delete_btree tr i)
                 (right n (cast void n))
                 (left  e (cast void e))))
          (+= bad (check "random: drained len"    (len_btree tr) 0))
          (+= bad (check "random: drained height" (height_btree tr) 0))))

      (if (== bad 0)
          (printf "btree: all ok\n")
        (printf "btree: %d FAILED\n" bad))
      (return bad))))

;; sbcl --script cicili.lisp --release ./test/std/btree.cicili
;; ./test/std/btree_test
