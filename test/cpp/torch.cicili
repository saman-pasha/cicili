;;;; test the libtorch declaration bindings in lib/cpp/torch/
;;;
;;; WHAT THIS PROVES, and what it does not.
;;;
;;; It proves the Cicili half: that the declarations in lib/cpp/torch/ resolve,
;;; that ($ t sizes) and (-> fc forward) find their members through them, that
;;; a struct can inherit torch::nn::Module and override forward, and that a
;;; libtorch value bound with letin* is destroyed by C++ rather than by us.
;;;
;;; It does NOT prove the signatures match the real libtorch: it compiles
;;; against test/cpp/torch_stub.hpp so that it runs anywhere, in the suite, with
;;; nothing installed. That check is example/torch.cicili, which builds against
;;; <torch/torch.h> and links libtorch -- run it by hand on a machine that has
;;; libtorch, and it is where a wrong signature is caught.

(source "torch.cpp"
  (make :cpp #t :compile #t :link ("-ltorch.o" "-o" "torch_test"))

  ;; the real program says (include <torch/torch.h>)
  (include "torch_stub.hpp")
  (include <cstdio>)

  ;; the declarations. They emit nothing; they are here so the compiler knows
  ;; what a torch::Tensor is.
  (import "lib/cpp/torch/torch.cicili")

  ;; the stub's fill helper -- see test/cpp/torch_stub.hpp. Declared, not
  ;; defined: the header has it.
  (decl) (func torch_stub_set ((torch::Tensor & t) (llong flat) (double v)))

  (var int bad . 0)

  (func check ((const char * what) (long got) (long want))
        (if (== got want)
            (printf "ok   %-32s %ld\n" what got)
          (block (printf "FAIL %-32s got %ld want %ld\n" what got want)
                 (++ bad))))


  ;; ---- a module of our own ------------------------------------------
  ;; This is the shape every libtorch program has: a struct inheriting Module,
  ;; holding layers, with a forward. No `class', no `public:', `this' implicit.
  (struct Net (inherits torch::nn::Module)
          (member torch::nn::Linear fc)
          (ctor ((i64 in) (i64 out))
                (init (fc (torch::nn::Linear in out))))
          (method forward ((const torch::Tensor & x)) (out torch::Tensor)
                  (return (torch::relu ((-> ($ this fc) forward) x)))))

  (main
    ;; ---- construction and shape, all through declared members --------
    (letin* ((t (torch::zeros (dims 2 3))))
      (check "dim"    (cast long (($ t dim)))   2)
      (check "numel"  (cast long (($ t numel))) 6)
      (check "size 0" (cast long (($ t size) 0)) 2)
      (check "size 1" (cast long (($ t size) 1)) 3))

    ;; ---- arithmetic returns a tensor, and the type flows -------------
    (letin* ((a (torch::ones (dims 4))))
      (letin* ((b (($ a add) a)))                 ; b is a torch::Tensor
        ;; a member template: item<float> is one name
        (check "add then sum" (cast long (($ (($ b sum)) (t<> item float)))) 8)))

    ;; ---- free functions ---------------------------------------------
    (letin* ((z (torch::zeros (dims 3))))
      (letin* ((r (torch::relu z)))
        (check "relu numel" (cast long (($ r numel))) 3)))

    ;; ---- our module, and virtual dispatch through the base ----------
    (letin* ((net (Net 4 2)))
      (letin* ((x (torch::ones (dims 4))))
        (letin* ((y (($ net forward) x)))
          (check "forward numel" (cast long (($ y numel))) 2)))
      (($ net eval))                              ; inherited from Module
      (check "inherited is_training" (cast long (? (($ net is_training)) 1 0)) 0))

    ;; ---- an RAII guard, destroyed by C++ ----------------------------
    ;; letin* with no destructor: NoGradGuard turns grad off for the scope and
    ;; its own destructor turns it back on. Nothing here calls it.
    (letin* ((g (torch::NoGradGuard)))
      (letin* ((t (torch::ones (dims 2))))
        (check "inside no_grad" (cast long (($ t numel))) 2)))

    ;;; ---- the mean_t dispatcher ------------------------------------
    ;;;
    ;;; Tensor::mean is overloaded and Cicili has no overloading, so the
    ;;; axis-wise form goes through a `code' escape -- which is not type-checked
    ;;; -- behind a dispatcher that does the checking itself. What is asserted
    ;;; here is that the escape picked the RIGHT overload, and that its result
    ;;; carries a type.
    ;;;
    ;;; A 2x3 of 1..6, so the two overloads cannot agree by accident: over
    ;;; everything the mean is 3.5 and one number, along axis 0 it is three
    ;;; numbers and the first is 2.5.
    (letin* ((mt (torch::zeros (dims 2 3))))
      (for ((i64 r . 0)) (< r 2) ((++ r))
           (for ((i64 c . 0)) (< c 3) ((++ c))
                (torch_stub_set mt (+ (* r 3) c) (cast double (+ (* r 3) c 1)))))

      ;; the declared, no-argument overload
      (letin* ((whole (mean_t mt)))
        (check "mean_t over everything is one number" (($ whole numel)) 1)
        (check "and it is 3.5, scaled"
               (cast long (* 10.0 (($ whole (t<> item float))))) 35))

      ;; the escape's overload -- a different shape, which is what says the
      ;; call resolved to the other one
      (letin* ((cols (mean_t mt 0)))
        (check "mean_t along axis 0 is one per column" (($ cols numel)) 3)
        (check "keepdim kept the rank"                 (($ cols dim)) 2)
        (check "and column 0 is (1+4)/2"
               (cast long (* 10.0 (($ cols (t<> item float))))) 25))

      ;; #f drops the reduced dimension, so the flag reaches the call
      (letin* ((flat (mean_t mt 0 #f)))
        (check "keepdim #f dropped it" (($ flat dim)) 1))

      ;;; AND THE RESULT HAS A TYPE, which a bare `code' escape would not: this
      ;;; only compiles if the dispatcher's cast gave `$' something to resolve.
      (letin* ((chained (($ (mean_t mt 0) sqrt))))
        (check "a method resolves off the escape's result" (($ chained numel)) 3)))

    (if (== bad 0)
        (printf "torch bindings: all ok\n")
      (printf "torch bindings: %d FAILED\n" bad))
    (return bad)))

;; sbcl --script cicili.lisp ./test/cpp/torch.cicili
;; ./test/cpp/torch_test
