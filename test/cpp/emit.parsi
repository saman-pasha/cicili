TABLE emit::books
BEGIN
	COLUMN id AS Long PRIMARY KEY;
	COLUMN title AS String NOT NULL;
	COLUMN year AS Int;
END

SEQUENCE emit::books_seq
BEGIN
	FROM 1;
	TO Long::MAX;
	STEP 1;
END

PROCEDURE emit::add_book(title AS String, year AS Int)
RETURNS Long
REQUIRES emit::books, emit::books_seq
BEGIN
	DECLARE id AS Long = emit::books_seq::NEXT();
	INSERT INTO emit::books VALUES (id, title, year);
	RETURN id;
END

PAGE emit::report
REQUIRES emit::books
BEGIN
	BEGIN HPP
	#include "emit_report.hpp"
	END
	BEGIN CPP
	#include "emit_report.cpp"
	END
PUBLIC:
	OVERRIDE FUNCTION PAGE_LOAD() RETURNS Void
	BEGIN
		ECHO '<h1>Books</h1>';
		ECHO '<p>answer = ', `emit_report_e1(), '</p>';
		ECHO '<ul>';
		SELECT '<li>', title, ' (', year, ')</li>'
		FROM emit::books;
		ECHO '</ul>';
	END
END 
