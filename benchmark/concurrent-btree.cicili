
;;; concurrent B-Tree type, (database alike)
;;; Multi Version Concurrent System
;;; using Rc
;;; Rc cooperation with lock makes it atomic
;;; and guarantees versioning access to btree
;;; Single Writer, Multi Reader
;;;
;;; ONE WRITER AND FOUR READERS OVER A PERSISTENT TREE. The writer inserts a
;;; thousand keys and deletes them again; each write answers a NEW root that
;;; shares most of its spine with the old one, and swaps it into the Arc. The
;;; readers clone the Arc and search whatever version that clone caught, so a
;;; reader finding nothing is not a fault -- it is a reader looking at a version
;;; the key had not reached yet, or had already left. Both counts are printed.
;;;
;;; Reading the output: the writer's lines go to stdout and a reader's misses go
;;; to stderr through `error!'. Those are two streams with two buffering rules,
;;; so merging them with 2>&1 interleaves them mid-token and loses lines to the
;;; naked eye. Redirect them separately when counting anything.
;;;
;;; It builds on draft/collection/persistent-btree now. The btree it used to
;;; import is gone, along with the haskell Cell and String its payload was made
;;; of; what survived is the haskell Arc, which is the whole point of this file
;;; -- a refcount behind a mutex, handing the payload to a callback under it.

(import "draft/collection/persistent-btree.cicili")
(import "lib/std/pthread/pthread.cicili")

(source "concurrent_btree.c"
  ;; no :haskell -- that flag linked haskell.o, and the layer is part of std now
  (make :std #t
        :compile #t
        :link "concurrent_btree.o -o concurrent_btree")


  ;; no flags of its own, so WITHOUT --release this builds at -g -O0 and every
  ;; millisecond it prints is meaningless. Refuse, rather than measure.
  (import "benchmark/release-only.cicili")
  (release-only)
  (include <pthread.h>)
  (include <unistd.h>)
  
  ;; Define a simple User type, contains salary and grade
  ;; id is not included in User type, chosen as key
  ;;
  ;; A PAIR OF ints, WHERE THIS USED TO CARRY A (<> Cell String). The Cell was
  ;; there so a delete in one version could empty it and the other versions
  ;; would read "deleted in another version"; the haskell Cell and String it was
  ;; built from are both gone. std's string would fit the slot, but the tree
  ;; copies an item by value across versions -- copy, replace, take and drop all
  ;; do -- and a struct holding a non-copy field is not itself non-copy, so
  ;; nothing would object and every version would own the same buffer. What this
  ;; benchmark measures is the Arc under one writer and four readers, and an int
  ;; pair measures it the same. test/std/btree-persistent carries the same pair
  ;; for the same reason.
  (typedef (Tuple int int) User)

  ;; compareKey answers with one of these and is written before the generic
  ;; that instantiates the tree, so the type has to be declared before it --
  ;; decl-B-Tree asks for Ordering too and its include guard makes that free.
  (decl-Ordering)
  (impl-Ordering)

  (func compareKey ((int lkey) (int rkey))
        (out Ordering)
        (return (case (<  lkey rkey) (LT)
                      (== lkey rkey) (EQ)
                      otherwise      (GT))))

  ;; reducible functions, curry form call
  (fn showKey -file -key
      (fprintf -file "%d" -key))

  (fn showValue -file -u
      (match -u
        ((\, salary grade) (fprintf -file "(%d, %d)" salary grade))
        (default 0)))
  
  (fn showItem -file -item
      (match -item
        ((\, id (\, salary grade)) (fprintf -file "(%d, %d, %d)" id salary grade))
        (default 0)))

  (generic tree-type
    (3t) ; 3t is BTree_int_User type
    
    (decl-B-Tree 3t ; 3t is BTree_int_User type
      ;;   item : (Tuple int User)
      int       ; int  : key type, user id
      User)     ; User : value type
    
    (impl-B-Tree 3t ; 3t is BTree_int_User type
      ;;    item : (Tuple int User)
      int        ; int  : key type, user id
      User       ; User : value type
      3          ; m    : order (degree)
      compareKey ; key comparision function
      showKey    ; show key function
      showItem)  ; show item function

    (var Bool doQuit)
    (define-mutex treeArc) ; should be recursive for using in Arc, init in main
    (define-mutex outlock :init T)

    ;; B-Tree itself uses Rc for handling child references in all tree versions
    ;; for the concurrent root access and manipulation (Pure Functional) we need Arc
    (decl-Arc 3t)
    (impl-Arc 3t)
    
    (func insertMany (((<> Arc 3t) * pwtree) (int from) (int to))
          (block
            (for ((int i . from)) (<= i to) ((++ i))
                 (block
                   ((<> lock Arc 3t)
                    (cof pwtree)
                    ;; alive callback
                    ;; closure instead of lambda because of using 'i
                    '(closure ((3t tree))
                      (io ((<> insert 3t) tree i (cast User '{ (+ i 2000) 1 }))
                        (Right new_tree (block (lock
                                                 (aof outlock)
                                                 (format #t "Inserted: %d" i)
                                                 (putchar #\Newline))

                                               ;; trace counting with --info arg
                                               (info! (io (cof pwtree)
                                                        (Hold pointer count address _
                                                              (lock (aof outlock)
                                                                    (printf "+++++++++++++++++++++++++++++ %p, %p, %d, %p\n"
                                                                      pointer *pointer *count (cast (void *) address))))))
                                               
                                               ((<> free Arc 3t) pwtree)
                                               (set (cof pwtree) ((<> new Arc 3t) new_tree (aof treeArc)))

                                               (info! (io (cof pwtree)
                                                        (Hold pointer count address _
                                                              (lock (aof outlock)
                                                                    (printf "++++++++++++++++++++++++++new %p, %p, %d, %p\n"
                                                                      pointer *pointer *count (cast (void *) address))))))))
                        (Left err (lock (aof outlock)
                                        ;; redirects stdout to stderr
                                        (error! (printf "Error during insertion: ")
                                                ((<> show 3t Error) err)
                                                (putchar #\Newline)
                                                (exit -1))))))
                    ;; dead callback
                    '(lambda ()
                      (error! (printf "Bad Rc! (writer i)\n")
                              (exit -1))))

                   (usleep 5) ; let readers read some
                   ))))

    (func deleteMany (((<> Arc 3t) * pwtree) (int from) (int to))
          ;; callback to release item resources
          ;; NOTHING TO RELEASE. This callback existed to free the Cell String an
          ;; item carried; an int pair owns nothing, so it only reports.
          (let ((auto item_deallocator . '(lambda (((<> 3t pair_t) item))
                                           (io item
                                             ((\, key (\, salary)) (lock (aof outlock)
                                                                        (printf "Deleted: %d, %d" key salary)
                                                                        (putchar #\Newline)))))))
            (for ((int i . from)) (<= i to) ((++ i))
                 ((<> lock Arc 3t)
                  (cof pwtree)
                  '(closure ((3t tree))
                    (io ((<> delete 3t) tree i item_deallocator)
                      (Right new_tree (block
                                        ;; trace reference counting with --info arg
                                        (info! (io (cof pwtree)
                                                 (Hold pointer count address _
                                                       (lock (aof outlock)
                                                             (printf "----------------------------- %p, %p, %d, %p\n"
                                                               pointer *pointer *count (cast (void *) address))))))

                                        ((<> free Arc 3t) pwtree)
                                        (set (cof pwtree) ((<> new Arc 3t) new_tree (aof treeArc)))

                                        (info! (io (cof pwtree)
                                                 (Hold pointer count address _
                                                       (lock (aof outlock)
                                                             (printf "--------------------------new %p, %p, %d, %p\n"
                                                               pointer *pointer *count (cast (void *) address))))))))
                      (Left err (lock (aof outlock)
                                      (error! (printf "Error during deletion: ")
                                              ((<> show 3t Error) err)
                                              (putchar #\Newline)
                                              (exit -1))))))
                  '(lambda ()
                    (error! (printf "Bad Rc! (writer d)\n")
                            (exit -1))))

                 (usleep 5) ; let readers read some
                 )))

    (func freeRcTree (((<> Arc 3t) * pnwtree))
          ;; trace counting with --info arg
          (info! (io (cof pnwtree)
                   (Hold pointer count address _
                         (lock (aof outlock)
                               (printf "OOOOOOOOOOOOOOOOOOOOOOOOOOOOO %p, %p, %d, %p\n"
                                 pointer *pointer *count (cast (void *) address))))))
          
          ((<> free Arc 3t) pnwtree))
    
    (func searchMany (((<> Arc 3t) * pwtree) (int from) (int to))
          (while #t
            (io doQuit (True (return))) ; stop reader
            
            ;; THE READ OF THE SHARED ARC IS PART OF THE CLONE, and the lock has
            ;; to cover both. `clone' takes its argument BY VALUE, so (cof
            ;; pwtree) copies the Hold -- its pointer, count and mutex -- before
            ;; clone has locked anything, while the writer is inside treeArc
            ;; freeing that very Hold and putting a new one in its place. The
            ;; copy then locks a mutex it read from a freed struct and bumps a
            ;; count that is gone: valgrind reports the invalid read in
            ;; clone_Arc, freed by another thread's free_Arc.
            ;;
            ;; treeArc is recursive, so clone taking it again inside is free.
            ;;
            ;; freeRcTree will be called deferral
            (letin* ((nwtree (lockn (aof treeArc) ((<> clone Arc 3t) (cof pwtree)))
                             freeRcTree))
              
              ;; read whatever from cloned version, either current or one of latest versions
              (io ((<> get Arc 3t) nwtree)
                (Just tree
                  (for ((int i . from)) (<= i to) ((++ i))
                       (io ((<> search 3t) tree i)
                         (Just item (lock (aof outlock) (format #t "thread: %lu, Search Found: " (cast (unsigned long) (self)))
                                          ($> showItem stdout item)
                                          (putchar #\Newline)))
                         (Nothing (lock (aof outlock) (error! (printf "thread: %lu, Search Not Found: %d" (cast (unsigned long) (self)) i)
                                                              (putchar #\Newline)))))))))
            
            )) ; searchMany

    ;; 1 Writer, 4 Reader
    (func main ()
          (format #t "Multi-thread pure functional manipulation of '%s' type into and from '%s' structure using '%s' key type.\n"
                  (symbol-name User) (symbol-name 3t) (symbol-name int))

          (set doQuit (False))

          (init-mutex-recursive (aof treeArc))

          ;; shared data between threads
          (let (((<> Arc 3t) wtree . #'((<> new Arc 3t) ((<> Leaf 3t) ((<> Nil 3t pair_t))) (aof treeArc)))
                ((<> Arc 3t) * pwtree . #'(aof wtree))
                ;; 4 readers search for exact value too many times
                (auto reader1 . #'(go (((<> Arc 3t) * pwtree)) (searchMany pwtree 200 200)))
                (auto reader2 . #'(go (((<> Arc 3t) * pwtree)) (searchMany pwtree 500 500)))
                (auto reader3 . #'(go (((<> Arc 3t) * pwtree)) (searchMany pwtree 700 700)))
                (auto reader4 . #'(go (((<> Arc 3t) * pwtree)) (searchMany pwtree 1000 1000)))
                ) ; decls

            ;; main thread, insertion and deletion
            (insertMany pwtree 1   250)              
            (insertMany pwtree 501 750)
            (insertMany pwtree 251 500)
            (insertMany pwtree 751 1000)
            
            (deleteMany pwtree 1   250)
            (deleteMany pwtree 501 750)
            (deleteMany pwtree 251 500)
            (deleteMany pwtree 751 1000)

            (usleep 100)
            (set doQuit (True))

            ;; (__h_stack_show)
            
            (join reader1)
            (join reader2)
            (join reader3)
            (join reader4)

            ((<> free Arc 3t) pwtree)
            (format #t "Done\n")
            
            )) ; main
    
    ) ; tree-type
  
  (tree-type (<> BTree int User)) ; use 3t to avoid using BTree_int_User type name too many times
  
  ) ; btree.c
