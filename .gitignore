# ---- test build artifacts -------------------------------------------------
# test/ is now just c, std and haskell. The generated .c and .h are TRACKED on
# purpose -- they are the ground truth for what the backend actually emits.
# Everything below is rebuildable.
test/**/*.o
test/**/*.lo
test/**/*.la
test/**/.libs/
test/**/*_test
test/**/*_main
# --separate keeps one file per resolver run
test/**/*.run*.c
test/**/*.run*.lo
test/**/*.run*.o

test/haskell/main
/test/haskell/main.dSYM
test/haskell/word_count
# written by test/std/defer_main at run time
test/std/deferral.txt

# emacs autosave
\#*\#
.\#*

# example/ build products and downloaded datasets
example/*.c
example/*.cpp
example/*.o
example/*.lo
example/.libs/
example/data/
example/python/__pycache__/
example/mnist
example/mnist_dsl
example/mnist_conv
example/tabular
example/torch_example
example/numpy_example
example/numpy_torch
example/numpy_ops
example/*.la
example/torch_data
example/*.hpp

# ...but the classifier fragment is a committed artefact, not a build product.
# test/cpp/torch-fragment.cicili includes it, so a fresh clone has to have it
# for `sh test/run.sh' to pass. Regenerate with
#   sbcl --script cicili.lisp ./example/mnist-fragment.cicili
# and the diff is what tells you the emission changed.
!example/classifier.hpp
!example/classifier.cpp

# MNIST idx files and the checkpoint mnist-train writes. Downloaded and built,
# not authored -- see example/mnist-train.cpp for both.
example/data/
example/classifier.pt
example/mnist_train

